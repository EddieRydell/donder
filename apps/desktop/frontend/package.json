{
  "name": "@donder/editor",
  "version": "0.1.0",
  "private": true,
  "exports": {
    ".": "./src/editor/index.ts",
    "./styles.css": "./src/editor/editor.css"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test src/**/*.test.js",
    "knip": "knip"
  },
  "knip": {
    "ignoreExportsUsedInFile": true,
    "ignoreIssues": {
      "src/types.ts": ["types"]
    },
    "rules": {
      "catalogReferences": "off"
    }
  },
  "dependencies": {
    "@codemirror/commands": "catalog:",
    "@codemirror/lang-cpp": "catalog:",
    "@codemirror/lang-yaml": "catalog:",
    "@codemirror/language": "catalog:",
    "@codemirror/lint": "catalog:",
    "@codemirror/state": "catalog:",
    "@codemirror/view": "catalog:",
    "@lezer/highlight": "catalog:",
    "@radix-ui/react-alert-dialog": "catalog:",
    "@radix-ui/react-context-menu": "catalog:",
    "@radix-ui/react-dialog": "catalog:",
    "@radix-ui/react-dropdown-menu": "catalog:",
    "@radix-ui/react-tooltip": "catalog:",
    "@tauri-apps/api": "catalog:",
    "@xyflow/react": "catalog:",
    "cmdk": "catalog:",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-arborist": "catalog:",
    "react-colorful": "catalog:",
    "react-dom": "catalog:",
    "wavesurfer.js": "catalog:",
    "use-resize-observer": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "knip": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:"
  }
}
