{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Donder",
  "version": "0.2.1",
  "identifier": "studio.donder.desktop",
  "build": {
    "beforeDevCommand": "pnpm --dir frontend dev",
    "beforeBuildCommand": "pnpm --dir frontend build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Donder",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**/*"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Eddie Rydell",
    "homepage": "https://donder.eddierydell.com",
    "copyright": "Copyright (c) 2026 Eddie Rydell",
    "license": "MIT",
    "category": "Utility",
    "shortDescription": "Light-show sequencer where every effect is a program",
    "longDescription": "Donder is a light-show sequencer that compiles effects to bytecode and evaluates every frame live, on a computer or standalone on an ESP32 controller.",
    "icon": [
      "assets/icons/icon.png",
      "assets/icons/icon.icns",
      "assets/icons/icon.ico"
    ]
  }
}
