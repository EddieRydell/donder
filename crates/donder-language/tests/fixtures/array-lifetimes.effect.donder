effect ArrayLifetimes {
    param int iterations = 4;
    param bool fail = false;

    color sample() {
        array<float> saved = [progress()];
        array<float> current = [0.0];
        array<array<float>> nested = [saved, [0.5, 0.75]];
        for (int i = 0; i < iterations; i = i + 1) {
            current = [progress() + i * 0.1];
            if (i == 0) { saved = current; }
            if (i == 1) { nested = [saved, current, [0.5, 0.75]]; }
        }
        array<array<float>> retained = nested;
        nested = [[0.0]];
        current = [0.9, 0.8];
        if (fail) { int invalid = 1 % 0; }
        return rgb(saved[0], retained[1][0], current[0]);
    }
}
