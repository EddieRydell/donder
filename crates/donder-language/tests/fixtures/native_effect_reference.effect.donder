effect Pulse {
  param gradient gradient;
  param curve pulse_shape;
  color sample() { return gradient_color_scaled(gradient, progress(), pulse_shape[progress()]); }
}

effect Chase {
  param gradient gradient; param enum gradient_mode { through_effect, across_items, per_pulse } = per_pulse;
  param float pulse_overlap = 8.0; param int section_width_pixels = 1; param curve chase_position;
  param bool reverse = false; param bool extend_to_start = false; param bool extend_to_end = false; param curve pulse_shape;
  color sample() {
    float width=max(1.0,section_width_pixels); float item_count=max(1.0,floor((pixel_count()+width-1.0)/width));
    float item_index=floor(pixel_index()/width); float position=item_index/max(1.0,item_count-1.0); float chase_position_value=position;
    if(reverse){chase_position_value=1.0-chase_position_value;} float pulse_duration=max(0.000000001,max(1.0,pulse_overlap)/item_count);
    float travel_start=0.0; float travel_end=max(0.0,1.0-pulse_duration); if(extend_to_start){travel_start=0.0-pulse_duration;} if(extend_to_end){travel_end=1.0;}
    float hit=mix(travel_start,travel_end,clamp(curve_crossing(chase_position,chase_position_value,chase_position_value),0.0,1.0));
    float pulse_progress=(progress()-hit)/pulse_duration; float level=0.0; if(pulse_progress>=0.0&&pulse_progress<=1.0){level=curve_clamped(pulse_shape,pulse_progress,0.0,1.0);}
    float gradient_position=pulse_progress; if(gradient_mode==through_effect){gradient_position=progress();} if(gradient_mode==across_items){gradient_position=position;} if(gradient_mode==per_pulse){gradient_position=pulse_progress;}
    return gradient_color_scaled(gradient,clamp(gradient_position,0.0,1.0),level);
  }
}

effect Spin {
  param gradient gradient; param enum gradient_mode { through_effect, across_items, per_pulse } = per_pulse;
  param float pulse_overlap=8.0; param int section_width_pixels=1; param curve chase_position; param int revolutions=2;
  param bool reverse=false; param bool extend_to_start=false; param bool extend_to_end=false; param curve pulse_shape;
  color sample(){
    float width=max(1.0,section_width_pixels); float item_count=max(1.0,floor((pixel_count()+width-1.0)/width)); float item_index=floor(pixel_index()/width); float position=item_index/max(1.0,item_count-1.0);
    int revolution_count=revolutions; if(revolution_count<1){revolution_count=1;} float virtual_item_count=item_count*revolution_count; float pulse_duration=max(0.000000001,max(1.0,pulse_overlap)/virtual_item_count);
    float travel_start=0.0; float travel_end=max(0.0,1.0-pulse_duration); if(extend_to_start){travel_start=0.0-pulse_duration;} if(extend_to_end){travel_end=1.0;}
    float level=0.0; float gradient_position=0.0; for(int revolution=0;revolution<revolution_count;revolution=revolution+1){float virtual_position=(revolution+position)/revolution_count;if(reverse){virtual_position=1.0-virtual_position;}
      float hit=mix(travel_start,travel_end,clamp(curve_crossing(chase_position,virtual_position,virtual_position),0.0,1.0));float pulse_progress=(progress()-hit)/pulse_duration;
      if(pulse_progress>=0.0&&pulse_progress<=1.0){float candidate_level=curve_clamped(pulse_shape,pulse_progress,0.0,1.0);if(candidate_level>level){level=candidate_level;gradient_position=pulse_progress;if(gradient_mode==through_effect){gradient_position=progress();}if(gradient_mode==across_items){gradient_position=position;}}}}
    return gradient_color_scaled(gradient,clamp(gradient_position,0.0,1.0),level);
  }
}

effect MarkPulse {
  fixed param marks beats; param color base=#000000; param gradient accent; param curve hue; param float hue_mix=0.35; fixed param float offset_seconds=0.0; fixed param float decay_seconds=0.18;
  fixed param int section_width_pixels=5; param float section_edge_fade_pixels=0.0; fixed param int sections_per_mark=3; fixed param float seed=0.0;
  void generate(){TargetItems items=sections(target,section_width_pixels);int section_count=count(items);if(section_count>0){for(int mark=0;mark<mark_count(beats);mark=mark+1){float hit_time=mark_at(beats,mark,-999.0);for(int i=0;i<sections_per_mark;i=i+1){float choice=floor(rand(seed+hit_time*1000.0,i)*section_count);timeline.emit MarkPulseChild {start:hit_time+offset_seconds,duration:max(0.000000001,decay_seconds),target:pick(items,choice),base:base,accent:accent,hue:hue,hue_mix:hue_mix,section_width_pixels:section_width_pixels,section_edge_fade_pixels:section_edge_fade_pixels,parent_duration:duration,child_start:hit_time+offset_seconds};}}}}
}
effect MarkPulseChild {
  param color base=#000000; param gradient accent; param curve hue; param float hue_mix=0.35; param int section_width_pixels=5; param float section_edge_fade_pixels=0.0; param float parent_duration=1.0; param float child_start=0.0;
  color sample(){float width=max(1.0,section_width_pixels);float pixel=pixel_index();float choice=floor(pixel/width);float edge_fade=max(0.0,section_edge_fade_pixels);float active=1.0;if(edge_fade>0.0){float section_start=choice*width;float section_end=min(section_start+width-1.0,pixel_count()-1.0);float edge_distance=min(pixel-section_start,section_end-pixel);active=clamp(edge_distance/edge_fade,0.0,1.0);}float pulse_progress=clamp(progress(),0.0,1.0);float pulse=1.0-pulse_progress;float parent_progress=clamp((child_start+seconds())/max(0.000000001,parent_duration),0.0,1.0);color pulse_color=mix(accent[pulse_progress],hsv(hue[parent_progress]/360.0,1.0,1.0),clamp(hue_mix,0.0,1.0));return mix(base,pulse_color,active*pulse);}
}

effect MarkChase {
  fixed param marks beats; param color base=#000000; param enum gradient_mode { through_effect, across_items, per_pulse }=per_pulse; fixed param array<gradient> gradients; param curve hue; param float hue_mix=0.35; fixed param float offset_seconds=0.0; fixed param float chase_seconds=0.5; param float pulse_overlap=8.0; param int section_width_pixels=5; fixed param array<curve> chase_positions; param curve pulse_shape;
  void generate(){int gradient_count=len(gradients);int chase_position_count=len(chase_positions);if(gradient_count>0&&chase_position_count>0){for(int mark=0;mark<mark_count(beats);mark=mark+1){float hit_time=mark_at(beats,mark,-999.0);timeline.emit MarkChaseChild {start:hit_time+offset_seconds,duration:max(0.000000001,chase_seconds),target:target,base:base,gradient_mode:gradient_mode,gradient:gradients[mark%gradient_count],hue:hue,hue_mix:hue_mix,pulse_overlap:pulse_overlap,section_width_pixels:section_width_pixels,chase_position:chase_positions[mark%chase_position_count],pulse_shape:pulse_shape,parent_duration:duration,child_start:hit_time+offset_seconds};}}}
}
effect MarkChaseChild {
  param color base=#000000; param enum gradient_mode { through_effect, across_items, per_pulse }=per_pulse; param gradient gradient; param curve hue; param float hue_mix=0.35; param float pulse_overlap=8.0; param int section_width_pixels=5; param curve chase_position; param curve pulse_shape; param float parent_duration=1.0; param float child_start=0.0;
  color sample(){float width=max(1.0,section_width_pixels);float section_position_value=section_position(section_width_pixels);float travel_start=0.0-pulse_overlap/max(1.0,pixel_count());float travel_end=1.0+pulse_overlap/max(1.0,pixel_count());float chase=mix(travel_start,travel_end,clamp(chase_position[progress()],0.0,1.0));float distance=abs(pixel_fraction()-chase);float pulse_duration=max(0.000000001,pulse_overlap/max(1.0,pixel_count()));float pulse_progress=distance/pulse_duration;float level=pulse_shape[clamp(pulse_progress,0.0,1.0)];float gradient_position=progress();if(gradient_mode==across_items){gradient_position=pixel_fraction();}if(gradient_mode==per_pulse){gradient_position=section_position_value;}float parent_progress=clamp((child_start+seconds())/max(0.000000001,parent_duration),0.0,1.0);color value=gradient_color_scaled(gradient,clamp(gradient_position,0.0,1.0),level);color hue_color=hsv(hue[parent_progress]/360.0,1.0,1.0);return mix(base,mix(value,hue_color,clamp(hue_mix,0.0,1.0)),level);}
}
