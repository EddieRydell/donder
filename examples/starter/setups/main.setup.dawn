imports:
- from:
    documents:
    - layouts/outputs.layout.dawn
  as: layouts
- from:
    documents:
    - patches/outputs.patch.dawn
  as: patches
main:
  type: setup
  layout: layouts.outputs_layout
  patch: patches.outputs
  controllers:
  - output_controller
output_controller:
  type: controller
  protocol:
    type: e131
    source_name: Dawn Thirty Output Controller
    bind_address: 0.0.0.0
    priority: 100
    mode: unicast
    destination: 192.168.7.2
  ports:
  - id: 1
    universe: 1
    slot_count: 339
