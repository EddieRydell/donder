// Editable project-local composition operators.
operator Max {
  input Signal a;
  input Signal b;

  color sample() {
    return max(a.at(seconds()), b.at(seconds()));
  }
}

operator Add {
  input Signal a;
  input Signal b;

  color sample() {
    return a.at(seconds()) + b.at(seconds());
  }
}

operator Multiply {
  input Signal a;
  input Signal b;

  color sample() {
    return a.at(seconds()) * b.at(seconds());
  }
}

operator IntensityModulate {
  input Signal source;
  input Signal mask;

  color sample() {
    return source.at(seconds()) * intensity(mask.at(seconds()));
  }
}

operator Dim {
  input Signal input;
  param float amount in 0.0..1.0 = 0.5;

  color sample() {
    return input.at(seconds()) * amount;
  }
}

operator Invert {
  input Signal input;

  color sample() {
    return invert(input.at(seconds()));
  }
}

operator Colorize {
  input Signal input;
  param color tint = #ffffff;

  color sample() {
    return tint * intensity(input.at(seconds()));
  }
}

operator HueShift {
  input Signal source;
  // Turns.
  param float shift in 0.0..1.0 = 0.0;

  color sample() {
    color value = source.at(seconds());
    return hsv(hue(value) + shift, saturation(value), intensity(value));
  }
}

operator Delay {
  input Signal input;
  param float seconds in 0.0..60.0 = 0.1;

  color sample() {
    return input.at(seconds() - seconds);
  }
}

operator Echo {
  input Signal input;
  param float seconds in 0.0..60.0 = 0.1;
  param int repeats in 1..32 = 3;
  param float decay in 0.0..1.0 = 0.5;

  // Samples before the sequence are black, so early echoes add nothing.
  color sample() {
    color result = rgb(0.0, 0.0, 0.0);
    float amount = 1.0;
    for (int repeat in range(repeats + 1)) {
      result = max(result, input.at(seconds() - seconds * repeat) * amount);
      amount = amount * decay;
    }
    return result;
  }
}
