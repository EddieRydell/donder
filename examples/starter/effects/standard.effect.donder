effect Pulse {
  param gradient: gradient;
  param pulse_shape: curve in 0.0..1.0;

  sample {
    gradient_color_scaled(gradient, progress, pulse_shape[progress])
  }
}

effect Chase {
  param gradient: gradient;
  param gradient_mode: enum { through_effect, across_items, per_pulse } = per_pulse;
  param pulse_overlap: float in 1.0..100.0 = 8.0;
  param section_width_pixels: int in 1..1000 = 1;
  param chase_position: curve in 0.0..1.0;
  param reverse: bool = false;
  param extend_to_start: bool = false;
  param extend_to_end: bool = false;
  param pulse_shape: curve in 0.0..1.0;

  sample {
    let item_count = ceil(target.count / section_width_pixels);
    let item_index = floor(pixel.index / section_width_pixels);
    let position = item_index / max(1.0, item_count - 1.0);
    let chase_value = if reverse { 1.0 - position } else { position };
    let pulse_duration = pulse_overlap / item_count;
    let travel_start = if extend_to_start { -pulse_duration } else { 0.0 };
    let travel_end = if extend_to_end { 1.0 } else { max(0.0, 1.0 - pulse_duration) };
    let hit = mix(travel_start, travel_end, value_or(curve_first_crossing(chase_position, chase_value), chase_value));
    let pulse_progress = (progress - hit) / pulse_duration;
    let level = if pulse_progress >= 0.0 && pulse_progress <= 1.0 { pulse_shape[pulse_progress] } else { 0.0 };
    let gradient_position =
      if gradient_mode == through_effect { progress }
      else if gradient_mode == across_items { position }
      else { pulse_progress };
    gradient_color_scaled(gradient, gradient_position, level)
  }
}

effect Wipe {
  param gradient: gradient;
  param gradient_mode: enum { through_effect, across_items, per_pulse } = per_pulse;
  param pulse_width: float in 0.01..1.0 = 0.15;
  param direction_angle: float in 0.0..360.0 = 0.0;
  param wipe_position: curve in 0.0..1.0;
  param reverse: bool = false;
  param extend_to_start: bool = false;
  param extend_to_end: bool = false;
  param pulse_shape: curve in 0.0..1.0;

  sample {
    let radians = direction_angle * 0.017453292519943295;
    let dx = if abs(cos(radians)) < 0.000001 { 0.0 } else { cos(radians) };
    let dy = if abs(sin(radians)) < 0.000001 { 0.0 } else { sin(radians) };
    let projection = pixel.x * dx + pixel.y * dy;
    let projection_min = min(target.min_x * dx, target.max_x * dx) + min(target.min_y * dy, target.max_y * dy);
    let span = (target.max_x - target.min_x) * abs(dx) + (target.max_y - target.min_y) * abs(dy);
    -- Rounding can step just outside the projected span.
    let position = if span > 0.000000001 { clamp((projection - projection_min) / span, 0.0, 1.0) } else { 0.0 };
    let chase_value = if reverse { 1.0 - position } else { position };
    let travel_start = if extend_to_start { -pulse_width } else { 0.0 };
    let travel_end = if extend_to_end { 1.0 } else { max(0.0, 1.0 - pulse_width) };
    let hit = mix(travel_start, travel_end, value_or(curve_first_crossing(wipe_position, chase_value), chase_value));
    let pulse_progress = (progress - hit) / pulse_width;
    let level = if pulse_progress >= 0.0 && pulse_progress <= 1.0 { pulse_shape[pulse_progress] } else { 0.0 };
    let gradient_position =
      if gradient_mode == through_effect { progress }
      else if gradient_mode == across_items { position }
      else { pulse_progress };
    gradient_color_scaled(gradient, gradient_position, level)
  }
}

effect Spin {
  param gradient: gradient;
  param gradient_mode: enum { through_effect, across_items, per_pulse } = per_pulse;
  param pulse_overlap: float in 1.0..100.0 = 8.0;
  param section_width_pixels: int in 1..1000 = 1;
  param chase_position: curve in 0.0..1.0;
  param revolutions: int in 1..100 = 2;
  param reverse: bool = false;
  param extend_to_start: bool = false;
  param extend_to_end: bool = false;
  param pulse_shape: curve in 0.0..1.0;

  sample {
    let item_count = ceil(target.count / section_width_pixels);
    let item_index = floor(pixel.index / section_width_pixels);
    let position = item_index / max(1.0, item_count - 1.0);
    let position = if reverse { 1.0 - position } else { position };
    let pulse_width = pulse_overlap / item_count;
    let travel_start = if extend_to_start { pulse_width } else { 0.0 };
    let travel_end = if extend_to_end { revolutions } else { revolutions + pulse_width };
    let virtual_position = mix(travel_start, travel_end, chase_position[progress]);
    let virtual_pixel = virtual_position - position;
    let phase =
      if virtual_pixel >= revolutions { virtual_pixel - (revolutions - 1.0) }
      else if virtual_pixel < 0.0 { virtual_pixel }
      else { virtual_pixel % 1.0 };
    let pulse_progress = phase / pulse_width;
    let level = if pulse_progress >= 0.0 && pulse_progress <= 1.0 { pulse_shape[pulse_progress] } else { 0.0 };
    let gradient_position =
      if gradient_mode == through_effect { progress }
      else if gradient_mode == across_items { item_index / max(1.0, item_count - 1.0) }
      else { pulse_progress };
    gradient_color_scaled(gradient, gradient_position, level)
  }
}

effect MarkPulse {
  param beats: marks;
  param accent: gradient;
  param pulse_shape: curve in 0.0..1.0;
  param offset_seconds: float in -1.0..1.0 = 0.0;
  param decay_seconds: float in 0.01..10.0 = 0.18;
  param section_width_pixels: int in 1..1000 = 5;
  param sections_per_mark: int in 1..100 = 3;
  param seed: float in 0.0..1000.0 = 0.0;

  -- Prepared section queries preserve fixture boundaries and short final sections.
  -- A new mark retriggers the entire selection, discarding every older pulse.
  sample {
    let hit_time = mark_last(beats, time - offset_seconds);
    let child_start = hit_time + offset_seconds;
    let age = time - child_start;
    -- Before the first mark the hit time is NaN, which renders black.
    guard !(child_start < 0.0 || age < 0.0 || age >= decay_seconds);
    let total_sections = section_count(section_width_pixels);
    let current_section = section_index(section_width_pixels);
    guard any for section in 0..sections_per_mark {
      floor(rand((seed + hit_time * 1000.0) * 31.0 + section) * total_sections) == current_section
    };
    let child_progress = age / decay_seconds;
    gradient_color_scaled(accent, child_progress, pulse_shape[child_progress])
  }
}

effect MarkChase {
  param beats: marks;
  param gradient_mode: enum { through_effect, across_items, per_pulse } = per_pulse;
  param gradients: array<gradient>;
  param offset_seconds: float in -1.0..1.0 = 0.0;
  param chase_seconds: float in 0.01..10.0 = 0.5;
  param pulse_overlap: float in 1.0..100.0 = 8.0;
  param section_width_pixels: int in 1..1000 = 5;
  param chase_position: curve in 0.0..1.0;
  param pulse_shape: curve in 0.0..1.0;

  -- One arrival per mark and pixel: a new mark replaces this pulse only on arrival.
  -- All marks share the trajectory; its first crossing defines the travel delay.
  sample {
    let item_count = ceil(target.count / section_width_pixels);
    let item_index = floor(pixel.index / section_width_pixels);
    let position = item_index / max(1.0, item_count - 1.0);
    let pulse_duration = pulse_overlap / item_count;
    let travel_end = max(0.0, 1.0 - pulse_duration);
    let hit = travel_end * curve_first_crossing(chase_position, position);
    let mark = mark_last_index(beats, time - offset_seconds - chase_seconds * hit);
    let hit_time = mark_at(beats, mark);
    let age = time - hit_time - offset_seconds;
    -- Before the first mark the hit time is NaN, which renders black.
    guard !(hit_time + offset_seconds < 0.0 || age < 0.0 || age >= chase_seconds);
    let child_progress = age / chase_seconds;
    let selected_gradient = gradients[mark % len(gradients)];
    let pulse_progress = (child_progress - hit) / pulse_duration;
    let level = if pulse_progress >= 0.0 && pulse_progress <= 1.0 { pulse_shape[pulse_progress] } else { 0.0 };
    let gradient_position =
      if gradient_mode == through_effect { child_progress }
      else if gradient_mode == across_items { position }
      else { pulse_progress };
    gradient_color_scaled(selected_gradient, gradient_position, level)
  }
}

effect MarkWipe {
  param beats: marks;
  param gradient_mode: enum { through_effect, across_items, per_pulse } = per_pulse;
  param gradients: array<gradient>;
  param offset_seconds: float in -1.0..1.0 = 0.0;
  param wipe_seconds: float in 0.01..10.0 = 0.5;
  param pulse_width: float in 0.01..1.0 = 0.15;
  -- Curve values are turns: 0 = 0 degrees, 0.25 = 90 degrees, 1 = 360 degrees.
  param direction_angle: curve in 0.0..1.0;
  param wipe_positions: array<curve>;
  param pulse_shape: curve in 0.0..1.0;

  -- Direction is sampled at the mark's time.
  sample {
    let mark = mark_last_index(beats, time - offset_seconds);
    let hit_time = mark_at(beats, mark);
    let age = time - hit_time - offset_seconds;
    -- Before the first mark the hit time is NaN, which renders black.
    guard !(hit_time + offset_seconds < 0.0 || age < 0.0 || age >= wipe_seconds);
    let child_progress = age / wipe_seconds;
    let selected_gradient = gradients[mark % len(gradients)];
    let wipe_position = wipe_positions[mark % len(wipe_positions)];
    let angle = 360.0 * direction_angle[hit_time / duration];
    let radians = angle * 0.017453292519943295;
    let dx = if abs(cos(radians)) < 0.000001 { 0.0 } else { cos(radians) };
    let dy = if abs(sin(radians)) < 0.000001 { 0.0 } else { sin(radians) };
    let projection = pixel.x * dx + pixel.y * dy;
    let projection_min = min(target.min_x * dx, target.max_x * dx) + min(target.min_y * dy, target.max_y * dy);
    let span = (target.max_x - target.min_x) * abs(dx) + (target.max_y - target.min_y) * abs(dy);
    -- Rounding can step just outside the projected span.
    let position = if span > 0.000000001 { clamp((projection - projection_min) / span, 0.0, 1.0) } else { 0.0 };
    let travel_end = max(0.0, 1.0 - pulse_width);
    let query_position = if travel_end > 0.0 { child_progress / travel_end } else { 1.0 };
    let hit = travel_end * curve_last_crossing(wipe_position, position, query_position);
    let pulse_progress = (child_progress - hit) / pulse_width;
    let level = if pulse_progress >= 0.0 && pulse_progress <= 1.0 { pulse_shape[pulse_progress] } else { 0.0 };
    let gradient_position =
      if gradient_mode == through_effect { child_progress }
      else if gradient_mode == across_items { position }
      else { pulse_progress };
    gradient_color_scaled(selected_gradient, gradient_position, level)
  }
}
