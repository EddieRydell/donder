effect SparkleComet {
  param gradient gradient;
  param curve position in 0.0..1.0;
  param curve intensity in 0.0..1.0;
  param enum color_mode { gradient_tail, bright_head, rainbow_hue } = gradient_tail;
  param color head_color = #ffffff;
  param bool reverse = false;
  param bool wrap = false;
  param float tail_width in 0.001..1.0 = 0.18;
  param float head_width in 0.001..1.0 = 0.035;
  param float sparkle_density in 0.0..1.0 = 0.35;
  param float sparkle_speed in 0.01..100.0 = 14.0;
  param float sparkle_gain in 0.0..1.0 = 0.75;
  param float seed in 0.0..1000.0 = 0.0;

  color sample() {
    float pixel_fraction_value = pixel_fraction();
    if (reverse) {
      pixel_fraction_value = 1.0 - pixel_fraction_value;
    }

    float distance = abs(pixel_fraction_value - position[progress()]);
    if (wrap) {
      distance = min(distance, 1.0 - distance);
    }

    float trail = 1.0 - smoothstep(0.0, tail_width, distance);
    float core = 1.0 - smoothstep(0.0, head_width, distance);

    float bucket = floor(seconds() * sparkle_speed + pixel_index() * 0.13);
    float sparkle = 0.0;
    if (rand(seed + pixel_index() * 19.0 + bucket * 47.0) < sparkle_density) {
      sparkle = (sin(seconds() * sparkle_speed * TAU + pixel_index()) + 1.0) * 0.5;
    }

    float level = max(max(trail, core), sparkle * trail * sparkle_gain) * intensity[progress()];

    color value = gradient[1.0 - distance / tail_width];
    if (color_mode == bright_head) {
      value = mix(value, head_color, core);
    }
    if (color_mode == rainbow_hue) {
      value = hsv(pixel_fraction_value * 6.0 + progress() * 6.0, 1.0, 1.0);
    }

    return mix(#000000, value, level);
  }
}
