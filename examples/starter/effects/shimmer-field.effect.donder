effect ShimmerField {
  param color base = #000000;
  param gradient palette;
  param enum color_mode { from_palette, rainbow_hue, fixed_sparkle } = from_palette;
  param color sparkle_color = #ffffff;
  param float density in 0.0..1.0 = 0.28;
  param float shimmer_level in 0.0..1.0 = 0.35;
  param float sparkle_level in 0.0..1.0 = 1.0;
  param float wave_speed in 0.0..100.0 = 4.0;
  param float wave_scale in 0.0..100.0 = 18.0;
  param float sparkle_speed in 0.01..100.0 = 8.0;
  param float sparkle_hold in 0.0..10.0 = 0.35;
  param float section_width_pixels in 1.0..1000.0 = 1.0;
  param float seed in 0.0..1000.0 = 0.0;

  color sample() {
    float section = floor(pixel_index() / section_width_pixels);
    float position = section_position(section_width_pixels);

    float wave = (sin(seconds() * wave_speed + position * wave_scale) + 1.0) * 0.5;
    float level = wave * shimmer_level;

    float bucket = floor(seconds() * sparkle_speed + section * sparkle_hold);
    float choice = rand(seed + section * 31.0 + bucket * 101.0);
    float sparkle = 0.0;
    if (choice < density) {
      sparkle = (sin(seconds() * sparkle_speed * TAU + section) + 1.0) * 0.5;
    }
    level = max(level, sparkle * sparkle_level);

    color accent = palette[position + progress()];
    if (color_mode == rainbow_hue) {
      accent = hsv(position * 6.0 + progress() * 6.0, 1.0, 1.0);
    }
    if (color_mode == fixed_sparkle) {
      accent = sparkle_color;
    }

    return mix(base, accent, level);
  }
}
