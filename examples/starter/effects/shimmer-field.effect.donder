effect ShimmerField {
  param base: color = #000000;
  param palette: gradient;
  param color_mode: enum { from_palette, rainbow_hue, fixed_sparkle } = from_palette;
  param sparkle_color: color = #ffffff;
  param density: float in 0.0..1.0 = 0.28;
  param shimmer_level: float in 0.0..1.0 = 0.35;
  param sparkle_level: float in 0.0..1.0 = 1.0;
  param wave_speed: float in 0.0..100.0 = 4.0;
  param wave_scale: float in 0.0..100.0 = 18.0;
  param sparkle_speed: float in 0.01..100.0 = 8.0;
  param sparkle_hold: float in 0.0..10.0 = 0.35;
  param section_width_pixels: float in 1.0..1000.0 = 1.0;
  param seed: float in 0.0..1000.0 = 0.0;

  sample {
    let section = floor(pixel.index / section_width_pixels);
    let position = section_position(section_width_pixels);
    let wave = (sin(time * wave_speed + position * wave_scale) + 1.0) * 0.5;
    let bucket = floor(time * sparkle_speed + section * sparkle_hold);
    let choice = rand(seed + section * 31.0 + bucket * 101.0);
    let sparkle = if choice < density { (sin(time * sparkle_speed * TAU + section) + 1.0) * 0.5 } else { 0.0 };
    let level = max(wave * shimmer_level, sparkle * sparkle_level);
    let accent =
      if color_mode == rainbow_hue { hsv(position * 6.0 + progress * 6.0, 1.0, 1.0) }
      else if color_mode == fixed_sparkle { sparkle_color }
      else { palette[position + progress] };
    mix(base, accent, level)
  }
}
