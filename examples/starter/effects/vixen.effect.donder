-- Procedural Vixen 3.13u2 ports. See docs/vixen_effects.md in the Donder source.
-- This is a supported-mode library, not a complete Vixen sequence importer.
-- Source: https://github.com/VixenLights/Vixen/tree/3.13u2/src/Vixen.Modules/Effect
--
-- Curves use positions 0..1 and Vixen percentage VALUES 0..100; a missing curve
-- reads as a flat 100. Required gradients must be supplied by the caller. Array
-- indexes clamp, so a levels array shorter than its colors reuses its last curve.
-- Scalar percentage controls can use Donder automation; defaults below are the
-- values of Vixen's default flat control curves.
-- Pixel ports use layout coordinates with one virtual pixel per pixel_size
-- layout units. Their explicit frame_interval_ms must match the source show.
-- They never sample neighboring colors or derive bounds from a controller slice.
-- Gradient interpolation, floating precision, alpha and group/depth semantics
-- differ from Vixen; these ports do not claim byte-for-byte renderer parity.
--
-- Adapted from Vixen. Copyright 2023 Vixen Team.
-- Redistribution and use in source and binary forms, with or without
-- modification, are permitted provided that the following conditions are met:
-- * Redistributions of source code must retain the above copyright notice,
--   this list of conditions and the following disclaimer.
-- * Redistributions in binary form must reproduce the above copyright notice,
--   this list of conditions and the following disclaimer in the documentation
--   and/or other materials provided with the distribution.
-- THIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS "AS IS"
-- AND ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE
-- IMPLIED WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE
-- ARE DISCLAIMED. IN NO EVENT SHALL THE COPYRIGHT OWNER OR CONTRIBUTORS BE
-- LIABLE FOR ANY DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR
-- CONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF
-- SUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA, OR PROFITS; OR BUSINESS
-- INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY, WHETHER IN
-- CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE)
-- ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF THE
-- POSSIBILITY OF SUCH DAMAGE.

-- BASIC: RGB Set Level. Discrete-color filtering is not represented.
effect VixenSetLevel {
  param light_color: color = #ffffff;
  param intensity: float in 0.0..100.0 = 100.0;

  sample {
    light_color * (intensity / 100.0)
  }
}

-- BASIC: RGB Pulse. Supply Vixen's gradient and percentage intensity curve.
effect VixenPulse {
  param color_gradient: gradient;
  param intensity_curve: curve in 0.0..100.0;

  sample {
    color_gradient[progress] * (value_or(intensity_curve[progress], 100.0) / 100.0)
  }
}

-- BASIC: Alternating, time-interval/static modes over ordered individual pixels.
-- Vixen defaults: red/green gradients, flat-100 level curves.
effect VixenAlternating {
  param colors: array<gradient>;
  param levels: array<curve>;
  param interval_ms: float in 2.0..60000.0 = 500.0;
  param enable_static: bool = false;
  param group_level: int in 1..1000 = 1;
  param interval_skip_count: int in 0..1000 = 1;

  sample {
    let interval = if enable_static { duration * 1000.0 } else { interval_ms };
    let elapsed = time * 1000.0;
    let cycle = floor(elapsed / interval);
    let age = elapsed - cycle * interval;
    -- Vixen subtracts one millisecond from each pulse's duration.
    guard !(age >= interval - 1.0);
    let local = age / (interval - 1.0);
    let i = int((floor(pixel.index / group_level) + cycle * interval_skip_count) % len(colors));
    colors[i][local] * (value_or(levels[i][local], 100.0) / 100.0)
  }
}

-- BASIC: Strobe, Simple time-interval mode (50% duty, no mark labels).
-- Default resources: white gradient, triangular 0/100/0 intensity curve.
effect VixenStrobe {
  param colors: gradient;
  param intensity_curve: curve in 0.0..100.0;
  param cycle_time_ms: float in 3.0..60000.0 = 150.0;

  sample {
    let age = (time * 1000.0) % cycle_time_ms;
    let on_time = cycle_time_ms * 0.5 - 1.0;
    guard !(age >= on_time);
    let local = age / on_time;
    colors[local] * (value_or(intensity_curve[local], 100.0) / 100.0)
  }
}

-- PIXEL: Pinwheel, location positioning, all colors, both motion modes and all
-- four blade types. Random/Rainbow use Donder's seeded RNG, not Vixen's stream.
-- Default resources: red/green/blue gradients, three flat-100 level curves.
effect VixenPinwheel {
  param colors: array<gradient>;
  param levels: array<curve>;
  param color_type: enum { standard, gradient, random, rainbow } = standard;
  param motion: enum { iterations, speed } = iterations;
  param arms: int in 1..20 = 8;
  param movement: float in 0.0..100.0 = 5.0;
  param thickness: float in 0.0..100.0 = 15.0;
  param size: float in 0.0..100.0 = 23.0;
  param twist: float in 0.0..100.0 = 56.0;
  param rotation: float in 0.0..100.0 = 100.0;
  param x_offset: float in 0.0..100.0 = 50.0;
  param y_offset: float in 0.0..100.0 = 50.0;
  param center_hub: float in 0.0..100.0 = 0.0;
  param offset_percentage: bool = true;
  param size_scale_basis: enum { largest_dimension, height, width } = largest_dimension;
  param blade_type: enum { flat, three_d, inverted_three_d, fan } = flat;
  param intensity: float in 0.0..100.0 = 100.0;
  param random_seed: float in 0.0..1000000.0 = 0.0;
  param pixel_size: float in 0.001..1000.0 = 1.0;
  param frame_interval_ms: float in 1.0..1000.0 = 50.0;

  sample {
    let t = floor(time * 1000.0 / frame_interval_ms) * frame_interval_ms / (duration * 1000.0);
    let w = floor((target.max_x - target.min_x) / pixel_size) + 1.0;
    let h = floor((target.max_y - target.min_y) / pixel_size) + 1.0;
    let x = floor((pixel.x - target.min_x) / pixel_size);
    let y = floor((pixel.y - target.min_y) / pixel_size);
    let ox = x_offset * 2.0 - 100.0;
    let oy = y_offset * 2.0 - 100.0;
    let ox = if offset_percentage { ox * w / 100.0 } else { ox };
    let oy = if offset_percentage { -oy * h / 100.0 } else { oy };
    -- C# Math.Round rounds midpoints to even.
    let cx = floor(w / 2.0) + round_even(ox);
    let cy = floor(h / 2.0) + round_even(oy);
    let dx = x - cx;
    let dy = y - cy;
    let radius = sqrt(dx * dx + dy * dy);
    let basis =
      if !offset_percentage { sqrt((w - cx) * (w - cx) + (h - cy) * (h - cy)) }
      else if size_scale_basis == width { w }
      else if size_scale_basis == height { h }
      else { max(w, h) };
    let max_radius = basis * (1.0 + size * 3.99) / 100.0;
    guard !(radius > max_radius || radius <= center_hub * max_radius / 100.0);
    let angle = (270.0 - atan2(-dy, -dx) * 57.29577951308232) % 360.0;
    let separation = floor(360.0 / arms);
    let half_angle = max(1.0, round_even(thickness)) * separation / 200.0;
    let movement_speed = max(1.0, (1.0 + movement * 0.49) * frame_interval_ms / 50.0);
    let position =
      if motion == speed { t * movement_speed * floor(duration * 1000.0 / frame_interval_ms) }
      else { t * movement_speed * 360.0 };
    let rotation_amount = rotation / 50.0 - 1.0;
    let twist_angle = radius / max_radius * (twist * 10.0 - 500.0);
    -- Vixen draws arms in order; the last covering arm owns the pixel.
    last for arm in 0..arms {
      let arm_angle = (floor(((arm + 2) * separation - position * rotation_amount) % 360.0) + twist_angle) % 360.0;
      let difference = min(abs(arm_angle - angle), 360.0 - abs(arm_angle - angle));
      guard difference <= half_angle;
      let index = arm % len(colors);
      let color_position = if color_type == gradient { radius / max_radius } else { t };
      let level = value_or(levels[index][color_position], 100.0) * intensity / 10000.0;
      let level =
        if blade_type == three_d { level * (1.0 - difference / half_angle) }
        else if blade_type == inverted_three_d { level * difference / half_angle }
        else if blade_type == fan {
          let leading = if rotation_amount < 0.0 { -half_angle } else { half_angle };
          let front = (arm_angle + leading) % 360.0;
          level * min(abs(front - angle), 360.0 - abs(front - angle)) / (2.0 * half_angle)
        }
        else { level };
      if color_type == random { hsv(rand(random_seed * 31.0 + index), 1.0, level) }
      else if color_type == rainbow { hsv(rand((random_seed * 31.0 + arm) * 31.0 + floor(time * 1000.0 / frame_interval_ms)), 1.0, level) }
      else { colors[index][color_position] * level }
    }
  }
}

-- PIXEL: Butterfly, five formulas and iteration motion. Default gradient red/green.
effect VixenButterfly {
  param color_gradient: gradient;
  param butterfly_type: enum { type_1, type_2, type_3, type_4, type_5 } = type_1;
  param color_scheme: enum { gradient, rainbow } = gradient;
  param direction: enum { forward, backward } = forward;
  param iterations: int in 1..100 = 2;
  param repeat: int in 1..100 = 1;
  param background_chunks: int in 1..100 = 1;
  param background_skips: int in 1..100 = 2;
  param use_base_color: bool = false;
  param base_color: color = #000000;
  param intensity: float in 0.0..100.0 = 100.0;
  param pixel_size: float in 0.001..1000.0 = 1.0;
  param frame_interval_ms: float in 1.0..1000.0 = 50.0;

  sample {
    let t = floor(time * 1000.0 / frame_interval_ms) * frame_interval_ms / (duration * 1000.0);
    let w = floor((target.max_x - target.min_x) / pixel_size) + 1.0;
    let h = floor((target.max_y - target.min_y) / pixel_size) + 1.0;
    let x = floor((pixel.x - target.min_x) / pixel_size);
    let y = h - 1.0 - floor((pixel.y - target.min_y) / pixel_size);
    let repetitions: float =
      if butterfly_type == type_4 { repeat * 6.0 }
      else if butterfly_type == type_1 || butterfly_type == type_5 { repeat * 3.0 }
      else { repeat };
    let state = floor(duration * 1000.0 * ((t * iterations) % 1.0) * repetitions);
    -- Effects shorter than a millisecond hold the first frame.
    let frame = floor(h * state / max(1.0, floor(duration * 1000.0))) % h;
    let offset = state / (duration * 1000.0);
    let offset = if direction == forward { -offset } else { offset };
    let value =
      if butterfly_type == type_2 || butterfly_type == type_3 {
        let f = if frame < floor(h / 2.0) { frame + 1.0 } else { h - frame };
        let f = if butterfly_type == type_3 { f * 0.1 + h / 60.0 } else { f };
        let xx = (x - w / 2.0) / f;
        let yy = (y - h / 2.0) / f;
        if butterfly_type == type_3 { sin(xx) * cos(yy) } else { sqrt(xx * xx + yy * yy) }
      } else {
        let y = if x == 0.0 && y == 1.0 { 2.0 } else { y };
        let x = if x == 1.0 && y == 0.0 { 2.0 } else { x };
        let dimension = if butterfly_type == type_5 { w * h } else { w + h };
        let n = (x * x - y * y) * sin(offset + (x + y) * 6.283185307179586 / dimension);
        let d = x * x + y * y;
        let value = if d > 0.001 { n / d } else { 0.0 };
        if butterfly_type == type_4 { value - floor(value) } else { abs(value) }
      };
    -- C# converts to int by truncation toward zero, including Type 3 negatives.
    guard !(background_chunks > 1 && trunc(value * background_chunks) % background_skips == 0.0)
      else if use_base_color { base_color } else { rgb(0.0, 0.0, 0.0) };
    let level = intensity / 100.0;
    if color_scheme == rainbow { hsv(value, 1.0, level) } else { color_gradient[value] * level }
  }
}

-- PIXEL: Colorwash, iteration mode, all fades and frame-alternating shimmer.
-- Default gradient red/green/blue. Speed-curve accumulation is not exposed.
effect VixenColorwash {
  param color_gradient: gradient;
  param wash_type: enum { center, outer, invert } = center;
  param iterations: int in 1..100 = 1;
  param horizontal_fade: bool = false;
  param vertical_fade: bool = false;
  param shimmer: bool = false;
  param intensity: float in 0.0..100.0 = 100.0;
  param pixel_size: float in 0.001..1000.0 = 1.0;
  param frame_interval_ms: float in 1.0..1000.0 = 50.0;

  sample {
    let frame = floor(time * 1000.0 / frame_interval_ms);
    let frames = floor(duration * 1000.0 / frame_interval_ms);
    guard !(shimmer && frame % 2.0 != 0.0);
    -- An effect shorter than one frame has no position and stays dark.
    let position = (frame * iterations % frames) * frame_interval_ms / (duration * 1000.0);
    let w = floor((target.max_x - target.min_x) / pixel_size) + 1.0;
    let h = floor((target.max_y - target.min_y) / pixel_size) + 1.0;
    let half_w = (w - 1.0) / 2.0;
    let half_h = (h - 1.0) / 2.0;
    let x = floor((pixel.x - target.min_x) / pixel_size);
    let y = floor((pixel.y - target.min_y) / pixel_size);
    let c = color_gradient[position];
    let v = intensity(c);
    let v =
      if horizontal_fade && half_w > 0.0 {
        let fade = abs(half_w - x) / half_w;
        if wash_type == center { v * (1.0 - fade) }
        else if wash_type == outer { v * fade }
        else { v / (1.0 - fade) }
      } else { v };
    let v =
      if vertical_fade && half_h > 0.0 {
        let fade = abs(half_h - y) / half_h;
        if wash_type == center { v * (1.0 - fade) }
        else if wash_type == outer { v * fade }
        else { v / (1.0 - fade) }
      } else { v };
    hsv(hue(c), saturation(c), v * intensity / 100.0)
  }
}

-- PIXEL: Plasma, all five color modes and the original seven-term formula.
-- Default resources: red/green/blue gradients.
effect VixenPlasma {
  param colors: array<gradient>;
  param color_type: enum { normal, preset_1, preset_2, preset_3, preset_4 } = normal;
  param plasma_style: int in 1..10 = 1;
  param speed: float in 0.0..100.0 = 10.0;
  param line_density: float in 0.0..100.0 = 10.0;
  param intensity: float in 0.0..100.0 = 100.0;
  param pixel_size: float in 0.001..1000.0 = 1.0;
  param frame_interval_ms: float in 1.0..1000.0 = 50.0;

  sample {
    let t = floor(time * 1000.0 / frame_interval_ms) * frame_interval_ms / (duration * 1000.0);
    let w = floor((target.max_x - target.min_x) / pixel_size) + 1.0;
    let h = floor((target.max_y - target.min_y) / pixel_size) + 1.0;
    let x = floor((pixel.x - target.min_x) / pixel_size) / w;
    let y = (h - 1.0 - floor((pixel.y - target.min_y) / pixel_size)) / h;
    let plasma_time = (t * 100.0 * speed + 1.0) / ((101.0 - speed) * 3.0);
    let cx = x + 0.5 * sin(plasma_time / 5.0);
    let cy = y + 0.5 * cos(plasma_time / 3.0);
    let v = sin(x * 10.0 + plasma_time);
    let v = v + sin(10.0 * (x * sin(plasma_time / 2.0) + y * cos(plasma_time / 3.0)) + plasma_time);
    let v = v + sin(sqrt(plasma_style * 50.0 * (cx * cx + cy * cy) + plasma_time));
    let v = v + sin(x + plasma_time) + sin((y + plasma_time) / 2.0) + sin((x + y + plasma_time) / 2.0);
    let v = (v + sin(sqrt(x * x + y * y) + plasma_time)) / 2.0;
    let phase = v * (1.0 + line_density * 0.09) * 3.141592653589793;
    let result =
      if color_type == normal {
        let n = clamp((sin(phase + 2.0943951023931953) + 0.5) / 2.0, 0.0, 0.99999);
        let i = int(floor(n * len(colors)));
        mix(colors[i][t], colors[(i + 1) % len(colors)][t], n * len(colors) - i)
      } else {
        let r = floor((sin(phase) + 1.0) * 128.0) / 255.0;
        let g = floor((cos(phase) + 1.0) * 128.0) / 255.0;
        let b =
          if color_type == preset_2 { r }
          else if color_type == preset_3 { floor((sin(phase + 4.1887902047863905) + 1.0) * 128.0) / 255.0 }
          else if color_type == preset_4 { r }
          else { 0.0 };
        let g =
          if color_type == preset_3 { floor((sin(phase + 2.0943951023931953) + 1.0) * 128.0) / 255.0 }
          else if color_type == preset_4 { r }
          else { g };
        let r = if color_type == preset_2 { 1.0 / 255.0 } else { r };
        rgb(r, g, b)
      };
    result * (intensity / 100.0)
  }
}

-- PIXEL: Flat Bars, iteration motion, cardinal/alternate/compress/expand modes.
-- This uses the dense integer-buffer formula, mapped onto layout coordinates.
-- Zigzag bars, rotation and accumulated speed are not exposed.
effect VixenBars {
  param colors: array<gradient>;
  param direction: enum { up, down, left, right, expand, compress, horizontal_expand, horizontal_compress, alternate_up, alternate_down, alternate_left, alternate_right } = up;
  param iterations: int in 1..100 = 1;
  param repeat: int in 1..100 = 1;
  param highlight: bool = false;
  param show_3d: bool = false;
  param intensity: float in 0.0..100.0 = 100.0;
  param pixel_size: float in 0.001..1000.0 = 1.0;
  param frame_interval_ms: float in 1.0..1000.0 = 50.0;

  sample {
    let t = floor(time * 1000.0 / frame_interval_ms) * frame_interval_ms / (duration * 1000.0);
    let w = floor((target.max_x - target.min_x) / pixel_size) + 1.0;
    let h = floor((target.max_y - target.min_y) / pixel_size) + 1.0;
    let x = floor((pixel.x - target.min_x) / pixel_size);
    let y = h - 1.0 - floor((pixel.y - target.min_y) / pixel_size);
    let horizontal =
      direction == left || direction == right || direction == alternate_left || direction == alternate_right
      || direction == horizontal_expand || direction == horizontal_compress;
    let length = if horizontal { w } else { h };
    let coordinate =
      if direction == right || direction == alternate_right { x }
      else if direction == horizontal_expand { min(x, w - x - 1.0) }
      else if direction == horizontal_compress { max(x, w - x - 1.0) }
      else if horizontal { w - x - 1.0 }
      else if direction == down || direction == alternate_down { y }
      else if direction == expand { min(y, h - y - 1.0) }
      else if direction == compress { max(y, h - y - 1.0) }
      else { h - y - 1.0 };
    let count: float = len(colors) * repeat;
    let bar_size = floor(length / count) + 1.0;
    let position = (t * iterations) % 1.0;
    let alternate =
      direction == alternate_up || direction == alternate_down || direction == alternate_left || direction == alternate_right;
    let offset =
      if alternate { floor(position * count) * bar_size }
      else { floor(position * len(colors) * bar_size * repeat) };
    let n = coordinate + offset + 1.0;
    let result = colors[int(floor((n % (len(colors) * bar_size)) / bar_size))][(n % bar_size) / bar_size];
    let s = if highlight && n % bar_size == 0.0 { 0.0 } else { saturation(result) };
    let v = intensity(result);
    let v = if show_3d { v * (bar_size - n % bar_size - 1.0) / bar_size } else { v };
    hsv(hue(result), s, v * intensity / 100.0)
  }
}

-- PIXEL: Border, Simple/Advanced with shared or independent edge controls.
-- Marquee is not exposed. Default gradient red/green.
effect VixenBorder {
  param color_gradient: gradient;
  param border_mode: enum { simple, advanced } = simple;
  param border_type: enum { single, independent } = single;
  param gradient_mode: enum { over_time, across, vertical, diagonal_top_bottom, diagonal_bottom_top } = over_time;
  param simple_border_width: int in 0..1000 = 1;
  param thickness: float in 0.0..100.0 = 20.0;
  param top_thickness: float in 0.0..100.0 = 10.0;
  param bottom_thickness: float in 0.0..100.0 = 10.0;
  param left_thickness: float in 0.0..100.0 = 10.0;
  param right_thickness: float in 0.0..100.0 = 10.0;
  param border_size: float in 0.0..100.0 = 100.0;
  param border_height: float in 0.0..100.0 = 100.0;
  param x_offset: float in 0.0..100.0 = 50.0;
  param y_offset: float in 0.0..100.0 = 50.0;
  param intensity: float in 0.0..100.0 = 100.0;
  param pixel_size: float in 0.001..1000.0 = 1.0;
  param frame_interval_ms: float in 1.0..1000.0 = 50.0;

  sample {
    let t = floor(time * 1000.0 / frame_interval_ms) * frame_interval_ms / (duration * 1000.0);
    let w = floor((target.max_x - target.min_x) / pixel_size) + 1.0;
    let h = floor((target.max_y - target.min_y) / pixel_size) + 1.0;
    let x = floor((pixel.x - target.min_x) / pixel_size);
    let y = h - 1.0 - floor((pixel.y - target.min_y) / pixel_size);
    let simple_mode = border_mode == simple;
    let inset_x = floor((100.0 - border_size) * w / 200.0);
    let inset_y = floor((100.0 - border_height) * h / 200.0);
    let thick = (2.0 + thickness * (min(w, h) - 2.0) / 100.0) / 2.0;
    let rounded: float = if simple_mode { simple_border_width } else { round_even(thick) };
    let shift_x = if simple_mode { 0.0 } else { trunc(round_even(x_offset * 2.0 - 100.0) * (w - inset_x) / 100.0) };
    let shift_y = if simple_mode { 0.0 } else { trunc(round_even(y_offset * 2.0 - 100.0) * (h - inset_y) / 100.0) };
    let inset_x = if simple_mode { 0.0 } else { inset_x };
    let inset_y = if simple_mode { 0.0 } else { inset_y };
    let x = x - shift_x;
    let y = y - shift_y;
    guard !(x < inset_x || x >= w - inset_x || y < inset_y || y >= h - inset_y);
    let independent_edges = border_mode == advanced && border_type == independent;
    let top = if independent_edges { floor(top_thickness * h / 100.0) } else { rounded };
    let bottom = if independent_edges { floor(bottom_thickness * h / 100.0) } else { rounded };
    let left = if independent_edges { floor(left_thickness * w / 100.0) } else { rounded };
    let right = if independent_edges { floor(right_thickness * w / 100.0) } else { rounded };
    guard !(x >= inset_x + left && x < w - inset_x - right && y >= inset_y + bottom && y < h - inset_y - top);
    let position =
      if gradient_mode == across { x / w }
      else if gradient_mode == vertical { (h - y) / h }
      else if gradient_mode == diagonal_top_bottom { ((h - y) / h + x / w) / 2.0 }
      else if gradient_mode == diagonal_bottom_top { (y / h + x / w) / 2.0 }
      else { t };
    color_gradient[position] * (intensity / 100.0)
  }
}

-- PIXEL: Spiral, iteration motion, all directions, growth/shrink, blend and 3D.
-- Default gradients red/green/blue. Uses Vixen's last-strand-wins raster rule.
effect VixenSpiral {
  param colors: array<gradient>;
  param direction: enum { forward, backwards, none } = forward;
  param iterations: float in 0.0..100.0 = 1.0;
  param repeat: int in 1..100 = 1;
  param rotation: float in 0.0..100.0 = 57.0;
  param thickness: float in 0.0..100.0 = 60.0;
  param grow: bool = false;
  param shrink: bool = false;
  param blend: bool = false;
  param show_3d: bool = false;
  param intensity: float in 0.0..100.0 = 100.0;
  param pixel_size: float in 0.001..1000.0 = 1.0;
  param frame_interval_ms: float in 1.0..1000.0 = 50.0;

  sample {
    let t = floor(time * 1000.0 / frame_interval_ms) * frame_interval_ms / (duration * 1000.0);
    let w = floor((target.max_x - target.min_x) / pixel_size) + 1.0;
    let h = floor((target.max_y - target.min_y) / pixel_size) + 1.0;
    let x = floor((pixel.x - target.min_x) / pixel_size);
    let y = h - 1.0 - floor((pixel.y - target.min_y) / pixel_size);
    let count = len(colors) * repeat;
    let delta = floor(w / count);
    let thick = floor(delta * round_even(1.0 + thickness * 0.99) / 100.0) + 1.0;
    let gap = delta - thick;
    let position = (t * iterations) % 1.0;
    let growth =
      if grow && shrink { gap * 2.0 * min(position, 1.0 - position) }
      else if grow { gap * position }
      else if shrink { gap * (1.0 - position) }
      else { 0.0 };
    let thick = thick + trunc(growth);
    let shift = floor(floor(position * w * 10.0) / 10.0);
    let shift =
      if direction == none { 0.0 }
      else if direction == backwards { -shift }
      else { shift };
    let row_shift = trunc(y * trunc(rotation * 3.0 - 150.0) / h);
    let strand = (x - shift - row_shift) % w;
    -- The highest covering strand index owns the pixel.
    last for index in 0..count {
      let within = (strand - index * delta) % w;
      guard within < thick;
      let within = if thick > w { within + floor((thick - 1.0 - within) / w) * w } else { within };
      let color_position = if blend { (h - y - 1.0) / h } else { within / thick };
      let c = colors[index % len(colors)][color_position];
      let v =
        if show_3d { if direction == backwards { (thick - within) / thick } else { (within + 1.0) / thick } }
        else { intensity(c) };
      hsv(hue(c), saturation(c), v * intensity / 100.0)
    }
  }
}

-- PIXEL: Circular Shockwave. Acceleration presets correspond to Vixen curve
-- values 50 (linear), 55 (gentle_in, default), 45 (gentle_out), 0 (strong_out).
-- Other acceleration values need arbitrary pow. Radius default 0->100; width 2->4.
effect VixenShockwave {
  param color_gradient: gradient;
  param radius_curve: curve in 0.0..100.0;
  param width_curve: curve in 0.0..100.0;
  param center_x: float in 0.0..100.0 = 50.0;
  param center_y: float in 0.0..100.0 = 50.0;
  param acceleration: enum { linear, gentle_in, gentle_out, strong_out } = gentle_in;
  param blend_edges: bool = true;
  param scaled_radius: bool = true;
  param pixel_size: float in 0.001..1000.0 = 1.0;
  param frame_interval_ms: float in 1.0..1000.0 = 50.0;

  sample {
    let t = floor(time * 1000.0 / frame_interval_ms) * frame_interval_ms / (duration * 1000.0);
    let w = floor((target.max_x - target.min_x) / pixel_size) + 1.0;
    let h = floor((target.max_y - target.min_y) / pixel_size) + 1.0;
    let cx = floor(w * center_x / 100.0);
    let cy = floor(h * (100.0 - center_y) / 100.0);
    let dx = floor((pixel.x - target.min_x) / pixel_size) - cx;
    let dy = floor((pixel.y - target.min_y) / pixel_size) - cy;
    let adjusted =
      if acceleration == gentle_in { t * sqrt(t) }
      else if acceleration == gentle_out { 1.0 - (1.0 - t) * sqrt(1.0 - t) }
      else if acceleration == strong_out {
        let complement = 1.0 - t;
        let squared = complement * complement;
        1.0 - squared * squared * complement
      }
      else { t };
    let scale = if scaled_radius { max(w, h) } else { 750.0 };
    let radius = value_or(radius_curve[adjusted], 100.0) * scale / 100.0;
    let half_width = value_or(width_curve[adjusted], 100.0) * 2.55 / 2.0;
    let distance = sqrt(dx * dx + dy * dy);
    guard !(distance < max(0.0, radius - half_width) || distance > radius + half_width);
    -- A zero-width ring scales by NaN, which is black.
    let level = if blend_edges { max(0.0, 1.0 - abs(distance - radius) / half_width) } else { 1.0 };
    color_gradient[t] * level
  }
}

-- PIXEL: Garlands, five dense-grid patterns and four directions, iteration mode.
-- Spacing/iterations are fixed because Vixen's reset timing depends on history
-- when those values change. Sparse-row location remapping is not represented.
effect VixenGarlands {
  param colors: array<gradient>;
  param direction: enum { up, down, left, right } = up;
  param garland_type: enum { type_0, type_1, type_2, type_3, type_4 } = type_0;
  param iterations: int in 1..100 = 1;
  param spacing: float in 0.0..100.0 = 10.0;
  param intensity: float in 0.0..100.0 = 100.0;
  param pixel_size: float in 0.001..1000.0 = 1.0;
  param frame_interval_ms: float in 1.0..1000.0 = 50.0;

  sample {
    let frame = floor(time * 1000.0 / frame_interval_ms);
    let frames = floor(duration * 1000.0 / frame_interval_ms);
    -- An effect shorter than one frame has no garland state.
    guard !(frames < 1.0);
    let t = frame * frame_interval_ms / (duration * 1000.0);
    let w = floor((target.max_x - target.min_x) / pixel_size) + 1.0;
    let h = floor((target.max_y - target.min_y) / pixel_size) + 1.0;
    let x = floor((pixel.x - target.min_x) / pixel_size);
    let y = h - 1.0 - floor((pixel.y - target.min_y) / pixel_size);
    let sideways = direction == left || direction == right;
    let height = if sideways { w } else { h };
    let across = if sideways { y } else { x };
    let row =
      if direction == left { w - x - 1.0 }
      else if direction == right { x }
      else if direction == down { h - y - 1.0 }
      else { y };
    let separation = floor(round_even(1.0 + spacing * 0.19) * h / 100.0) + 3.0;
    let limit = height * separation * 4.0;
    let step = floor(limit / frames) * iterations;
    let cycle_frame =
      if step > 0.0 && frame > 0.0 {
        let reset = max(1.0, ceil((limit - 3.0) / step));
        ((frame - 1.0) % reset) + 1.0
      } else { frame };
    let state = max(0.0, floor((limit - cycle_frame * step) / 4.0));
    let m = across % 5.0;
    let deviation =
      if garland_type == type_1 || garland_type == type_2 {
        let deviation = if m == 2.0 { 2.0 } else if m == 1.0 || m == 3.0 { 1.0 } else { 0.0 };
        if garland_type == type_2 { deviation * 2.0 } else { deviation }
      }
      else if garland_type == type_3 { 2.0 * min(across % 6.0, 6.0 - across % 6.0) }
      else if garland_type == type_4 && (m == 1.0 || m == 3.0) { 2.0 }
      else { 0.0 };
    -- Invert the ring placement instead of rendering all rows for every pixel.
    let free_ring = (state - deviation - row) / separation;
    let selected_ring =
      if free_ring == floor(free_ring) && free_ring >= 0.0 && free_ring < height && row >= height - free_ring - 1.0 { free_ring }
      else { -1.0 };
    let settled_ring = height - row - 1.0;
    let selected_ring =
      if settled_ring >= 0.0 && settled_ring < height && state - settled_ring * separation - deviation <= row { max(selected_ring, settled_ring) }
      else { selected_ring };
    guard !(selected_ring < 0.0);
    let color_position = selected_ring / height * (len(colors) - 1);
    let i = int(floor(color_position));
    let result = mix(colors[i][t], colors[(i + 1) % len(colors)][t], color_position - i);
    result * (intensity / 100.0)
  }
}

-- PIXEL: Curtain, location-based Position mode, open/close, six edges and swag.
-- Default position curve: 100->0->100; default intensity curve: flat 100.
-- Automatic open-close iteration state is not exposed.
effect VixenCurtain {
  param color_gradient: gradient;
  param position_curve: curve in 0.0..100.0;
  param intensity_curve: curve in 0.0..100.0;
  param direction: enum { open, close } = open;
  param edge: enum { left, center, right, bottom, middle, top } = center;
  param iterations: int in 1..100 = 1;
  param swag: int in 0..100 = 1;
  param intensity_per_iteration: bool = false;
  param pixel_size: float in 0.001..1000.0 = 1.0;
  param frame_interval_ms: float in 1.0..1000.0 = 50.0;

  sample {
    let frame = floor(time * 1000.0 / frame_interval_ms);
    let frames = floor(duration * 1000.0 / frame_interval_ms);
    -- An effect shorter than one frame has no curtain position.
    guard !(frames < 1.0);
    let t = frame * frame_interval_ms / (duration * 1000.0);
    let phase = (frame * iterations % frames) * frame_interval_ms / (duration * 1000.0);
    let position = 1.0 - value_or(position_curve[phase], 100.0) / 100.0;
    let intensity_position = if intensity_per_iteration { phase } else { t };
    let level = value_or(intensity_curve[intensity_position], 100.0) / 100.0;
    let w = floor((target.max_x - target.min_x) / pixel_size) + 1.0;
    let h = floor((target.max_y - target.min_y) / pixel_size) + 1.0;
    let x = floor((pixel.x - target.min_x) / pixel_size);
    let y = floor((pixel.y - target.min_y) / pixel_size);
    let swag_length = if h > 1.0 { floor(swag * w / 40.0) } else { 0.0 };
    let vertical_axis = edge == bottom || edge == middle || edge == top;
    let paired = edge == center || edge == middle;
    let length = if vertical_axis { h } else { w };
    let cross_length = if vertical_axis { w } else { h };
    let coordinate = if vertical_axis { y } else { x };
    let cross_coordinate = if vertical_axis { x } else { y };
    let limit = floor(position * length + swag_length * position * 2.0);
    let limit = if direction == open { length - limit } else { limit };
    let limit = if paired { floor(limit / 2.0) } else { limit };
    let color_width = if paired { floor(length / 2.0) } else { length };
    -- A one-pixel paired curtain has no width to color.
    guard !(color_width <= 0.0);
    last for side in 0..2 {
      guard side == 0 || paired;
      let high_edge = edge == left || edge == top || (paired && side == 0);
      let swag_index = if high_edge { length - limit - coordinate } else { coordinate - limit };
      let covered =
        if vertical_axis { if high_edge { coordinate > length - limit } else { coordinate < limit } }
        else if high_edge { coordinate >= length - limit }
        else { coordinate <= limit };
      let covered =
        if swag_length > 0.0 && swag_index >= 0.0 && swag_index < swag_length {
          let swag_height = floor(cross_length * swag_index * swag_index / (swag_length * swag_length));
          covered
            || (!vertical_axis && cross_coordinate < cross_length - swag_height)
            || (vertical_axis && cross_coordinate > swag_height)
        } else { covered };
      guard covered;
      let color_position =
        if high_edge {
          if paired { 1.0 - (coordinate - (length - color_width)) / color_width }
          else { 1.0 - coordinate / color_width }
        } else { coordinate / color_width };
      color_gradient[color_position] * level
    }
  }
}

-- BASIC: Chase, ascending linear movement over ordered pixels. Nonmonotonic
-- movement curves and hierarchy targeting require intent scheduling preparation.
-- Pulse overlap is MILLISECONDS (not a number of pixels).
effect VixenChase {
  param color_gradient: gradient;
  param pulse_curve: curve in 0.0..100.0;
  param static_color: color = #ffffff;
  param color_handling: enum { single_color, gradient_per_pulse, gradient_through_effect, gradient_across_items } = single_color;
  param pulse_overlap_ms: float in 0.0..600000.0 = 0.0;
  param enable_default_level: bool = false;
  param default_level: float in 0.0..100.0 = 0.0;
  param extend_pulse_to_start: bool = false;
  param extend_pulse_to_end: bool = false;

  sample {
    let total = duration * 1000.0;
    let now = time * 1000.0;
    let count: float = target.count;
    let chase_time = max(1.0, total - pulse_overlap_ms);
    let step = clamp(chase_time / count / 2.0, 0.25, 2.0);
    let start = ceil(pixel.index / count * chase_time / step) * step;
    let next = ceil((pixel.index + 1.0) / count * chase_time / step) * step;
    let pulse_time = if pixel.index == target.count - 1 { total - start } else { next - start + pulse_overlap_ms };
    let local = (now - start) / pulse_time;
    let position =
      if color_handling == gradient_across_items { min(1.0, next / chase_time) }
      else if color_handling == gradient_through_effect { progress }
      else { local };
    let base = if color_handling != single_color { color_gradient[position] } else { static_color };
    let result =
      if enable_default_level {
        let baseline_position =
          if color_handling == gradient_across_items { pixel.index / count }
          else if color_handling == gradient_per_pulse { 0.0 }
          else { progress };
        let baseline = if color_handling != single_color { color_gradient[baseline_position] } else { static_color };
        baseline * (default_level / 100.0)
      } else { rgb(0.0, 0.0, 0.0) };
    let sampled_item = min(count - 1.0, floor(start / chase_time * count));
    let active =
      sampled_item == pixel.index && pulse_time > 0.0
      && ((local >= 0.0 && local <= 1.0) || (local < 0.0 && extend_pulse_to_start) || (local > 1.0 && extend_pulse_to_end));
    if active { max(result, base * (value_or(pulse_curve[local], 100.0) / 100.0)) } else { result }
  }
}

-- BASIC: Spin over ordered pixels, three speed and three pulse-length formats.
-- Pulse start times use Vixen's 0.25..2 ms movement sampling grid. Group/depth and
-- discrete-color intents are absent; overlapping RGB pulses combine by maximum.
-- At most 10,000 overlapping revolutions are combined at one pixel.
effect VixenSpin {
  param color_gradient: gradient;
  param pulse_curve: curve in 0.0..100.0;
  param static_color: color = #ffffff;
  param color_handling: enum { single_color, gradient_per_pulse, gradient_through_effect, gradient_across_items } = single_color;
  param speed_format: enum { revolution_count, revolution_frequency, fixed_time } = revolution_count;
  param pulse_length_format: enum { distribute_evenly, percent_revolution, pulse_time } = distribute_evenly;
  param revolutions: float in 0.01..1000.0 = 3.0;
  param frequency_hz: float in 0.01..1000.0 = 2.0;
  param revolution_time_ms: float in 1.0..600000.0 = 500.0;
  param pulse_time_ms: float in 0.0..600000.0 = 100.0;
  param pulse_overlap_ms: float in 0.0..600000.0 = 0.0;
  param pulse_percentage: float in 0.0..100.0 = 10.0;
  param reverse_spin: bool = false;
  param enable_default_level: bool = false;
  param default_level: float in 0.0..100.0 = 0.0;

  sample {
    let total = duration * 1000.0;
    let now = time * 1000.0;
    let count: float = target.count;
    let constant =
      if pulse_length_format == pulse_time {
        if pulse_overlap_ms != 0.0 { min(total - 1.0, total / count + pulse_overlap_ms) } else { pulse_time_ms }
      } else { 0.0 };
    let fractional =
      if pulse_length_format == pulse_time { 0.0 }
      else if pulse_length_format == percent_revolution { pulse_percentage / 100.0 }
      else { 1.0 / count };
    let divisor = revolutions + fractional - 1.0 / count;
    let divisor = if divisor <= 0.0 { revolutions } else { divisor };
    let revolution_ms =
      if speed_format == fixed_time { revolution_time_ms }
      else if speed_format == revolution_frequency { 1000.0 / frequency_hz }
      else { (total - constant) / divisor };
    let pulse_ms = constant + revolution_ms * fractional;
    -- A pulse as long as the effect leaves no time to revolve.
    guard !(revolution_ms <= 0.0 || pulse_ms <= 0.0);
    let step = clamp(revolution_ms / count / 2.0, 0.25, 2.0);
    let item: float = if reverse_spin { count - pixel.index - 1.0 } else { pixel.index };
    let result =
      if enable_default_level {
        let base =
          if color_handling == gradient_across_items { color_gradient[pixel.index / count] }
          else if color_handling == gradient_per_pulse { color_gradient[0.0] }
          else if color_handling == gradient_through_effect { color_gradient[progress] }
          else { static_color };
        base * (default_level / 100.0)
      } else { rgb(0.0, 0.0, 0.0) };
    -- Only revolutions whose pulses could cover now need evaluation.
    let first_cycle = max(0.0, floor((now - pulse_ms) / revolution_ms));
    let last_cycle = floor(now / revolution_ms);
    let pulses = max for candidate in 0..int(min(10000.0, last_cycle - first_cycle + 1.0)) {
      let cycle = first_cycle + candidate;
      let ideal = (cycle + item / count) * revolution_ms;
      let start = ceil(ideal / step) * step;
      -- Reverse movement enters most bins strictly after the boundary.
      let start = if reverse_spin && item > 0.0 && start == ideal { start + step } else { start };
      let raw_position = (start % revolution_ms) / revolution_ms;
      let previous_position = (start - step) % revolution_ms / revolution_ms;
      let sampled_position = if reverse_spin { 1.0 - raw_position } else { raw_position };
      let previous_position = if reverse_spin { 1.0 - previous_position } else { previous_position };
      let sampled_item = min(count - 1.0, floor(sampled_position * count));
      let previous_item = min(count - 1.0, floor(previous_position * count));
      let entered = sampled_item == pixel.index && (start == 0.0 || previous_item != sampled_item);
      guard entered && start <= total - pulse_ms + step && now >= start && now <= start + pulse_ms;
      let local = (now - start) / pulse_ms;
      let position =
        if color_handling == gradient_across_items { sampled_position }
        else if color_handling == gradient_through_effect { progress }
        else { local };
      let c = if color_handling != single_color { color_gradient[position] } else { static_color };
      c * (value_or(pulse_curve[local], 100.0) / 100.0)
    };
    max(result, pulses)
  }
}

-- BASIC: Wipe, horizontal/vertical Count mode, RGB colors and wipe on/off.
-- Vixen's "Gradient Thru Effect" in Count mode traverses the gradient per pulse.
-- Non-cardinal geometry and movement-curve/pulse-length modes are not exposed.
effect VixenWipe {
  param color_gradient: gradient;
  param pulse_curve: curve in 0.0..100.0;
  param direction: enum { horizontal, vertical } = horizontal;
  param color_handling: enum { gradient_through_effect, color_across_items } = gradient_through_effect;
  param pass_count: int in 1..100 = 1;
  param pulse_percent: float in 0.01..100.0 = 33.0;
  param reverse_direction: bool = false;
  param color_across_item_per_count: bool = true;
  param wipe_on: bool = false;
  param wipe_off: bool = false;
  param pixel_size: float in 0.001..1000.0 = 1.0;

  sample {
    let steps =
      if direction == vertical { floor((target.max_y - target.min_y) / pixel_size) }
      else { floor((target.max_x - target.min_x) / pixel_size) };
    let item =
      if direction == vertical { floor((pixel.y - target.min_y) / pixel_size) }
      else { floor((pixel.x - target.min_x) / pixel_size) };
    -- A target narrower than one virtual pixel has nothing to wipe across.
    guard !(steps <= 0.0);
    let item = if reverse_direction { steps - item } else { item };
    let groups = steps + 1.0;
    let total = duration;
    let pulse_seconds = total * pulse_percent * steps / groups / 100.0 / pass_count;
    let interval = (total - pulse_seconds) / (groups * pass_count);
    max for pass in 0..pass_count {
      let start = (pass * groups + item) * interval;
      let local = (time - start) / pulse_seconds;
      guard (local >= 0.0 && local <= 1.0)
        || (pass == 0 && wipe_off && local < 0.0)
        || (pass == pass_count - 1 && wipe_on && local > 1.0);
      let color_position =
        if color_handling == color_across_items {
          let across = start / (total - pulse_seconds);
          if color_across_item_per_count { (across * pass_count) % 1.0 } else { across }
        } else { local };
      color_gradient[color_position] * (value_or(pulse_curve[local], 100.0) / 100.0)
    }
  }
}

-- PIXEL: Spirograph, original sampled hypotrochoid with Standard/Random/Rainbow.
-- Uses the string-buffer formula on a layout-derived grid. Up to 5,400 curve
-- points are examined per pixel; this is expensive and has not been benchmarked.
-- Random colors are repeatable Donder samples indexed by frame and curve point.
effect VixenSpirograph {
  param colors: array<gradient>;
  param color_type: enum { standard, random, rainbow } = standard;
  param outer_circle_radius: float in 0.0..100.0 = 88.0;
  param inner_circle_radius: float in 0.0..100.0 = 21.0;
  param speed: float in 0.0..100.0 = 2.0;
  param distance: float in 0.0..100.0 = 50.0;
  param color_range: float in 0.0..100.0 = 35.0;
  param spirograph_range: float in 0.0..100.0 = 33.0;
  param animate: bool = true;
  param intensity: float in 0.0..100.0 = 100.0;
  param random_seed: float in 0.0..1000000.0 = 0.0;
  param pixel_size: float in 0.001..1000.0 = 1.0;
  param frame_interval_ms: float in 1.0..1000.0 = 50.0;

  sample {
    let frame = floor(time * 1000.0 / frame_interval_ms);
    let t = frame * frame_interval_ms / (duration * 1000.0);
    let w = floor((target.max_x - target.min_x) / pixel_size) + 1.0;
    let h = floor((target.max_y - target.min_y) / pixel_size) + 1.0;
    let cx = floor(w / 2.0);
    let cy = floor(h / 2.0);
    let x = floor((pixel.x - target.min_x) / pixel_size);
    let y = h - 1.0 - floor((pixel.y - target.min_y) / pixel_size);
    let outer = cx * outer_circle_radius / 100.0;
    let inner = min(outer, cx * inner_circle_radius / 100.0);
    -- A zero inner circle has no hypotrochoid.
    guard !(inner <= 0.0);
    let state = frame * speed;
    let d = cx * (1.0 + distance * 0.99) / 100.0;
    let d = if animate { floor(d + state / 2.0) % 100.0 } else { d };
    guard !(sqrt((x - cx) * (x - cx) + (y - cy) * (y - cy)) > outer - inner + d + 0.707107);
    let state_mod = state % 1440.0;
    let rounded_state = round_even(state_mod);
    let samples = floor((1.0 + spirograph_range * 2.99) * 18.0);
    let range_value = 1.0 + color_range * 1.99;
    let bin = range_value / len(colors);
    let rounded_bin = round_even(bin);
    -- More colors than the color range leaves standard colors no distance bins.
    guard !(color_type == standard && rounded_bin <= 0.0);
    first for ordinal in 0..int(samples) {
      let point = samples - ordinal;
      let angle = (point + rounded_state) * 0.017453292519943295;
      let xx = (outer - inner) * cos(angle) + d * cos((outer - inner) / inner * angle) + cx;
      let yy = (outer - inner) * sin(angle) + d * sin((outer - inner) / inner * angle) + cy;
      let rx = round_even(xx);
      let ry = round_even(yy);
      guard rx == x && ry == y;
      let level = intensity / 100.0;
      if color_type == rainbow {
        hsv(floor(rand((random_seed * 31.0 + frame) * 31.0 + point) * 1000.0) / 1000.0, 1.0, level)
      } else {
        let selected =
          if color_type == random { floor(rand((random_seed * 31.0 + frame) * 31.0 + point) * len(colors)) }
          else { floor(sqrt((rx - cx) * (rx - cx) + (ry - cy) * (ry - cy)) / range_value * 100.0 / rounded_bin) };
        colors[int(selected)][t] * level
      }
    }
  }
}
