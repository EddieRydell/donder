workspace:
  format_version: 1
  project_id: 00000000-0000-4000-8000-000000000001
imports:
- from:
    documents:
    - effects/standard.effect.donder
    - effects/impact-burst.effect.donder
    - effects/mark-impact-burst.effect.donder
  as: effects
- from:
    documents:
    - effects/vixen.effect.donder
  as: vixen
- from:
    documents:
    - operators/standard.operator.donder
  as: operators
- from:
    documents:
    - setups/main.setup.donder
  as: setups
- from:
    documents:
    - sequences/empty.sequence.donder
    - sequences/layer_test.sequence.donder
  as: sequences
starter:
  type: project
  setup: setups.main
  sequences:
  - sequences.empty
  - sequences.layer_test
