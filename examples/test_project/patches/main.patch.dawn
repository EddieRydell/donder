imports:
- from:
    documents:
    - display/main.display.dawn
  as: display
- from:
    documents:
    - setups/main.setup.dawn
  as: setups
main:
  type: patch
  routes:
  - id: 1
    target: { layout: display.main, fixture: 1 }
    controller: setups.output_controller
    port: 1
    start_slot: 0
    encoding: { type: rgb, order: [0, 1, 2] }
    gamma: 1.0
    brightness: 1.0
