imports:
- from:
    documents:
    - display/main.display.dawn
  as: display
- from:
    documents:
    - patches/main.patch.dawn
  as: patches
main:
  type: setup
  layout: display.main
  patch: patches.main
  controllers:
  - output_controller
output_controller:
  type: controller
  protocol:
    type: e131
    source_name: Dawn
    bind_address: 0.0.0.0
    priority: 100
    mode: multicast
  ports:
  - id: 1
    universe: 1
    slot_count: 3
