effect MarkImpactBurst {
  param beats: marks;
  param gradients: array<gradient>;
  param intensity: curve in 0.0..1.0;
  param direction: enum { outward, inward } = outward;
  param color_mode: enum { through_effect, from_center, from_edge } = through_effect;
  param offset_seconds: float in -1.0..1.0 = 0.0;
  param burst_seconds: float in 0.01..10.0 = 0.45;
  param center_position: float in 0.0..1.0 = 0.5;
  param start_radius: float in 0.0..2.0 = 0.0;
  param end_radius: float in 0.01..2.0 = 0.75;
  param edge_width: float in 0.001..1.0 = 0.08;
  param glow_width: float in 0.0..1.0 = 0.25;
  param glow_level: float in 0.0..1.0 = 0.35;
  param mirror: bool = false;

  sample {
    let mark = mark_last_index(beats, time - offset_seconds);
    let hit_time = mark_at(beats, mark);
    let age = time - hit_time - offset_seconds;
    -- Before the first mark the hit time is NaN, which renders black.
    guard !(hit_time + offset_seconds < 0.0 || age < 0.0 || age >= burst_seconds);
    let child_progress = age / burst_seconds;
    let selected_gradient = gradients[mark % len(gradients)];
    let distance = abs(pixel.fraction - center_position);
    let distance = if mirror { distance * 2.0 } else { distance };
    let travel = if direction == inward { 1.0 - child_progress } else { child_progress };
    let radius = mix(start_radius, end_radius, travel);
    let ring = 1.0 - smoothstep(0.0, edge_width, abs(distance - radius));
    let glow = 1.0 - smoothstep(0.0, max(edge_width, glow_width), abs(distance - radius));
    let level = max(ring, glow * glow_level) * intensity[child_progress];
    let color_position =
      if color_mode == from_center { distance / end_radius }
      else if color_mode == from_edge { 1.0 - distance / end_radius }
      else { child_progress };
    gradient_color_scaled(selected_gradient, color_position, level)
  }
}
