effect MarkImpactBurst {
  param marks beats;
  param array<gradient> gradients;
  param curve intensity in 0.0..1.0;
  param enum direction { outward, inward } = outward;
  param enum color_mode { through_effect, from_center, from_edge } = through_effect;
  param float offset_seconds in -1.0..1.0 = 0.0;
  param float burst_seconds in 0.01..10.0 = 0.45;
  param float center_position in 0.0..1.0 = 0.5;
  param float start_radius in 0.0..2.0 = 0.0;
  param float end_radius in 0.01..2.0 = 0.75;
  param float edge_width in 0.001..1.0 = 0.08;
  param float glow_width in 0.0..1.0 = 0.25;
  param float glow_level in 0.0..1.0 = 0.35;
  param bool mirror = false;

  color sample() {
    int mark = mark_last_index(beats, seconds() - offset_seconds);
    float hit_time = mark_at(beats, mark);
    float age = seconds() - hit_time - offset_seconds;
    // Before the first mark the hit time is missing.
    if (is_nan(age) || hit_time + offset_seconds < 0.0 || age < 0.0 || age >= burst_seconds) { return rgb(0.0, 0.0, 0.0); }
    float child_progress = age / burst_seconds;
    gradient selected_gradient = gradients[mark % len(gradients)];
    float distance = abs(pixel_fraction() - center_position);
    if (mirror) {
      distance = distance * 2.0;
    }

    float travel = child_progress;
    if (direction == inward) {
      travel = 1.0 - child_progress;
    }

    float radius = mix(start_radius, end_radius, travel);
    float ring = 1.0 - smoothstep(0.0, edge_width, abs(distance - radius));
    float glow = 1.0 - smoothstep(0.0, max(edge_width, glow_width), abs(distance - radius));
    float level = max(ring, glow * glow_level) * intensity[child_progress];

    float color_position = child_progress;
    if (color_mode == from_center) {
      color_position = distance / end_radius;
    }
    if (color_mode == from_edge) {
      color_position = 1.0 - distance / end_radius;
    }

    return gradient_color_scaled(selected_gradient, color_position, level);
  }
}
