effect Pulse {
  param gradient gradient;
  param curve pulse_shape;

  color sample() {
    return gradient_color_scaled(gradient, progress(), curve_clamped(pulse_shape, progress(), 0.0, 1.0));
  }
}

effect Chase {
  param gradient gradient;
  param enum gradient_mode { through_effect, across_items, per_pulse } = per_pulse;
  param float pulse_overlap = 8.0;
  param int section_width_pixels = 1;
  param curve chase_position;
  param bool reverse = false;
  param bool extend_to_start = false;
  param bool extend_to_end = false;
  param curve pulse_shape;

  color sample() {
    float width = max(1.0, section_width_pixels);
    float item_count = max(1.0, floor((pixel_count() + width - 1.0) / width));
    float item_index = floor(pixel_index() / width);
    float position = item_index / max(1.0, item_count - 1.0);
    float chase_value = position;
    if (reverse) { chase_value = 1.0 - chase_value; }
    float pulse_duration = max(0.000000001, max(1.0, pulse_overlap) / item_count);
    float travel_start = 0.0;
    float travel_end = max(0.0, 1.0 - pulse_duration);
    if (extend_to_start) { travel_start = -pulse_duration; }
    if (extend_to_end) { travel_end = 1.0; }
    float hit = mix(travel_start, travel_end, clamp(curve_crossing(chase_position, chase_value, chase_value), 0.0, 1.0));
    float pulse_progress = (progress() - hit) / pulse_duration;
    float level = 0.0;
    if (pulse_progress >= 0.0 && pulse_progress <= 1.0) {
      level = curve_clamped(pulse_shape, pulse_progress, 0.0, 1.0);
    }
    float gradient_position = pulse_progress;
    if (gradient_mode == through_effect) { gradient_position = progress(); }
    if (gradient_mode == across_items) { gradient_position = position; }
    return gradient_color_scaled(gradient, clamp(gradient_position, 0.0, 1.0), level);
  }
}

effect Spin {
  param gradient gradient;
  param enum gradient_mode { through_effect, across_items, per_pulse } = per_pulse;
  param float pulse_overlap = 8.0;
  param int section_width_pixels = 1;
  param curve chase_position;
  param int revolutions = 2;
  param bool reverse = false;
  param bool extend_to_start = false;
  param bool extend_to_end = false;
  param curve pulse_shape;

  color sample() {
    float width = max(1.0, section_width_pixels);
    float item_count = max(1.0, floor((pixel_count() + width - 1.0) / width));
    float item_index = floor(pixel_index() / width);
    float position = item_index / max(1.0, item_count - 1.0);
    int revolution_count = revolutions;
    if (revolution_count < 1) { revolution_count = 1; }
    float virtual_item_count = item_count * revolution_count;
    float pulse_duration = max(0.000000001, max(1.0, pulse_overlap) / virtual_item_count);
    float travel_start = 0.0;
    float travel_end = max(0.0, 1.0 - pulse_duration);
    if (extend_to_start) { travel_start = -pulse_duration; }
    if (extend_to_end) { travel_end = 1.0; }
    float level = 0.0;
    float gradient_position = 0.0;
    for (int revolution = 0; revolution < revolution_count; revolution = revolution + 1) {
      float virtual_position = (revolution + position) / revolution_count;
      if (reverse) { virtual_position = 1.0 - virtual_position; }
      float hit = mix(travel_start, travel_end, clamp(curve_crossing(chase_position, virtual_position, virtual_position), 0.0, 1.0));
      float pulse_progress = (progress() - hit) / pulse_duration;
      if (pulse_progress >= 0.0 && pulse_progress <= 1.0) {
        float candidate = curve_clamped(pulse_shape, pulse_progress, 0.0, 1.0);
        if (candidate > level) {
          level = candidate;
          gradient_position = pulse_progress;
          if (gradient_mode == through_effect) { gradient_position = progress(); }
          if (gradient_mode == across_items) { gradient_position = position; }
        }
      }
    }
    return gradient_color_scaled(gradient, clamp(gradient_position, 0.0, 1.0), level);
  }
}

effect MarkPulse {
  fixed param marks beats;
  param gradient accent;
  param curve pulse_shape;
  fixed param float offset_seconds = 0.0;
  fixed param float decay_seconds = 0.18;
  fixed param int section_width_pixels = 5;
  fixed param int sections_per_mark = 3;
  fixed param float seed = 0.0;

  void generate() {
    TargetItems items = sections(target, section_width_pixels);
    int section_count = count(items);
    if (section_count > 0) {
      for (int mark = 0; mark < mark_count(beats); mark = mark + 1) {
        float hit_time = mark_at(beats, mark, -999.0);
        for (int section = 0; section < sections_per_mark; section = section + 1) {
          float choice = floor(rand(seed + hit_time * 1000.0, section) * section_count);
          timeline.emit Pulse {
            start: hit_time + offset_seconds,
            duration: max(0.000000001, decay_seconds),
            target: pick(items, choice),
            gradient: accent,
            pulse_shape: pulse_shape
          };
        }
      }
    }
  }
}

effect MarkChase {
  fixed param marks beats;
  param enum gradient_mode { through_effect, across_items, per_pulse } = per_pulse;
  fixed param array<gradient> gradients;
  fixed param float offset_seconds = 0.0;
  fixed param float chase_seconds = 0.5;
  param float pulse_overlap = 8.0;
  param int section_width_pixels = 5;
  fixed param array<curve> chase_positions;
  param curve pulse_shape;

  void generate() {
    int gradient_count = len(gradients);
    int position_count = len(chase_positions);
    if (gradient_count > 0 && position_count > 0) {
      for (int mark = 0; mark < mark_count(beats); mark = mark + 1) {
        float hit_time = mark_at(beats, mark, -999.0);
        timeline.emit Chase {
          start: hit_time + offset_seconds,
          duration: max(0.000000001, chase_seconds),
          target: target,
          gradient: gradients[mark % gradient_count],
          gradient_mode: gradient_mode,
          pulse_overlap: pulse_overlap,
          section_width_pixels: section_width_pixels,
          chase_position: chase_positions[mark % position_count],
          pulse_shape: pulse_shape
        };
      }
    }
  }
}
