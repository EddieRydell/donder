      Edge { from: layers.default, to: root },
      Edge { from: layers.predrop_16ths, to: saturate.source },
      Edge { from: saturate, to: dim.input },
      Edge { from: dim, to: hue_shift.source },
      Edge { from: hue_shift, to: root },
      Edge { from: layers.predrop_snares, to: dim.input },
    ],
  },
}
