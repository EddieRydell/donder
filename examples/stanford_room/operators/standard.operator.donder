// Editable project-local composition operators.
operator Max {
  input Signal a;
  input Signal b;

  color sample() {
    return max(a.at(seconds()), b.at(seconds()));
  }
}

operator Add {
  input Signal a;
  input Signal b;

  color sample() {
    return a.at(seconds()) + b.at(seconds());
  }
}

operator Multiply {
  input Signal a;
  input Signal b;

  color sample() {
    return a.at(seconds()) * b.at(seconds());
  }
}

operator HueMap {
  input Signal source;
  input Signal gradient;

  color sample() {
    color source_color = source.at(seconds());
    color gradient_color = gradient.at(seconds());
    return hsv(hue(gradient_color), saturation(source_color), intensity(source_color));
  }
}

operator IntensityModulate {
  input Signal source;
  input Signal mask;

  color sample() {
    return source.at(seconds()) * intensity(mask.at(seconds()));
  }
}

operator Dim {
  input Signal input;
  param float amount in 0.0..1.0 = 0.5;

  color sample() {
    return input.at(seconds()) * amount;
  }
}

operator Invert {
  input Signal input;

  color sample() {
    return invert(input.at(seconds()));
  }
}

operator Colorize {
  input Signal input;
  param color tint = #ffffff;

  color sample() {
    return tint * intensity(input.at(seconds()));
  }
}

operator HueShift {
  input Signal source;
  // Turns; a whole turn leaves the hue unchanged.
  param float shift in 0.0..1.0 = 0.0;

  color sample() {
    color value = source.at(seconds());
    if (shift == floor(shift)) { return value; }
    return hsv(hue(value) + shift, saturation(value), intensity(value));
  }
}

operator Delay {
  input Signal input;
  param float seconds in 0.0..60.0 = 0.1;

  color sample() {
    return input.at(seconds() - seconds);
  }
}

operator Echo {
  input Signal input;
  param float seconds in 0.0..60.0 = 0.1;
  param int repeats in 1..32 = 3;
  param float decay in 0.0..1.0 = 0.5;

  // Samples before the sequence are black, so early echoes add nothing.
  color sample() {
    color result = rgb(0.0, 0.0, 0.0);
    float amount = 1.0;
    for (int repeat in range(repeats + 1)) {
      result = max(result, input.at(seconds() - seconds * repeat) * amount);
      amount = amount * decay;
    }
    return result;
  }
}

operator FreezeFrame {
  input Signal input;
  param float interval_seconds in 0.001..10.0 = 0.01;
  param float fade_seconds in 0.001..60.0 = 1.0;

  // Keeps at most 32 snapshots; samples before the sequence are black.
  color sample() {
    float now = seconds();
    float capture_index = floor(now / interval_seconds);
    color result = rgb(0.0, 0.0, 0.0);
    int snapshots = int(min(32.0, ceil(fade_seconds / interval_seconds)));
    for (int snapshot in range(snapshots)) {
      float snapshot_time = (capture_index - snapshot) * interval_seconds;
      float age = now - snapshot_time;
      if (age < fade_seconds) {
        result = max(result, input.at(snapshot_time) * (1.0 - age / fade_seconds));
      }
    }
    return result;
  }
}
