import layout from <layouts/layout.data.donder>;
import patches from <patches/patch.data.donder>;

Setup setup {
  description: none,
  layout: layout.layout,
  patch: patches.patch,
  controllers: [dig_quad],
  input_devices: [
    InputDevice input_device {
      description: none,
      driver: Midi { port: none },
      controls: [
        Button {
          name: control_1,
          description: none,
          input: Notes { low: 48, high: 72, channel: none },
        },
        Axis { name: knob_1, description: none, input: ControlChange { number: 1, channel: none } },
      ],
    },
  ],
}

Controller dig_quad {
  description: none,
  protocol: Donder {
    device: "b0cbd8030790",
    ports: [DonderPort { name: "port_1", description: none, output: 1, slots: 450 }],
  },
}
