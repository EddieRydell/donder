imports:
- from:
    documents:
    - layouts/main.layout.donder
  as: layout
- from:
    documents:
    - patches/main.patch.donder
  as: patches
main:
  type: setup
  layout: layout.main
  patch: patches.main
  controllers:
  - dig_quad
dig_quad:
  type: controller
  protocol:
    type: e131
    source_name: Donder Stanford Room
    bind_address: 0.0.0.0
    priority: 100
    mode: unicast
    destination: 127.0.0.1
  ports:
  - id: 1
    universe: 1
    slot_count: 450
