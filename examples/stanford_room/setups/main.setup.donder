imports:
- from:
    documents:
    - layouts/main.layout.donder
  as: layout
- from:
    documents:
    - patches/main.patch.donder
  as: patches
main:
  type: setup
  layout: layout.main
  patch: patches.main
  controllers:
  - dig_quad
dig_quad:
  type: controller
  protocol:
    type: donder
    device: b0cbd8030790
  ports:
  - id: 1
    output: 1
    slot_count: 450
