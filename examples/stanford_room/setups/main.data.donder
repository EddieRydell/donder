import layout from <layouts/main.data.donder>;
import patches from <patches/main.data.donder>;

Setup main {
  description: none,
  layout: layout.main,
  patch: patches.main,
  controllers: [dig_quad],
  input_devices: [
    InputDevice input_device {
      description: none,
      driver: Midi { port: none },
      controls: [
        Button {
          name: control_1,
          description: none,
          input: Notes { low: 48, high: 72, channel: none },
        },
        Axis { name: knob_1, description: none, input: ControlChange { number: 1, channel: none } },
      ],
    },
  ],
}

Controller dig_quad {
  description: none,
  protocol: Donder { device: "b0cbd8030790" },
  ports: [Port { name: port_1, address: Output { output: 1 }, slots: 450 }],
}
