imports:
- from:
    documents:
    - layouts/main.layout.donder
  as: layouts
- from:
    documents:
    - setups/main.setup.donder
  as: setups
main:
  type: patch
  routes:
  - id: 1
    target:
      layout: layouts.main
      fixture: 1
    controller: setups.dig_quad
    port: 1
    start_slot: 0
    encoding:
      type: rgb
      order: [1, 0, 2]
    gamma: 1.0
    brightness: 1.0
  - id: 2
    target:
      layout: layouts.main
      fixture: 3
    controller: setups.dig_quad
    port: 1
    start_slot: 90
    encoding:
      type: rgb
      order: [1, 0, 2]
    gamma: 1.0
    brightness: 1.0
  - id: 3
    target:
      layout: layouts.main
      fixture: 2
    controller: setups.dig_quad
    port: 1
    start_slot: 210
    encoding:
      type: rgb
      order: [1, 0, 2]
    gamma: 1.0
    brightness: 1.0
  - id: 4
    target:
      layout: layouts.main
      fixture: 5
    controller: setups.dig_quad
    port: 1
    start_slot: 300
    encoding:
      type: rgb
      order: [1, 0, 2]
    gamma: 1.0
    brightness: 1.0
  - id: 5
    target:
      layout: layouts.main
      fixture: 6
    controller: setups.dig_quad
    port: 1
    start_slot: 375
    encoding:
      type: rgb
      order: [1, 0, 2]
    gamma: 1.0
    brightness: 1.0
