-- Editable project-local composition operators.
operator Max {
  input a;
  input b;

  sample { max(a, b) }
}

operator Add {
  input a;
  input b;

  sample { a + b }
}

operator Multiply {
  input a;
  input b;

  sample { a * b }
}

operator IntensityModulate {
  input source;
  input mask;

  sample { source * intensity(mask) }
}

-- Vixen's Intensity Overlay: where `coverage` is lit, scale `source` by the
-- brightness of `overlay`; elsewhere pass `source` through.
operator IntensityOverlay {
  input source;
  input overlay;
  input coverage;

  sample {
    let covered = intensity(coverage);
    source * (1.0 - covered + covered * intensity(overlay))
  }
}

operator Dim {
  input input;
  param amount: float in 0.0..1.0 = 0.5;

  sample { input * amount }
}

operator Invert {
  input input;

  sample { invert(input) }
}

operator Colorize {
  input input;
  param tint: color = #ffffff;

  sample { tint * intensity(input) }
}

operator HueShift {
  input source;
  -- Turns.
  param shift: float in 0.0..1.0 = 0.0;

  sample { hsv(hue(source) + shift, saturation(source), intensity(source)) }
}

operator Delay {
  input input;
  param seconds: float in 0.0..60.0 = 0.1;

  sample { input.at(time - seconds) }
}

operator Echo {
  input input;
  param seconds: float in 0.0..60.0 = 0.1;
  param repeats: int in 1..32 = 3;
  param decay: float in 0.0..1.0 = 0.5;

  -- Samples before the sequence are black, so early echoes add nothing.
  sample {
    max for repeat in 0..=repeats {
      input.at(time - seconds * repeat) * pow(decay, repeat)
    }
  }
}

operator Blur {
  input input;
  -- Pixels averaged on each side, along each fixture's pixel order.
  param radius: int in 1..16 = 2;

  -- Tent weights, renormalized where a fixture ends so its edges keep their level:
  -- an `around` that ignores its neighbors counts only the offsets that have one.
  sample {
    let total = sum for offset in -radius..=radius around input { radius + 1 - abs(offset) };
    sum for offset in -radius..=radius around input as neighbor {
      neighbor * ((radius + 1 - abs(offset)) / total)
    }
  }
}

-- A pixel's brightness in 0..1.
fn brightness(c: color, measure: enum { Brightest, Luminance, Average }) -> float {
  if measure == Luminance {
    0.2126 * red(c) + 0.7152 * green(c) + 0.0722 * blue(c)
  } else if measure == Average {
    (red(c) + green(c) + blue(c)) / 3.0
  } else {
    intensity(c)
  }
}

-- How much of a pixel at `level` passes: 0 below the knee, 1 above it.
fn threshold_weight(level: float, threshold: float, softness: float) -> float {
  if softness > 0.0 {
    smoothstep(threshold - softness / 2.0, threshold + softness / 2.0, level)
  } else {
    step(threshold, level)
  }
}

-- A glow kernel's weight `offset` pixels from its center, 1 at the center.
fn falloff_weight(offset: int, radius: int, falloff: enum { Gaussian, Linear, Flat }) -> float {
  let distance = abs(offset) / (radius + 1);
  if falloff == Gaussian {
    exp(-4.5 * distance * distance)
  } else if falloff == Linear {
    1.0 - distance
  } else {
    1.0
  }
}

operator Threshold {
  input input;
  -- Brightness where pixels start to pass.
  param threshold: float in 0.0..1.0 = 0.5;
  -- Width of the fade centered on the threshold; 0 is a hard cut.
  param softness: float in 0.0..1.0 = 0.1;
  -- How a pixel's brightness is measured.
  param measure: enum { Brightest, Luminance, Average } = Brightest;
  -- Pass the pixels below the threshold instead.
  param invert: bool = false;

  sample {
    let weight = threshold_weight(brightness(input, measure), threshold, softness);
    input * (if invert { 1.0 - weight } else { weight })
  }
}

operator Bloom {
  input input;
  -- Brightness where pixels start to glow.
  param threshold: float in 0.0..1.0 = 0.6;
  -- Width of the fade centered on the threshold; 0 is a hard cut.
  param softness: float in 0.0..1.0 = 0.2;
  -- How a pixel's brightness is measured against the threshold.
  param measure: enum { Brightest, Luminance, Average } = Brightest;
  -- Pixels the glow spreads on each side, along each fixture's pixel order.
  param radius: int in 1..32 = 6;
  -- How the glow fades with distance.
  param falloff: enum { Gaussian, Linear, Flat } = Gaussian;
  -- Glow brightness; the glow's total light at 1 matches its sources'.
  param strength: float in 0.0..8.0 = 2.0;
  -- Multiplies the glow's color; white keeps each source's color.
  param tint: color = #ffffff;
  -- How the glow combines with the input.
  param blend: enum { Add, Screen, Lighten, GlowOnly } = Add;

  -- The kernel is normalized over its full width, so glow fades off fixture ends
  -- instead of piling up there. Strength scales each sample before it is rounded
  -- to 8 bits, keeping faint tails.
  sample {
    let total = sum for offset in -radius..=radius { falloff_weight(offset, radius, falloff) };
    let glow = sum for offset in -radius..=radius around input as neighbor {
      let weight = threshold_weight(brightness(neighbor, measure), threshold, softness);
      guard weight > 0.0;
      neighbor * (weight * falloff_weight(offset, radius, falloff) * strength / total)
    };
    let glow = glow * tint;
    if blend == Add {
      input + glow
    } else if blend == Screen {
      invert(invert(input) * invert(glow))
    } else if blend == Lighten {
      max(input, glow)
    } else {
      glow
    }
  }
}

operator Trail {
  input input;
  -- How much of each pixel's light carries on to the next, along each fixture's pixel order.
  param decay: float in 0.0..1.0 = 0.8;
  -- Which way the trail runs; Both takes the brighter of the two.
  param direction: enum { Forward, Backward, Both } = Forward;

  -- Light builds up in floats and is rounded once, so faint tails keep fading.
  sample {
    let forward = scan forward input as light, previous { previous * decay + light };
    let backward = scan backward input as light, previous { previous * decay + light };
    if direction == Forward {
      forward
    } else if direction == Backward {
      backward
    } else {
      max(forward, backward)
    }
  }
}
