-- Approximate ports of Vixen 3 effects, for shows converted from Vixen.
-- Parameters keep Vixen's names and scales, so a Vixen effect's settings carry
-- over directly; the rendering is close to Vixen's, not identical to it.
-- Source: https://github.com/VixenLights/Vixen/tree/3.13u2/src/Vixen.Modules/Effect
--
-- Curves use positions 0..1 and Vixen's percentage values 0..100; an empty
-- curve reads as 100. Gradients and curves must be supplied. `colors` and
-- `levels` pair by index, and a shorter `levels` array reuses its last curve.
-- Pixel effects work on a grid of one cell per `pixel_size` layout units over
-- the target's bounds. Pinwheel, Fireworks and Spirograph move a fixed amount
-- per Vixen frame, so they take the source show's `frame_interval_ms`.
--
-- Adapted from Vixen. Copyright 2023 Vixen Team.
-- Redistribution and use in source and binary forms, with or without
-- modification, are permitted provided that the following conditions are met:
-- * Redistributions of source code must retain the above copyright notice,
--   this list of conditions and the following disclaimer.
-- * Redistributions in binary form must reproduce the above copyright notice,
--   this list of conditions and the following disclaimer in the documentation
--   and/or other materials provided with the distribution.
-- THIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS "AS IS"
-- AND ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE
-- IMPLIED WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE
-- ARE DISCLAIMED. IN NO EVENT SHALL THE COPYRIGHT OWNER OR CONTRIBUTORS BE
-- LIABLE FOR ANY DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR
-- CONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF
-- SUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA, OR PROFITS; OR BUSINESS
-- INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY, WHETHER IN
-- CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE)
-- ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF THE
-- POSSIBILITY OF SUCH DAMAGE.

-- The grid's width and height in cells, and the pixel's cell, y = 0 at the bottom.
fn grid_w(size: float) -> float { floor((target.max_x - target.min_x) / size) + 1.0 }
fn grid_h(size: float) -> float { floor((target.max_y - target.min_y) / size) + 1.0 }
fn grid_x(size: float) -> float { floor((pixel.x - target.min_x) / size) }
fn grid_y(size: float) -> float { floor((pixel.y - target.min_y) / size) }

-- Vixen's Strings layout: string_count strings of string_length consecutive
-- pixels, x the string and y the pixel along it (Horizontal swaps them).
-- Locations uses the layout grid.
fn string_w(strings: bool, across: bool, count: float, length: float, size: float) -> float {
  if !strings { grid_w(size) } else if across { length } else { count }
}
fn string_h(strings: bool, across: bool, count: float, length: float, size: float) -> float {
  if !strings { grid_h(size) } else if across { count } else { length }
}
fn string_x(strings: bool, across: bool, length: int, size: float) -> float {
  if !strings { grid_x(size) } else if across { pixel.index % length } else { pixel.index // length }
}
fn string_y(strings: bool, across: bool, length: int, size: float) -> float {
  if !strings { grid_y(size) } else if across { pixel.index // length } else { pixel.index % length }
}

-- BASIC: Set Level.
effect VixenSetLevel {
  param light_color: color = #ffffff;
  param intensity: float in 0.0..100.0 = 100.0;

  sample { light_color * (intensity / 100.0) }
}

-- BASIC: Pulse.
effect VixenPulse {
  param color_gradient: gradient;
  param intensity_curve: curve in 0.0..100.0;

  sample { color_gradient[progress] * (value_or(intensity_curve[progress], 100.0) / 100.0) }
}

-- BASIC: Alternating, interval or static, over groups of consecutive pixels.
effect VixenAlternating {
  param colors: array<gradient>;
  param levels: array<curve> in 0.0..100.0;
  param interval_ms: float in 2.0..60000.0 = 500.0;
  param enable_static: bool = false;
  param group_level: int in 1..1000 = 1;
  param interval_skip_count: int in 0..1000 = 1;

  sample {
    let interval = if enable_static { duration * 1000.0 } else { interval_ms };
    let cycle = floor(time * 1000.0 / interval);
    let local = time * 1000.0 / interval - cycle;
    let i = int((pixel.index // group_level + cycle * interval_skip_count) % len(colors));
    colors[i][local] * (value_or(levels[i][local], 100.0) / 100.0)
  }
}

-- BASIC: Strobe, time-interval mode with a 50% duty cycle.
effect VixenStrobe {
  param colors: gradient;
  param intensity_curve: curve in 0.0..100.0;
  param cycle_time_ms: float in 3.0..60000.0 = 150.0;

  sample {
    let local = (time * 1000.0) % cycle_time_ms / (cycle_time_ms * 0.5);
    guard local < 1.0;
    colors[local] * (value_or(intensity_curve[local], 100.0) / 100.0)
  }
}

-- BASIC: Candle Flicker. Each group of group_level pixels holds a random level
-- for each flicker, dipping from max_level by up to twice change_percentage and
-- never below min_level; groups flicker out of step.
effect VixenCandle {
  param light_color: color = #ffa500;
  param flicker_frequency: float in 1.0..100.0 = 20.0;
  param change_percentage: float in 0.0..1.0 = 0.2;
  param min_level: float in 0.0..1.0 = 0.1;
  param max_level: float in 0.0..1.0 = 1.0;
  param group_level: int in 1..1000 = 1;
  param random_seed: float in 0.0..1000000.0 = 0.0;

  sample {
    let key = rand(random_seed * 31.0 + pixel.index // group_level);
    let flicker = floor(time * flicker_frequency + key);
    light_color * clamp(max_level * (1.0 - 2.0 * change_percentage * rand(key + flicker)), min_level, max_level)
  }
}

-- BASIC: Chase over ordered pixels. Pulse overlap is in milliseconds.
effect VixenChase {
  param color_gradient: gradient;
  param pulse_curve: curve in 0.0..100.0;
  param static_color: color = #ffffff;
  param color_handling: enum { SingleColor, GradientPerPulse, GradientThroughEffect, GradientAcrossItems } = SingleColor;
  param pulse_overlap_ms: float in 0.0..600000.0 = 0.0;
  param enable_default_level: bool = false;
  param default_level: float in 0.0..100.0 = 0.0;
  param extend_pulse_to_start: bool = false;
  param extend_pulse_to_end: bool = false;

  sample {
    let count: float = target.count;
    let chase_time = max(1.0, duration * 1000.0 - pulse_overlap_ms);
    let start = pixel.index / count * chase_time;
    let local = (time * 1000.0 - start) / (chase_time / count + pulse_overlap_ms);
    let position =
      if color_handling == GradientAcrossItems { pixel.index / count }
      else if color_handling == GradientThroughEffect { progress }
      else { local };
    let base = if color_handling == SingleColor { static_color } else { color_gradient[position] };
    let baseline = if enable_default_level { base * (default_level / 100.0) } else { rgb(0.0, 0.0, 0.0) };
    let active = (local >= 0.0 || extend_pulse_to_start) && (local <= 1.0 || extend_pulse_to_end);
    if active { max(baseline, base * (value_or(pulse_curve[local], 100.0) / 100.0)) } else { baseline }
  }
}

-- BASIC: Spin over ordered pixels, by revolution count, frequency or time.
effect VixenSpin {
  param color_gradient: gradient;
  param pulse_curve: curve in 0.0..100.0;
  param static_color: color = #ffffff;
  param color_handling: enum { SingleColor, GradientPerPulse, GradientThroughEffect, GradientAcrossItems } = SingleColor;
  param speed_format: enum { RevolutionCount, RevolutionFrequency, FixedTime } = RevolutionCount;
  param pulse_length_format: enum { DistributeEvenly, PercentRevolution, PulseTime } = DistributeEvenly;
  param revolutions: float in 0.01..1000.0 = 3.0;
  param frequency_hz: float in 0.01..1000.0 = 2.0;
  param revolution_time_ms: float in 1.0..600000.0 = 500.0;
  param pulse_time_ms: float in 0.0..600000.0 = 100.0;
  param pulse_percentage: float in 0.0..100.0 = 10.0;
  param reverse_spin: bool = false;
  param enable_default_level: bool = false;
  param default_level: float in 0.0..100.0 = 0.0;

  sample {
    let count: float = target.count;
    let revolution_ms =
      if speed_format == FixedTime { revolution_time_ms }
      else if speed_format == RevolutionFrequency { 1000.0 / frequency_hz }
      else { duration * 1000.0 / revolutions };
    let pulse_ms =
      if pulse_length_format == PulseTime { pulse_time_ms }
      else if pulse_length_format == PercentRevolution { revolution_ms * pulse_percentage / 100.0 }
      else { revolution_ms / count };
    guard pulse_ms > 0.0;
    let item = if reverse_spin { count - pixel.index - 1.0 } else { pixel.index };
    let base = if color_handling == SingleColor { static_color } else { color_gradient[pixel.index / count] };
    let baseline = if enable_default_level { base * (default_level / 100.0) } else { rgb(0.0, 0.0, 0.0) };
    -- The latest pulse to reach this pixel, and the ones before it a long pulse still covers.
    let now = time * 1000.0;
    let latest = floor(now / revolution_ms - item / count);
    let pulses = max for back in 0..int(min(100.0, ceil(pulse_ms / revolution_ms))) {
      let local = (now - (latest - back + item / count) * revolution_ms) / pulse_ms;
      guard latest - back >= 0.0 && local <= 1.0;
      let position =
        if color_handling == GradientPerPulse { local }
        else if color_handling == GradientThroughEffect { progress }
        else { pixel.index / count };
      let c = if color_handling == SingleColor { static_color } else { color_gradient[position] };
      c * (value_or(pulse_curve[local], 100.0) / 100.0)
    };
    max(baseline, pulses)
  }
}

-- BASIC: Wipe, horizontal or vertical, by pass count.
effect VixenWipe {
  param color_gradient: gradient;
  param pulse_curve: curve in 0.0..100.0;
  param direction: enum { Horizontal, Vertical } = Horizontal;
  param color_handling: enum { GradientThroughEffect, ColorAcrossItems } = GradientThroughEffect;
  param pass_count: int in 1..100 = 1;
  param pulse_percent: float in 0.01..100.0 = 33.0;
  param reverse_direction: bool = false;
  param wipe_on: bool = false;
  param wipe_off: bool = false;

  sample {
    let across =
      if direction == Vertical { (pixel.y - target.min_y) / (target.max_y - target.min_y) }
      else { (pixel.x - target.min_x) / (target.max_x - target.min_x) };
    let across = if reverse_direction { 1.0 - across } else { across };
    let pass_time = duration / pass_count;
    let pulse = pass_time * pulse_percent / 100.0;
    let pass = floor(time / pass_time);
    let local = (time - pass * pass_time - across * (pass_time - pulse)) / pulse;
    guard (local >= 0.0 && local <= 1.0)
      || (wipe_off && pass == 0.0 && local < 0.0)
      || (wipe_on && pass >= pass_count - 1 && local > 1.0);
    let position = if color_handling == ColorAcrossItems { across } else { local };
    color_gradient[position] * (value_or(pulse_curve[clamp(local, 0.0, 1.0)], 100.0) / 100.0)
  }
}

-- BASIC: Twinkle. Each element's time is cut into slots of the mean gap,
-- and each slot holds one triangular twinkle at a random offset.
effect VixenTwinkle {
  param color_handling: enum { SingleColor, GradientThroughEffect, GradientPerPulse, GradientAcrossItems } = GradientPerPulse;
  param static_color: color = #ffffff;
  param color_gradient: gradient;
  param minimum_level: float in 0.0..100.0 = 0.0;
  param maximum_level: float in 0.0..100.0 = 100.0;
  param average_pulse_time_ms: int in 1..60000 = 400;
  param pulse_time_variation: int in 0..100 = 30;
  param average_coverage: int in 0..100 = 50;
  param individual_elements: bool = true;
  param random_seed: float in 0.0..1000000.0 = 0.0;

  sample {
    let element = if individual_elements { pixel.index } else { 0 };
    let key = rand(random_seed * 31.0 + element);
    -- Vixen's mean gap between twinkles is pulse / coverage / 2.
    let slot_ms = average_pulse_time_ms / (max(1, average_coverage) / 100.0) / 2.0;
    let now = time * 1000.0 + key * slot_ms;
    let slot = floor(now / slot_ms);
    let length = min(slot_ms, average_pulse_time_ms * (1.0 + (rand(key + slot) * 2.0 - 1.0) * pulse_time_variation / 100.0));
    let x = (now - slot * slot_ms - rand(key + slot + 0.5) * (slot_ms - length)) / length;
    let across = color_gradient[pixel.index / target.count];
    let c =
      if color_handling == SingleColor { static_color }
      else if color_handling == GradientPerPulse { color_gradient[clamp(x, 0.0, 1.0)] }
      else if color_handling == GradientThroughEffect { color_gradient[progress] }
      else { across };
    let lit = x >= 0.0 && x <= 1.0;
    let triangle = if lit { 1.0 - abs(2.0 * x - 1.0) } else { 0.0 };
    c * ((minimum_level + (maximum_level - minimum_level) * triangle) / 100.0)
  }
}

-- BASIC: Dissolve over groups of group_level consecutive pixels. A group is lit
-- while the density curve is above its rank, so groups go out in random (or
-- pixel) order as the default 100 -> 0 curve falls, each fading through the
-- level curve on its way out.
effect VixenDissolve {
  param colors: array<gradient>;
  param levels: array<curve> in 0.0..100.0;
  param dissolve_curve: curve in 0.0..100.0;
  param group_level: int in 1..50000 = 1;
  param random_dissolve: bool = true;
  param dissolve_flip: bool = true;
  param random_color: bool = true;
  param random_seed: float in 0.0..1000000.0 = 0.0;

  sample {
    let group = pixel.index // group_level;
    let groups: float = (target.count + group_level - 1) // group_level;
    let order = (group + 0.5) / groups;
    let rank = if random_dissolve { rand(random_seed * 31.0 + group) } else if dissolve_flip { order } else { 1.0 - order };
    let density = value_or(dissolve_curve[progress], 100.0) / 100.0;
    guard density > rank;
    -- Each group runs the level curve over its own life: 0 at full density, 1
    -- when the density falls to its rank and it goes out.
    let life = 1.0 - (density - rank) / (1.0 - rank);
    let i = if random_color { int(rand(random_seed * 31.0 + group + 0.5) * len(colors)) } else { group % len(colors) };
    colors[i][progress] * (value_or(levels[i][life], 100.0) / 100.0)
  }
}

-- PIXEL: Pinwheel, both motion modes, all blade and color types.
effect VixenPinwheel {
  param colors: array<gradient>;
  param levels: array<curve> in 0.0..100.0;
  param color_type: enum { Standard, Gradient, Random, Rainbow } = Standard;
  param motion: enum { Iterations, Speed } = Iterations;
  param arms: int in 1..20 = 8;
  param movement: float in 0.0..100.0 = 5.0;
  param thickness: float in 0.0..100.0 = 15.0;
  param size: float in 0.0..100.0 = 23.0;
  param twist: float in 0.0..100.0 = 56.0;
  param rotation: float in 0.0..100.0 = 100.0;
  param x_offset: float in 0.0..100.0 = 50.0;
  param y_offset: float in 0.0..100.0 = 50.0;
  param center_hub: float in 0.0..100.0 = 0.0;
  param offset_percentage: bool = true;
  param size_scale_basis: enum { LargestDimension, Height, Width } = LargestDimension;
  param blade_type: enum { Flat, ThreeD, InvertedThreeD, Fan } = Flat;
  param intensity: float in 0.0..100.0 = 100.0;
  param random_seed: float in 0.0..1000000.0 = 0.0;
  param pixel_size: float in 0.001..1000.0 = 1.0;
  param frame_interval_ms: float in 1.0..1000.0 = 50.0;

  sample {
    let w = grid_w(pixel_size);
    let h = grid_h(pixel_size);
    let ox = x_offset * 2.0 - 100.0;
    let oy = y_offset * 2.0 - 100.0;
    let cx = floor(w / 2.0) + round(if offset_percentage { ox * w / 100.0 } else { ox });
    let cy = floor(h / 2.0) + round(if offset_percentage { -oy * h / 100.0 } else { oy });
    let dx = grid_x(pixel_size) - cx;
    let dy = grid_y(pixel_size) - cy;
    let radius = sqrt(dx * dx + dy * dy);
    let basis =
      if !offset_percentage { sqrt((w - cx) * (w - cx) + (h - cy) * (h - cy)) }
      else if size_scale_basis == Width { w }
      else if size_scale_basis == Height { h }
      else { max(w, h) };
    let max_radius = basis * (1.0 + size * 3.99) / 100.0;
    guard radius <= max_radius && radius > center_hub * max_radius / 100.0;
    let angle = (270.0 - atan2(-dy, -dx) * 57.29577951308232) % 360.0;
    let separation = 360.0 / arms;
    let half_angle = max(1.0, round(thickness)) * separation / 200.0;
    -- Vixen turns by a speed per frame, so the frame interval sets the pace.
    let speed = max(1.0, (1.0 + movement * 0.49) * frame_interval_ms / 50.0);
    let turned =
      if motion == Speed { time * 1000.0 / frame_interval_ms * speed }
      else { progress * speed * 360.0 };
    let turned = turned * (rotation / 50.0 - 1.0);
    let twist_angle = radius / max_radius * (twist * 10.0 - 500.0);
    -- The nearest arm owns the pixel.
    let offset = (angle - twist_angle + turned) / separation - 2.0;
    let arm = round(offset);
    let difference = abs(offset - arm) * separation;
    guard difference <= half_angle;
    let index = int(arm % arms) % len(colors);
    let color_position = if color_type == Gradient { radius / max_radius } else { progress };
    let level = value_or(levels[index][color_position], 100.0) * intensity / 10000.0;
    let leading = if rotation < 50.0 { offset > arm } else { offset < arm };
    let level =
      if blade_type == ThreeD { level * (1.0 - difference / half_angle) }
      else if blade_type == InvertedThreeD { level * difference / half_angle }
      else if blade_type == Fan { level * (if leading { half_angle + difference } else { half_angle - difference }) / (2.0 * half_angle) }
      else { level };
    if color_type == Random { hsv(rand(random_seed * 31.0 + index), 1.0, level) }
    else if color_type == Rainbow { hsv(rand(random_seed * 31.0 + arm * 7.0 + floor(time * 1000.0 / frame_interval_ms)), 1.0, level) }
    else { colors[index][color_position] * level }
  }
}

-- PIXEL: Butterfly, five formulas, iteration or speed motion.
effect VixenButterfly {
  param color_gradient: gradient;
  param butterfly_type: enum { Type1, Type2, Type3, Type4, Type5 } = Type1;
  param color_scheme: enum { Gradient, Rainbow } = Gradient;
  param motion: enum { Iterations, Speed } = Iterations;
  param direction: enum { Forward, Backward } = Forward;
  param iterations: int in 1..100 = 2;
  param speed: float in 0.0..100.0 = 60.0;
  param repeat: int in 1..100 = 1;
  param background_chunks: int in 1..100 = 1;
  param background_skips: int in 1..100 = 2;
  param use_base_color: bool = false;
  param base_color: color = #000000;
  param intensity: float in 0.0..100.0 = 100.0;
  param pixel_size: float in 0.001..1000.0 = 1.0;

  sample {
    let w = grid_w(pixel_size);
    let h = grid_h(pixel_size);
    let x = grid_x(pixel_size);
    let y = h - 1.0 - grid_y(pixel_size);
    let repetitions: float =
      if butterfly_type == Type4 { repeat * 6.0 }
      else if butterfly_type == Type1 || butterfly_type == Type5 { repeat * 3.0 }
      else { repeat };
    -- Speed maps 0..100 to -80..80; a negative speed runs backward.
    let travel = time * (speed * 1.6 - 80.0) / 10.0;
    let position = if motion == Speed { abs(travel) % 1.0 } else { (progress * iterations) % 1.0 };
    let state = position * repetitions;
    let backward = if motion == Speed { travel < 0.0 } else { direction == Backward };
    let offset = if backward { state } else { -state };
    let value =
      if butterfly_type == Type2 || butterfly_type == Type3 {
        let frame = floor(h * state) % h;
        let f = if frame < floor(h / 2.0) { frame + 1.0 } else { h - frame };
        let f = if butterfly_type == Type3 { f * 0.1 + h / 60.0 } else { f };
        let xx = (x - w / 2.0) / f;
        let yy = (y - h / 2.0) / f;
        if butterfly_type == Type3 { sin(xx) * cos(yy) } else { sqrt(xx * xx + yy * yy) }
      } else {
        let dimension = if butterfly_type == Type5 { w * h } else { w + h };
        let n = (x * x - y * y) * sin(offset + (x + y) * TAU / dimension);
        let d = x * x + y * y;
        let value = n / d;
        if butterfly_type == Type4 { value - floor(value) } else { abs(value) }
      };
    guard !(background_chunks > 1 && int(value * background_chunks) % background_skips == 0)
      else if use_base_color { base_color } else { rgb(0.0, 0.0, 0.0) };
    let level = intensity / 100.0;
    if color_scheme == Rainbow { hsv(value, 1.0, level) } else { color_gradient[value] * level }
  }
}

-- PIXEL: Colorwash, iteration mode, center/outer/invert fades and shimmer.
effect VixenColorwash {
  param color_gradient: gradient;
  param wash_type: enum { Center, Outer, Invert } = Center;
  param iterations: int in 1..100 = 1;
  param horizontal_fade: bool = false;
  param vertical_fade: bool = false;
  param shimmer: bool = false;
  param intensity: float in 0.0..100.0 = 100.0;
  param pixel_size: float in 0.001..1000.0 = 1.0;

  sample {
    -- Shimmer blanks every other 50 ms frame.
    guard !(shimmer && floor(time * 20.0) % 2.0 != 0.0);
    let c = color_gradient[(progress * iterations) % 1.0];
    let half_w = (grid_w(pixel_size) - 1.0) / 2.0;
    let half_h = (grid_h(pixel_size) - 1.0) / 2.0;
    let fade_x = if horizontal_fade && half_w > 0.0 { abs(half_w - grid_x(pixel_size)) / half_w } else { -1.0 };
    let fade_y = if vertical_fade && half_h > 0.0 { abs(half_h - grid_y(pixel_size)) / half_h } else { -1.0 };
    let v = intensity(c) * intensity / 100.0;
    let v = if fade_x < 0.0 { v } else if wash_type == Center { v * (1.0 - fade_x) } else if wash_type == Outer { v * fade_x } else { v / (1.0 - fade_x) };
    let v = if fade_y < 0.0 { v } else if wash_type == Center { v * (1.0 - fade_y) } else if wash_type == Outer { v * fade_y } else { v / (1.0 - fade_y) };
    hsv(hue(c), saturation(c), v)
  }
}

-- PIXEL: Plasma, the seven-term formula with gradient or preset colors.
effect VixenPlasma {
  param colors: array<gradient>;
  param color_type: enum { Normal, Preset1, Preset2, Preset3, Preset4 } = Normal;
  param plasma_style: int in 1..10 = 1;
  param speed: float in 0.0..100.0 = 10.0;
  param line_density: float in 0.0..100.0 = 10.0;
  param intensity: float in 0.0..100.0 = 100.0;
  param pixel_size: float in 0.001..1000.0 = 1.0;

  sample {
    let w = grid_w(pixel_size);
    let h = grid_h(pixel_size);
    let x = grid_x(pixel_size) / w;
    let y = (h - 1.0 - grid_y(pixel_size)) / h;
    let t = (progress * 100.0 * speed + 1.0) / ((101.0 - speed) * 3.0);
    let cx = x + 0.5 * sin(t / 5.0);
    let cy = y + 0.5 * cos(t / 3.0);
    let v = sin(x * 10.0 + t)
      + sin(10.0 * (x * sin(t / 2.0) + y * cos(t / 3.0)) + t)
      + sin(sqrt(plasma_style * 50.0 * (cx * cx + cy * cy) + t))
      + sin(x + t) + sin((y + t) / 2.0) + sin((x + y + t) / 2.0);
    let v = (v + sin(sqrt(x * x + y * y) + t)) / 2.0;
    let phase = v * (1.0 + line_density * 0.09) * PI;
    let result =
      if color_type == Normal {
        let n = clamp((sin(phase + 2.0943951) + 0.5) / 2.0, 0.0, 0.99999) * len(colors);
        let i = int(n);
        mix(colors[i][progress], colors[(i + 1) % len(colors)][progress], n - i)
      } else {
        let r = (sin(phase) + 1.0) / 2.0;
        if color_type == Preset1 { rgb(r, (cos(phase) + 1.0) / 2.0, 0.0) }
        else if color_type == Preset2 { rgb(0.0, (cos(phase) + 1.0) / 2.0, r) }
        else if color_type == Preset3 { rgb(r, (sin(phase + 2.0943951) + 1.0) / 2.0, (sin(phase + 4.1887902) + 1.0) / 2.0) }
        else { rgb(r, r, r) }
      };
    result * (intensity / 100.0)
  }
}

-- PIXEL: Bars, iteration motion in every direction, highlight and 3D.
effect VixenBars {
  param colors: array<gradient>;
  param direction: enum { Up, Down, Left, Right, Expand, Compress, HorizontalExpand, HorizontalCompress, AlternateUp, AlternateDown, AlternateLeft, AlternateRight } = Up;
  param iterations: int in 1..100 = 1;
  param repeat: int in 1..100 = 1;
  param highlight: bool = false;
  param show_3d: bool = false;
  param intensity: float in 0.0..100.0 = 100.0;
  param pixel_size: float in 0.001..1000.0 = 1.0;

  sample {
    let w = grid_w(pixel_size);
    let h = grid_h(pixel_size);
    let x = grid_x(pixel_size);
    let y = h - 1.0 - grid_y(pixel_size);
    let horizontal =
      direction == Left || direction == Right || direction == AlternateLeft || direction == AlternateRight
      || direction == HorizontalExpand || direction == HorizontalCompress;
    let length = if horizontal { w } else { h };
    let coordinate =
      if direction == Right || direction == AlternateRight { x }
      else if direction == HorizontalExpand { min(x, w - x - 1.0) }
      else if direction == HorizontalCompress { max(x, w - x - 1.0) }
      else if horizontal { w - x - 1.0 }
      else if direction == Down || direction == AlternateDown { y }
      else if direction == Expand { min(y, h - y - 1.0) }
      else if direction == Compress { max(y, h - y - 1.0) }
      else { h - y - 1.0 };
    let count: float = len(colors) * repeat;
    let bar_size = floor(length / count) + 1.0;
    let position = (progress * iterations) % 1.0;
    let alternate =
      direction == AlternateUp || direction == AlternateDown || direction == AlternateLeft || direction == AlternateRight;
    -- Alternate modes jump a whole bar at a time.
    let offset = if alternate { floor(position * count) * bar_size } else { floor(position * count * bar_size) };
    let n = coordinate + offset + 1.0;
    let within = n % bar_size;
    let result = colors[int((n % (len(colors) * bar_size)) / bar_size)][within / bar_size];
    let s = if highlight && within == 0.0 { 0.0 } else { saturation(result) };
    let v = if show_3d { intensity(result) * (bar_size - within - 1.0) / bar_size } else { intensity(result) };
    hsv(hue(result), s, v * intensity / 100.0)
  }
}

-- PIXEL: Border, simple or advanced with shared or independent edges.
effect VixenBorder {
  param color_gradient: gradient;
  param border_mode: enum { Simple, Advanced } = Simple;
  param border_type: enum { Single, Independent } = Single;
  param gradient_mode: enum { OverTime, Across, Vertical, DiagonalTopBottom, DiagonalBottomTop } = OverTime;
  param simple_border_width: int in 0..1000 = 1;
  param thickness: float in 0.0..100.0 = 20.0;
  param top_thickness: float in 0.0..100.0 = 10.0;
  param bottom_thickness: float in 0.0..100.0 = 10.0;
  param left_thickness: float in 0.0..100.0 = 10.0;
  param right_thickness: float in 0.0..100.0 = 10.0;
  param border_size: float in 0.0..100.0 = 100.0;
  param border_height: float in 0.0..100.0 = 100.0;
  param x_offset: float in 0.0..100.0 = 50.0;
  param y_offset: float in 0.0..100.0 = 50.0;
  param intensity: float in 0.0..100.0 = 100.0;
  param pixel_size: float in 0.001..1000.0 = 1.0;

  sample {
    let w = grid_w(pixel_size);
    let h = grid_h(pixel_size);
    let simple = border_mode == Simple;
    let inset_x = if simple { 0.0 } else { floor((100.0 - border_size) * w / 200.0) };
    let inset_y = if simple { 0.0 } else { floor((100.0 - border_height) * h / 200.0) };
    let shift_x = if simple { 0.0 } else { round((x_offset * 2.0 - 100.0) * (w - inset_x) / 100.0) };
    let shift_y = if simple { 0.0 } else { round((y_offset * 2.0 - 100.0) * (h - inset_y) / 100.0) };
    let x = grid_x(pixel_size) - shift_x;
    let y = h - 1.0 - grid_y(pixel_size) - shift_y;
    guard x >= inset_x && x < w - inset_x && y >= inset_y && y < h - inset_y;
    let shared: float = if simple { simple_border_width } else { round((2.0 + thickness * (min(w, h) - 2.0) / 100.0) / 2.0) };
    let independent = !simple && border_type == Independent;
    let top = if independent { floor(top_thickness * h / 100.0) } else { shared };
    let bottom = if independent { floor(bottom_thickness * h / 100.0) } else { shared };
    let left = if independent { floor(left_thickness * w / 100.0) } else { shared };
    let right = if independent { floor(right_thickness * w / 100.0) } else { shared };
    guard x < inset_x + left || x >= w - inset_x - right || y < inset_y + bottom || y >= h - inset_y - top;
    let position =
      if gradient_mode == Across { x / w }
      else if gradient_mode == Vertical { (h - y) / h }
      else if gradient_mode == DiagonalTopBottom { ((h - y) / h + x / w) / 2.0 }
      else if gradient_mode == DiagonalBottomTop { (y / h + x / w) / 2.0 }
      else { progress };
    color_gradient[position] * (intensity / 100.0)
  }
}

-- PIXEL: Spiral, iteration motion, all directions, growth/shrink, blend and 3D.
effect VixenSpiral {
  param colors: array<gradient>;
  param direction: enum { Forward, Backwards, None } = Forward;
  param iterations: float in 0.0..100.0 = 1.0;
  param repeat: int in 1..100 = 1;
  param rotation: float in 0.0..100.0 = 57.0;
  param thickness: float in 0.0..100.0 = 60.0;
  param grow: bool = false;
  param shrink: bool = false;
  param blend: bool = false;
  param show_3d: bool = false;
  param intensity: float in 0.0..100.0 = 100.0;
  param pixel_size: float in 0.001..1000.0 = 1.0;

  sample {
    let w = grid_w(pixel_size);
    let h = grid_h(pixel_size);
    let x = grid_x(pixel_size);
    let y = h - 1.0 - grid_y(pixel_size);
    let count = len(colors) * repeat;
    let delta = max(1.0, floor(w / count));
    let thick = floor(delta * (1.0 + thickness * 0.99) / 100.0) + 1.0;
    let gap = delta - thick;
    let position = (progress * iterations) % 1.0;
    let growth =
      if grow && shrink { gap * 2.0 * min(position, 1.0 - position) }
      else if grow { gap * position }
      else if shrink { gap * (1.0 - position) }
      else { 0.0 };
    let thick = thick + floor(growth);
    let shift = if direction == None { 0.0 } else if direction == Backwards { -floor(position * w) } else { floor(position * w) };
    let strand = (x - shift - floor(y * (rotation * 3.0 - 150.0) / h)) % w;
    -- The strand starting at or before this cell owns it.
    let index = floor(strand / delta);
    let within = strand - index * delta;
    guard within < thick && index < count;
    let color_position = if blend { (h - y - 1.0) / h } else { within / thick };
    let c = colors[int(index) % len(colors)][color_position];
    let v =
      if show_3d { if direction == Backwards { (thick - within) / thick } else { (within + 1.0) / thick } }
      else { intensity(c) };
    hsv(hue(c), saturation(c), v * intensity / 100.0)
  }
}

-- PIXEL: Circular Shockwave. Radius default 0 -> 100; width 2 -> 4.
effect VixenShockwave {
  param color_gradient: gradient;
  param radius_curve: curve in 0.0..100.0;
  param width_curve: curve in 0.0..100.0;
  param center_x: float in 0.0..100.0 = 50.0;
  param center_y: float in 0.0..100.0 = 50.0;
  param acceleration: enum { Linear, GentleIn, GentleOut, StrongOut } = GentleIn;
  param blend_edges: bool = true;
  param scaled_radius: bool = true;
  param pixel_size: float in 0.001..1000.0 = 1.0;

  sample {
    let w = grid_w(pixel_size);
    let h = grid_h(pixel_size);
    let dx = grid_x(pixel_size) - floor(w * center_x / 100.0);
    let dy = grid_y(pixel_size) - floor(h * (100.0 - center_y) / 100.0);
    let t = progress;
    let eased =
      if acceleration == GentleIn { t * sqrt(t) }
      else if acceleration == GentleOut { 1.0 - (1.0 - t) * sqrt(1.0 - t) }
      else if acceleration == StrongOut { 1.0 - pow(1.0 - t, 5) }
      else { t };
    let scale = if scaled_radius { max(w, h) } else { 750.0 };
    let radius = value_or(radius_curve[eased], 100.0) * scale / 100.0;
    let half_width = value_or(width_curve[eased], 100.0) * 1.275;
    let distance = abs(sqrt(dx * dx + dy * dy) - radius);
    guard distance <= half_width;
    color_gradient[t] * (if blend_edges { 1.0 - distance / half_width } else { 1.0 })
  }
}

-- PIXEL: Garlands, five patterns and four directions, iteration mode. Rings
-- drop one at a time and stack from the far edge.
effect VixenGarlands {
  param colors: array<gradient>;
  param direction: enum { Up, Down, Left, Right } = Up;
  param garland_type: enum { Type0, Type1, Type2, Type3, Type4 } = Type0;
  param iterations: int in 1..100 = 1;
  param spacing: float in 0.0..100.0 = 10.0;
  param intensity: float in 0.0..100.0 = 100.0;
  param pixel_size: float in 0.001..1000.0 = 1.0;

  sample {
    let w = grid_w(pixel_size);
    let h = grid_h(pixel_size);
    let x = grid_x(pixel_size);
    let y = h - 1.0 - grid_y(pixel_size);
    let sideways = direction == Left || direction == Right;
    let height = if sideways { w } else { h };
    let across = if sideways { y } else { x };
    let row =
      if direction == Left { w - x - 1.0 }
      else if direction == Right { x }
      else if direction == Down { h - y - 1.0 }
      else { y };
    let separation = floor(round(1.0 + spacing * 0.19) * h / 100.0) + 3.0;
    let m = across % 5.0;
    let sag =
      if garland_type == Type1 { if m == 2.0 { 2.0 } else if m == 1.0 || m == 3.0 { 1.0 } else { 0.0 } }
      else if garland_type == Type2 { if m == 2.0 { 4.0 } else if m == 1.0 || m == 3.0 { 2.0 } else { 0.0 } }
      else if garland_type == Type3 { 2.0 * min(across % 6.0, 6.0 - across % 6.0) }
      else if garland_type == Type4 && (m == 1.0 || m == 3.0) { 2.0 }
      else { 0.0 };
    -- `state` sweeps the ring stack down through the rows each iteration.
    let state = floor((1.0 - (progress * iterations) % 1.0) * height * separation);
    let free_ring = (state - sag - row) / separation;
    let ring = if free_ring == floor(free_ring) && free_ring >= 0.0 && row >= height - free_ring - 1.0 { free_ring } else { -1.0 };
    let settled = height - row - 1.0;
    let ring = if settled >= 0.0 && state - settled * separation - sag <= row { max(ring, settled) } else { ring };
    guard ring >= 0.0;
    let color_position = ring / height * (len(colors) - 1);
    let i = int(color_position);
    mix(colors[i][progress], colors[(i + 1) % len(colors)][progress], color_position - i) * (intensity / 100.0)
  }
}

-- PIXEL: Curtain, open/close from six edges with swag. Default position curve
-- 100 -> 0 -> 100; intensity curve flat 100.
effect VixenCurtain {
  param color_gradient: gradient;
  param position_curve: curve in 0.0..100.0;
  param intensity_curve: curve in 0.0..100.0;
  param direction: enum { Open, Close } = Open;
  param edge: enum { Left, Center, Right, Bottom, Middle, Top } = Center;
  param iterations: int in 1..100 = 1;
  param swag: int in 0..100 = 1;
  param intensity_per_iteration: bool = false;
  param pixel_size: float in 0.001..1000.0 = 1.0;

  sample {
    let phase = (progress * iterations) % 1.0;
    let position = 1.0 - value_or(position_curve[phase], 100.0) / 100.0;
    let level = value_or(intensity_curve[if intensity_per_iteration { phase } else { progress }], 100.0) / 100.0;
    let w = grid_w(pixel_size);
    let h = grid_h(pixel_size);
    let vertical = edge == Bottom || edge == Middle || edge == Top;
    let paired = edge == Center || edge == Middle;
    let length = if vertical { h } else { w };
    let cross_length = if vertical { w } else { h };
    let coordinate = if vertical { grid_y(pixel_size) } else { grid_x(pixel_size) };
    let cross = if vertical { grid_x(pixel_size) } else { grid_y(pixel_size) };
    -- Fold a paired curtain onto one half; distance runs from the curtain's edge.
    let half = if paired { length / 2.0 } else { length };
    let distance =
      if paired { if coordinate < half { coordinate } else { length - 1.0 - coordinate } }
      else if edge == Left || edge == Top { length - 1.0 - coordinate }
      else { coordinate };
    let swag_length = if h > 1.0 { floor(swag * w / 40.0) } else { 0.0 };
    let covered_length = (position * length + swag_length * position * 2.0) / (if paired { 2.0 } else { 1.0 });
    let covered_length = if direction == Open { half - covered_length } else { covered_length };
    -- The swag hangs past the curtain's edge, shorter farther out.
    let beyond = distance - covered_length;
    let sag = cross_length * (beyond / max(1.0, swag_length)) * (beyond / max(1.0, swag_length));
    guard beyond <= 0.0 || (beyond < swag_length && (if vertical { cross > sag } else { cross < cross_length - sag }));
    color_gradient[distance / half] * level
  }
}

-- PIXEL: Spirograph, a hypotrochoid of up to 5,400 points drawn on the grid, in
-- standard, random or rainbow colors. It searches every point for each pixel,
-- so it is expensive on large targets.
effect VixenSpirograph {
  param colors: array<gradient>;
  param color_type: enum { Standard, Random, Rainbow } = Standard;
  param outer_circle_radius: float in 0.0..100.0 = 88.0;
  param inner_circle_radius: float in 0.0..100.0 = 21.0;
  param speed: float in 0.0..100.0 = 2.0;
  param distance: float in 0.0..100.0 = 50.0;
  param color_range: float in 0.0..100.0 = 35.0;
  param spirograph_range: float in 0.0..100.0 = 33.0;
  param animate: bool = true;
  param intensity: float in 0.0..100.0 = 100.0;
  param random_seed: float in 0.0..1000000.0 = 0.0;
  param pixel_size: float in 0.001..1000.0 = 1.0;
  param frame_interval_ms: float in 1.0..1000.0 = 50.0;

  sample {
    let frame = floor(time * 1000.0 / frame_interval_ms);
    let w = grid_w(pixel_size);
    let h = grid_h(pixel_size);
    let cx = floor(w / 2.0);
    let cy = floor(h / 2.0);
    let x = grid_x(pixel_size);
    let y = h - 1.0 - grid_y(pixel_size);
    let outer = cx * outer_circle_radius / 100.0;
    let inner = min(outer, cx * inner_circle_radius / 100.0);
    guard inner > 0.0;
    let state = frame * speed;
    let d = cx * (1.0 + distance * 0.99) / 100.0;
    let d = if animate { floor(d + state / 2.0) % 100.0 } else { d };
    guard sqrt((x - cx) * (x - cx) + (y - cy) * (y - cy)) <= outer - inner + d + 0.75;
    let samples = floor((1.0 + spirograph_range * 2.99) * 18.0);
    let bin = round((1.0 + color_range * 1.99) / len(colors));
    first for ordinal in 0..int(samples) {
      let point = samples - ordinal;
      let angle = (point + round(state % 1440.0)) * 0.017453292519943295;
      let rx = round((outer - inner) * cos(angle) + d * cos((outer - inner) / inner * angle) + cx);
      let ry = round((outer - inner) * sin(angle) + d * sin((outer - inner) / inner * angle) + cy);
      guard rx == x && ry == y;
      let level = intensity / 100.0;
      let pick = rand((random_seed * 31.0 + frame) * 31.0 + point);
      if color_type == Rainbow { hsv(pick, 1.0, level) }
      else {
        let i = if color_type == Random { pick * len(colors) } else { sqrt((rx - cx) * (rx - cx) + (ry - cy) * (ry - cy)) / (1.0 + color_range * 1.99) * 100.0 / bin };
        colors[int(i)][progress] * level
      }
    }
  }
}

-- Smooth value noise in -1..1 on a lattice of unit cells.
fn value_noise(u: float, v: float, seed: float) -> float {
  let i = floor(u);
  let j = floor(v);
  let fx = smoothstep(0.0, 1.0, u - i);
  let fy = smoothstep(0.0, 1.0, v - j);
  let a = mix(rand(seed + i + j * 127.0), rand(seed + i + 1.0 + j * 127.0), fx);
  let b = mix(rand(seed + i + (j + 1.0) * 127.0), rand(seed + i + 1.0 + (j + 1.0) * 127.0), fx);
  mix(a, b, fy) * 2.0 - 1.0
}

-- PIXEL: Fire from any edge, with height and hue-shift curves. Heat falls off
-- away from the edge and rising noise breaks it into flames. Vixen defaults:
-- height flat 50, hue shift flat 0.
effect VixenFire {
  param location: enum { Bottom, Top, Left, Right } = Bottom;
  param height: curve in 0.0..100.0;
  param hue_shift: curve in 0.0..100.0;
  param intensity: float in 0.0..100.0 = 100.0;
  param random_seed: float in 0.0..1000000.0 = 0.0;
  param pixel_size: float in 0.001..1000.0 = 1.0;

  sample {
    let w = grid_w(pixel_size);
    let h = grid_h(pixel_size);
    let x = grid_x(pixel_size);
    let y = grid_y(pixel_size);
    let vertical = location == Bottom || location == Top;
    let rows = if vertical { h } else { w };
    let sx = if vertical { x } else { y };
    let sy =
      if location == Bottom { y } else if location == Top { h - 1.0 - y }
      else if location == Left { x } else { w - 1.0 - x };
    let flame = rows * max(1.0, value_or(height[progress], 100.0)) / 100.0;
    let rise = time * 20.0;
    let seed = rand(random_seed) * 4096.0;
    let noise = value_noise(sx / 2.0, (sy - rise) / 3.0, seed) * 0.6 + value_noise(sx / 5.0, (sy - rise) / 8.0, seed + 512.0) * 0.4;
    -- Heat runs 0..2: red up to 1, then toward yellow.
    let heat = (1.0 - sy / flame + noise * 0.5) * 2.0;
    guard heat > 0.01;
    let hue = max(0.0, heat - 1.0) * 0.166;
    let shift = value_or(hue_shift[progress], 100.0);
    let hue = if shift > 0.0 { min(1.0, hue + shift / 100.0) } else { hue };
    hsv(hue, 1.0, min(1.0, heat) * intensity / 100.0)
  }
}

-- PIXEL: Fireworks: random or mark-timed explosions. Each explosion throws its
-- particles out at random speeds within one ring per particle direction; they
-- fall slowly and fade out.
effect VixenFireworks {
  param colors: array<gradient>;
  param color_type: enum { Standard, Rainbow, Range, Palette, Random } = Standard;
  param source: enum { RandomExplosions, MarkCollection } = RandomExplosions;
  param explosion_marks: marks;
  param explosions: int in 0..100 = 10;
  param random_velocity: bool = false;
  param velocity: int in 0..10 = 5;
  param min_velocity: int in 0..10 = 1;
  param max_velocity: int in 0..10 = 10;
  param random_particles: bool = true;
  param particles: int in 0..100 = 40;
  param min_particles: int in 0..100 = 10;
  param max_particles: int in 0..100 = 50;
  param particle_fade: int in 0..100 = 50;
  param intensity: float in 0.0..100.0 = 100.0;
  param random_seed: float in 0.0..1000000.0 = 0.0;
  param pixel_size: float in 0.001..1000.0 = 1.0;
  param frame_interval_ms: float in 1.0..1000.0 = 50.0;

  sample {
    let frame = time * 1000.0 / frame_interval_ms;
    let frames = duration * 1000.0 / frame_interval_ms;
    let w = grid_w(pixel_size);
    let h = grid_h(pixel_size);
    let x = grid_x(pixel_size) + 0.5;
    let y = grid_y(pixel_size) + 0.5;
    let count = if source == MarkCollection { len(explosion_marks) } else { explosions };
    -- A particle fades out over particle_fade / 2 frames.
    let life = max(1.0, particle_fade / 2.0);
    guard count > 0;
    let lo =
      if source == MarkCollection { max(0, mark_last_index(explosion_marks, time - life * frame_interval_ms / 1000.0)) }
      else { max(0, int((frame - life) * count / frames) - 1) };
    let hi =
      if source == MarkCollection { mark_last_index(explosion_marks, time) }
      else { min(count - 1, int(frame * count / frames)) };
    -- Later explosions draw over earlier ones.
    last for slot in 0..min(hi - lo + 1, 100) {
      let explosion = lo + slot;
      let seed = random_seed * 31.0 + explosion * 8.0;
      let start =
        if source == MarkCollection { mark_at(explosion_marks, explosion) * 1000.0 / frame_interval_ms }
        else { (explosion + rand(seed + 1.0)) * frames / count };
      let age = frame - start;
      guard age >= 0.0 && age < life;
      let n = if random_particles { min_particles + floor(rand(seed + 4.0) * max(0, max_particles - min_particles)) } else { particles };
      let top_speed = if random_velocity { min_velocity + rand(seed + 5.0) * (max_velocity - min_velocity) } else { velocity };
      let dx = x - (w * 0.25 + rand(seed + 2.0) * w * 0.5);
      let dy = y - (h * 0.25 + rand(seed + 3.0) * h * 0.5) + 0.0004 * age * age * age / 3.0;
      -- The particle whose direction points at this cell, and its distance.
      let particle = floor((atan2(dy, dx) / TAU + 0.5) * n);
      let reach = (age + 1.0) * top_speed * rand(seed + 6.0 + particle * 0.01);
      guard n > 0 && abs(sqrt(dx * dx + dy * dy) - reach) < 0.75;
      let value = (1.0 - age / life) * intensity / 100.0;
      let pick = rand(seed + 7.0 + particle * 0.01);
      let c = colors[int(pick * len(colors))][progress];
      if color_type == Rainbow || color_type == Random { hsv(if color_type == Random { rand(seed + 5.5) } else { pick }, 1.0, value) }
      else if color_type == Range { hsv(mix(hue(colors[0][progress]), hue(colors[len(colors) - 1][progress]), pick), saturation(c), value) }
      else if color_type == Palette { hsv(hue(c), saturation(c), value) }
      else { let c = colors[int(rand(seed + 5.0) * len(colors))][progress]; hsv(hue(c), saturation(c), value) }
    }
  }
}

-- How far slot `key`'s meteors have travelled in all, in cells: Vixen's speed is
-- two cells per second per unit, varied per slot, from a random start.
fn slot_along(key: float, speed: float, variation: float, span: float) -> float {
  time * (2.0 * speed + (rand(key + 0.1) - 0.5) * 2.0 * variation) + rand(key + 0.2) * span
}

-- PIXEL: Meteors falling, or rising, in one direction on a Strings or Locations
-- grid. Paths run in lanes one cell apart across the direction, and each lane
-- launches meteors one trip after another at a random speed, so a pixel checks
-- only the lanes it touches. About `count` slots of meteors share the lanes; a
-- trip shows with the slots' share of the lanes. A meteor's tail tapers by
-- tail_taper (default 100 -> 0). Default gradients red/lime/blue.
effect VixenMeteors {
  param colors: array<gradient>;
  param tail_taper: curve in 0.0..100.0;
  param color_type: enum { Rainbow, Range, Palette, Gradient } = Palette;
  param meteor_effect: enum { Falling, Rising } = Falling;
  param direction: int in 1..360 = 180;
  param speed: float in 0.0..100.0 = 14.0;
  param speed_variation: float in 0.0..100.0 = 12.0;
  param count: float in 0.0..100.0 = 10.0;
  param tail_length: float in 0.0..100.0 = 5.0;
  param random_brightness: bool = false;
  param intensity: float in 0.0..100.0 = 100.0;
  param random_seed: float in 0.0..1000000.0 = 0.0;
  param positioning: enum { Locations, Strings } = Locations;
  param orientation: enum { Vertical, Horizontal } = Vertical;
  param string_count: int in 1..10000 = 1;
  param string_length: int in 1..10000 = 1;
  param pixel_size: float in 0.001..1000.0 = 1.0;

  sample {
    let strings = positioning == Strings;
    let across = orientation == Horizontal;
    let w = string_w(strings, across, string_count, string_length, pixel_size);
    let h = string_h(strings, across, string_count, string_length, pixel_size);
    let x = string_x(strings, across, string_length, pixel_size) + 0.5;
    let y = string_y(strings, across, string_length, pixel_size) + 0.5;
    let length = 1.0 + tail_length * 0.99;
    let tail = max(1.0, if h < 10.0 { floor(length / 10.0) } else { floor(h * length / 100.0) });
    let base = rand(random_seed);
    let span = w + h + tail;
    let degrees = if meteor_effect == Rising { direction + 180.0 } else { direction * 1.0 };
    let ux = sin(degrees * 0.017453292519943295);
    let uy = cos(degrees * 0.017453292519943295);
    -- Lanes across the direction, the slots of each, and the share of trips shown.
    let lanes = max(1.0, ceil(abs(uy) * w + abs(ux) * h));
    let slots = floor(1.0 + count * 1.99);
    let per_lane = int(clamp(ceil(slots / lanes), 1.0, slots));
    let shown = slots / (lanes * per_lane);
    let half = 0.5 * max(abs(ux), abs(uy)) + 0.5 * min(abs(ux), abs(uy));
    -- The pixel along the direction from the grid's center, and across it in lanes.
    let dx = x - w / 2.0;
    let dy = y - h / 2.0;
    let ahead = dx * ux + dy * uy;
    let side = dx * uy - dy * ux + lanes / 2.0;
    let first_lane = floor(side - half);
    let touched = floor(side + half) - first_lane;
    -- The highest covering slot as slot * 4 + its tail fraction.
    let code = last for i in 0..3 * per_lane {
      let step = i // per_lane;
      let lane = first_lane + step;
      guard step <= touched && lane >= 0.0 && lane < lanes;
      let slot = lane * per_lane + i % per_lane;
      let key = rand(base + slot);
      let along = slot_along(key, speed, speed_variation, span);
      let trip = floor(along / span);
      let trip_key = rand(key + trip);
      let behind = along - trip * span - span / 2.0 - ahead;
      guard rand(trip_key + 0.35) < shown && behind > -0.5 && behind < tail - 0.5 && abs(side - lane - 0.5) <= half;
      slot * 4.0 + clamp(behind / tail, 0.0, 0.999)
    } else { -1.0 };
    guard code >= 0.0;
    let slot = floor(code / 4.0);
    let fraction = code - slot * 4.0;
    let key = rand(base + slot);
    let trip_key = rand(key + floor(slot_along(key, speed, speed_variation, span) / span));
    let brightness = if random_brightness { 0.2 + rand(trip_key + 0.4) * 0.8 } else { 1.0 };
    let factor = brightness * value_or(tail_taper[fraction], 100.0) / 100.0 * intensity / 100.0;
    let first = colors[int(rand(trip_key + 0.5) * len(colors))];
    if color_type == Rainbow { hsv(rand(trip_key + 0.6), 1.0, factor) }
    else if color_type == Range {
      let a = first[progress];
      let b = colors[int(rand(trip_key + 0.7) * len(colors))][progress];
      hsv(mix(hue(a), hue(b), rand(trip_key + 0.8)), mix(saturation(a), saturation(b), rand(trip_key + 0.9)), factor)
    }
    else if color_type == Gradient { first[fraction] * factor }
    else { first[progress] * factor }
  }
}

-- Whether offset (dx, dy) from a flake's center is one of its points, for
-- Vixen's flake kinds 1 (one point) to 9 (45 points).
fn flake_point(kind: float, dx: float, dy: float) -> bool {
  let ax = abs(dx);
  let ay = abs(dy);
  if kind <= 1.0 { ax + ay == 0.0 }
  else if kind == 2.0 { ax == 0.0 && ay <= 1.0 }
  else if kind == 3.0 { ax + ay <= 1.0 }
  else if kind == 4.0 { (ay == 0.0 && ax <= 2.0) || (ax == 0.0 && ay <= 2.0) }
  else if kind == 5.0 { ax + ay <= 1.0 || (ax == 1.0 && ay == 2.0) || (ax == 2.0 && ay == 1.0) }
  else if kind == 6.0 { (ay == 0.0 && ax <= 3.0) || (ax == 0.0 && ay <= 3.0) }
  else if kind == 7.0 { (ay == 0.0 && ax <= 3.0) || (ax == 0.0 && ay <= 3.0) || (ax == 1.0 && ay == 1.0) }
  else if kind == 8.0 { (ax <= 1.0 && ay <= 2.0) || (ax == 2.0 && ay <= 1.0) || (ay == 0.0 && ax <= 4.0) || (ax == 0.0 && ay <= 4.0) }
  else { (ax == ay && ax <= 4.0) || (ax == 2.0 && ay == 3.0) || (ax == 3.0 && ay == 2.0) || (ax == 0.0 && ay <= 5.0) || (ay == 0.0 && ax <= 5.0) }
}

-- PIXEL: Snowflakes falling, in random directions or exploding, on a Strings or
-- Locations grid, with every flake shape and optional build-up. Flakes move like
-- VixenMeteors' slots; the outer color fills a flake and the inner one its
-- center. Build-up raises a pile in the first outer gradient. Default gradients:
-- white outer, blue inner.
effect VixenSnowflakes {
  param outer_colors: array<gradient>;
  param inner_colors: array<gradient>;
  param flake_type: enum { Random, Single, Three, Five, Nine, Thirteen, ThirteenV2, Seventeen, TwentyNine, FortyFive } = Random;
  param color_type: enum { Range, Palette, Rainbow } = Palette;
  param snowflake_effect: enum { Falling, RandomDirection, Explode } = Falling;
  param min_direction: int in 0..360 = 145;
  param max_direction: int in 0..360 = 215;
  param speed: float in 0.0..100.0 = 11.0;
  param speed_variation: float in 0.0..100.0 = 8.0;
  param count: float in 0.0..100.0 = 10.0;
  param random_brightness: bool = true;
  param snow_build_up: bool = false;
  param initial_build_up: int in 0..100 = 0;
  param build_up_speed: float in 0.0..100.0 = 15.0;
  param intensity: float in 0.0..100.0 = 100.0;
  param random_seed: float in 0.0..1000000.0 = 0.0;
  param positioning: enum { Locations, Strings } = Locations;
  param orientation: enum { Vertical, Horizontal } = Vertical;
  param string_count: int in 1..10000 = 1;
  param string_length: int in 1..10000 = 1;
  param pixel_size: float in 0.001..1000.0 = 1.0;

  sample {
    let strings = positioning == Strings;
    let across = orientation == Horizontal;
    let w = string_w(strings, across, string_count, string_length, pixel_size);
    let h = string_h(strings, across, string_count, string_length, pixel_size);
    let x = string_x(strings, across, string_length, pixel_size);
    let y = string_y(strings, across, string_length, pixel_size);
    let level = intensity / 100.0;
    let explode = snowflake_effect == Explode;
    let fixed_kind: float =
      if flake_type == Single { 1 } else if flake_type == Three { 2 } else if flake_type == Five { 3 }
      else if flake_type == Nine { 4 } else if flake_type == Thirteen { 5 } else if flake_type == ThirteenV2 { 6 }
      else if flake_type == Seventeen { 7 } else if flake_type == TwentyNine { 8 } else if flake_type == FortyFive { 9 } else { 0 };
    let ground = if snow_build_up { min(h, floor(initial_build_up * h / 100.0 + (1.0 + build_up_speed * 0.79) * time / 5.0)) } else { 0.0 };
    let base = rand(random_seed);
    -- The newest covering flake point as slot * 128 + its point.
    let code = last for slot in 0..int(1.0 + count * 0.99) {
      let key = rand(base + slot);
      let kind = if fixed_kind > 0.0 { fixed_kind } else { 1.0 + floor(rand(key + 0.05) * 9.0) };
      let reach = if kind <= 1.0 { 0.0 } else if kind <= 3.0 { 1.0 } else if kind <= 5.0 { 2.0 } else if kind <= 7.0 { 3.0 } else if kind == 8.0 { 4.0 } else { 5.0 };
      -- Cells per second.
      let cells = 4.0 * (1.0 + speed * 0.59) + (rand(key + 0.1) - 0.5) * 4.0 * (1.0 + speed_variation * 0.59);
      let span = if explode { max(w, h) / 2.0 + 2.0 * reach } else { w + h + 4.0 * reach };
      let along = time * cells + rand(key + 0.2) * span;
      let trip = floor(along / span);
      let along = along - trip * span;
      let trip_key = rand(key + trip);
      let degrees =
        if snowflake_effect == Falling { 145.0 + trip_key * 70.0 }
        else if explode { trip_key * 360.0 }
        else if max_direction > min_direction { min_direction + trip_key * (max_direction - min_direction) }
        else { min_direction + trip_key * (max_direction + 360 - min_direction) };
      let ux = sin(degrees * 0.017453292519943295);
      let uy = cos(degrees * 0.017453292519943295);
      let offset = (rand(trip_key + 0.3) - 0.5) * (abs(uy) * w + abs(ux) * h);
      let cx = round(if explode { w / 2.0 + ux * along } else { w / 2.0 + ux * (along - span / 2.0) + uy * offset });
      let cy = round(if explode { h / 2.0 + uy * along } else { h / 2.0 + uy * (along - span / 2.0) - ux * offset });
      guard cy >= ground && abs(x - cx) <= reach && abs(y - cy) <= reach && flake_point(kind, x - cx, y - cy);
      (slot * 8.0 + trip % 8.0) * 128.0 + (x - cx + 5.0) * 11.0 + y - cy + 5.0
    } else { -1.0 };
    guard code >= 0.0 else if y < ground { outer_colors[0][progress] * level } else { rgb(0.0, 0.0, 0.0) };
    let flake = floor(code / 128.0);
    let point = code - flake * 128.0;
    let flake_key = rand(base + flake);
    let brightness = if random_brightness { rand(flake_key + 0.4) * 0.8 + 0.2 } else { 1.0 };
    let outer = outer_colors[int(rand(flake_key + 0.5) * len(outer_colors))][progress];
    let inner = inner_colors[int(rand(flake_key + 0.6) * len(inner_colors))][progress];
    -- Point 60 is the flake's center.
    let c = if point == 60.0 { inner } else { outer };
    if color_type == Rainbow && point != 60.0 { hsv(rand(flake_key + 0.7), 1.0, brightness * level) }
    else if color_type == Range {
      let other = if point == 60.0 { inner_colors[int(rand(flake_key + 0.8) * len(inner_colors))][progress] } else { outer_colors[int(rand(flake_key + 0.8) * len(outer_colors))][progress] };
      hsv(mix(hue(c), hue(other), rand(flake_key + 0.9)), saturation(c), brightness * level)
    }
    else { c * (brightness * level) }
  }
}
