-- Whether the pixel is in the band a Pulse or Chase lights: the target is cut
-- into `bands` equal columns across x, and the effect lights column `band`. One
-- band, the default, is the whole target and skips the test.
fn in_band(bands: int, band: int) -> bool {
  bands == 1 || min(floor((pixel.x - target.min_x) / (target.max_x - target.min_x) * bands), bands - 1) == band
}

effect Pulse {
  param gradient: gradient;
  param pulse_shape: curve in 0.0..1.0;
  param bands: int in 1..1000 = 1;
  param band: int in 0..999 = 0;

  sample {
    guard in_band(bands, band);
    gradient[progress] * clamp(pulse_shape[progress], 0.0, 1.0)
  }
}

-- Vixen's pulse extension, shared by the chases and wipes: extending to the end
-- holds an item at its pulse's peak from where the pulse first reaches it until
-- the effect ends, and extending to the start holds the peak from the start of
-- the effect until the pulse last leaves it. A chase or wipe that turns items on
-- and leaves them on extends to the end; one that starts lit and turns them off
-- extends to the start. Returns the point of the pulse to show, which is
-- `pulse_progress` itself unless the item is held.
fn extended_pulse(shape: curve, pulse_progress: float, to_start: bool, to_end: bool) -> float {
  let peak = max(max(shape[0.0], shape[1.0]), value_or(shape[curve_first_crossing(shape, 1.0)], 0.0));
  let rise = curve_first_crossing(shape, peak);
  let fall = curve_last_crossing(shape, peak, 1.0);
  if to_end && pulse_progress >= rise { rise }
  else if to_start && pulse_progress <= fall { fall }
  else { pulse_progress }
}

effect Chase {
  param gradient: gradient;
  param gradient_mode: enum { ThroughEffect, AcrossItems, PerPulse } = PerPulse;
  param pulse_overlap: float in 1.0..1000.0 = 8.0;
  param chase_position: curve in 0.0..1.0;
  param reverse: bool = false;
  param extend_to_start: bool = false;
  param extend_to_end: bool = false;
  param pulse_shape: curve in 0.0..1.0;
  param bands: int in 1..1000 = 1;
  param band: int in 0..999 = 0;

  sample {
    guard in_band(bands, band);
    -- Split into bands, each band chases up its own column over the pixels it holds.
    let item_count = if bands == 1 { target.count } else { ceil(target.count / bands) };
    let position = if bands == 1 { pixel.index / max(1.0, item_count - 1.0) } else { (pixel.y - target.min_y) / (target.max_y - target.min_y) };
    let chase_value = if reverse { 1.0 - position } else { position };
    let pulse_duration = pulse_overlap / item_count;
    let hit = max(0.0, 1.0 - pulse_duration) * value_or(curve_first_crossing(chase_position, chase_value), chase_value);
    let pulse_progress = (progress - hit) / pulse_duration;
    let shown = extended_pulse(pulse_shape, pulse_progress, extend_to_start, extend_to_end);
    let level = if shown >= 0.0 && shown <= 1.0 { pulse_shape[shown] } else { 0.0 };
    let gradient_position =
      if gradient_mode == ThroughEffect { progress }
      else if gradient_mode == AcrossItems { position }
      else { shown };
    gradient[gradient_position] * clamp(level, 0.0, 1.0)
  }
}

effect Wipe {
  param gradient: gradient;
  param gradient_mode: enum { ThroughEffect, AcrossItems, PerPulse } = PerPulse;
  param pulse_width: float in 0.01..1.0 = 0.15;
  param direction_angle: float in 0.0..360.0 = 0.0;
  -- How many times the pulse sweeps across, one pass after another.
  param passes: int in 1..100 = 1;
  param wipe_position: curve in 0.0..1.0;
  param reverse: bool = false;
  param extend_to_start: bool = false;
  param extend_to_end: bool = false;
  param pulse_shape: curve in 0.0..1.0;

  sample {
    let radians = direction_angle * 0.017453292519943295;
    let dx = cos(radians);
    let dy = sin(radians);
    let projection = pixel.x * dx + pixel.y * dy;
    let projection_min = min(target.min_x * dx, target.max_x * dx) + min(target.min_y * dy, target.max_y * dy);
    let span = (target.max_x - target.min_x) * abs(dx) + (target.max_y - target.min_y) * abs(dy);
    -- Pixels all at one position (a wipe across a line) take position zero.
    -- Rounding can step just outside the projected span.
    let position = if span > 0.0 { clamp((projection - projection_min) / span, 0.0, 1.0) } else { 0.0 };
    let chase_value = if reverse { 1.0 - position } else { position };
    -- Each pass sweeps an equal share of the travel; the latest pass to reach
    -- the pixel lights it.
    let sweep = max(0.0, 1.0 - pulse_width) / passes;
    let first_hit = sweep * value_or(curve_first_crossing(wipe_position, chase_value), chase_value);
    let pass = clamp(floor((progress - first_hit) / sweep), 0.0, passes - 1.0);
    let hit = first_hit + pass * sweep;
    let pulse_progress = (progress - hit) / pulse_width;
    -- The first pass may hold from the start, the last until the end.
    let shown = extended_pulse(pulse_shape, pulse_progress, extend_to_start && pass == 0.0, extend_to_end && pass == passes - 1);
    let level = if shown >= 0.0 && shown <= 1.0 { pulse_shape[shown] } else { 0.0 };
    let gradient_position =
      if gradient_mode == ThroughEffect { progress }
      else if gradient_mode == AcrossItems { position }
      else { clamp(shown, 0.0, 1.0) };
    gradient[gradient_position] * clamp(level, 0.0, 1.0)
  }
}

effect Spin {
  param gradient: gradient;
  param gradient_mode: enum { ThroughEffect, AcrossItems, PerPulse } = PerPulse;
  param pulse_overlap: float in 1.0..200.0 = 8.0;
  param chase_position: curve in 0.0..1.0;
  param revolutions: int in 1..100 = 2;
  param reverse: bool = false;
  param pulse_shape: curve in 0.0..1.0;

  sample {
    let item_count = target.count;
    let position = pixel.index / max(1.0, item_count - 1.0);
    let position = if reverse { 1.0 - position } else { position };
    let pulse_width = pulse_overlap / item_count;
    let virtual_position = (revolutions + pulse_width) * chase_position[progress];
    let virtual_pixel = virtual_position - position;
    let phase =
      if virtual_pixel >= revolutions { virtual_pixel - (revolutions - 1.0) }
      else if virtual_pixel < 0.0 { virtual_pixel }
      else { virtual_pixel % 1.0 };
    let pulse_progress = phase / pulse_width;
    let level = if pulse_progress >= 0.0 && pulse_progress <= 1.0 { pulse_shape[pulse_progress] } else { 0.0 };
    let gradient_position =
      if gradient_mode == ThroughEffect { progress }
      else if gradient_mode == AcrossItems { pixel.index / max(1.0, item_count - 1.0) }
      else { pulse_progress };
    gradient[gradient_position] * clamp(level, 0.0, 1.0)
  }
}

effect MarkPulse {
  param beats: marks;
  param accent: gradient;
  param pulse_shape: curve in 0.0..1.0;
  param offset_seconds: float in -1.0..1.0 = 0.0;
  param decay_seconds: float in 0.01..10.0 = 0.18;
  param cluster_width_pixels: int in 1..1000 = 5;
  param clusters_per_mark: int in 1..100 = 3;
  param seed: float in 0.0..1000.0 = 0.0;
  param overlap_marks: bool = false;

  -- Each mark shifts the cluster grid by a random offset, so clusters land anywhere,
  -- and lights each cluster with chance `clusters_per_mark` over the cluster count:
  -- `clusters_per_mark` is the average number lit, and every pixel decides alone.
  -- Without overlap a new mark retriggers the entire selection, discarding every older pulse;
  -- with it every pulse still decaying stays lit, and overlapping pulses keep the brighter color.
  -- At most the 32 latest pulses overlap.
  sample {
    let now = time - offset_seconds;
    let latest = mark_last_index(beats, now);
    let live = latest - mark_last_index(beats, now - decay_seconds);
    max for back in 0..min(live, if overlap_marks { 32 } else { 1 }) {
      let hit_time = mark_at(beats, latest - back);
      guard hit_time + offset_seconds >= 0.0;
      let mark_seed = seed + hit_time * 1000.0;
      let shift = floor(rand(mark_seed) * cluster_width_pixels);
      let cluster_count = floor((target.count - 1 + shift) / cluster_width_pixels) + 1.0;
      let cluster = floor((pixel.index + shift) / cluster_width_pixels);
      guard rand(mark_seed * 31.0 + cluster) * cluster_count < clusters_per_mark;
      let child_progress = (now - hit_time) / decay_seconds;
      accent[child_progress] * clamp(pulse_shape[child_progress], 0.0, 1.0)
    }
  }
}

effect MarkChase {
  param beats: marks;
  param gradient_mode: enum { ThroughEffect, AcrossItems, PerPulse } = PerPulse;
  param gradients: array<gradient>;
  param offset_seconds: float in -1.0..1.0 = 0.0;
  param chase_seconds: float in 0.01..10.0 = 0.5;
  param pulse_overlap: float in 1.0..200.0 = 8.0;
  param chase_position: curve in 0.0..1.0;
  param pulse_shape: curve in 0.0..1.0;
  param overlap_marks: bool = false;

  -- All marks share the trajectory; its first crossing defines the travel delay.
  -- Without overlap a new mark replaces this pixel's pulse on arrival; with it every
  -- chase still running stays lit, and overlapping pulses keep the brighter color.
  -- At most the 32 latest chases overlap.
  sample {
    let item_count = target.count;
    let position = pixel.index / max(1.0, item_count - 1.0);
    let pulse_duration = pulse_overlap / item_count;
    let travel_end = max(0.0, 1.0 - pulse_duration);
    let hit = travel_end * curve_first_crossing(chase_position, position);
    let now = time - offset_seconds;
    let latest = mark_last_index(beats, now - chase_seconds * hit);
    let live = latest - mark_last_index(beats, now - chase_seconds);
    max for back in 0..min(live, if overlap_marks { 32 } else { 1 }) {
      let mark = latest - back;
      let hit_time = mark_at(beats, mark);
      guard hit_time + offset_seconds >= 0.0;
      let child_progress = (now - hit_time) / chase_seconds;
      let selected_gradient = gradients[mark % len(gradients)];
      let pulse_progress = (child_progress - hit) / pulse_duration;
      let level = if pulse_progress >= 0.0 && pulse_progress <= 1.0 { pulse_shape[pulse_progress] } else { 0.0 };
      let gradient_position =
        if gradient_mode == ThroughEffect { child_progress }
        else if gradient_mode == AcrossItems { position }
        else { pulse_progress };
      selected_gradient[gradient_position] * clamp(level, 0.0, 1.0)
    }
  }
}

effect MarkWipe {
  param beats: marks;
  param gradient_mode: enum { ThroughEffect, AcrossItems, PerPulse } = PerPulse;
  param gradients: array<gradient>;
  param offset_seconds: float in -1.0..1.0 = 0.0;
  param wipe_seconds: float in 0.01..10.0 = 0.5;
  param pulse_width: float in 0.01..1.0 = 0.15;
  -- Curve values are turns: 0 = 0 degrees, 0.25 = 90 degrees, 1 = 360 degrees.
  param direction_angle: curve in 0.0..1.0;
  param wipe_positions: array<curve> in 0.0..1.0;
  param pulse_shape: curve in 0.0..1.0;
  param overlap_marks: bool = false;

  -- Direction is sampled at the mark's time. Without overlap a new mark restarts the wipe;
  -- with it every wipe still running stays lit, and overlapping pulses keep the brighter color.
  -- At most the 32 latest wipes overlap.
  sample {
    let now = time - offset_seconds;
    let latest = mark_last_index(beats, now);
    let live = latest - mark_last_index(beats, now - wipe_seconds);
    let travel_end = max(0.0, 1.0 - pulse_width);
    max for back in 0..min(live, if overlap_marks { 32 } else { 1 }) {
      let mark = latest - back;
      let hit_time = mark_at(beats, mark);
      guard hit_time + offset_seconds >= 0.0;
      let child_progress = (now - hit_time) / wipe_seconds;
      let selected_gradient = gradients[mark % len(gradients)];
      let wipe_position = wipe_positions[mark % len(wipe_positions)];
      let angle = 360.0 * direction_angle[hit_time / duration];
      let radians = angle * 0.017453292519943295;
      let dx = cos(radians);
      let dy = sin(radians);
      let projection = pixel.x * dx + pixel.y * dy;
      let projection_min = min(target.min_x * dx, target.max_x * dx) + min(target.min_y * dy, target.max_y * dy);
      let span = (target.max_x - target.min_x) * abs(dx) + (target.max_y - target.min_y) * abs(dy);
      -- Pixels all at one position (a wipe across a line) take position zero.
      -- Rounding can step just outside the projected span.
      let position = if span > 0.0 { clamp((projection - projection_min) / span, 0.0, 1.0) } else { 0.0 };
      let query_position = if travel_end > 0.0 { child_progress / travel_end } else { 1.0 };
      let hit = travel_end * curve_last_crossing(wipe_position, position, query_position);
      let pulse_progress = (child_progress - hit) / pulse_width;
      let level = if pulse_progress >= 0.0 && pulse_progress <= 1.0 { pulse_shape[pulse_progress] } else { 0.0 };
      let gradient_position =
        if gradient_mode == ThroughEffect { child_progress }
        else if gradient_mode == AcrossItems { position }
        else { pulse_progress };
      selected_gradient[gradient_position] * clamp(level, 0.0, 1.0)
    }
  }
}

-- Vixen's Circle, Diamond and Burst wipes: a pulse that travels outward from a
-- center point (or inward when reversed), reaching each pixel by its distance.
effect RadialWipe {
  param gradient: gradient;
  -- Circle measures straight-line distance, Diamond the sum of the horizontal
  -- and vertical distances, Burst the larger of the two.
  param shape: enum { Circle, Diamond, Burst } = Circle;
  -- The pulse's length as a share of the effect, before Vixen's per-shape
  -- scaling.
  param pulse_length: float in 0.01..1.0 = 0.15;
  param center_x: float in -1.0..1.0 = 0.0;
  param center_y: float in -1.0..1.0 = 0.0;
  param reverse: bool = false;
  -- How many times the pulse crosses within the effect.
  param passes: int in 1..100 = 1;
  param extend_to_start: bool = false;
  param extend_to_end: bool = false;
  param pulse_shape: curve in 0.0..1.0;

  sample {
    let width = target.max_x - target.min_x;
    let height = target.max_y - target.min_y;
    let along_x = (center_x + 1.0) / 2.0;
    let along_y = (center_y + 1.0) / 2.0;
    let cx = target.min_x + along_x * width;
    -- Vixen places Burst's center without flipping its downward y axis.
    let cy = if shape == Burst { target.max_y - along_y * height } else { target.min_y + along_y * height };
    let corner_x = max(abs(target.min_x - cx), abs(target.max_x - cx));
    let corner_y = max(abs(target.min_y - cy), abs(target.max_y - cy));
    let farthest = sqrt(corner_x * corner_x + corner_y * corner_y);
    let dx = abs(pixel.x - cx);
    let dy = abs(pixel.y - cy);
    let diagonal = sqrt(width * width + height * height);
    let distance =
      if shape == Circle { sqrt(dx * dx + dy * dy) }
      else if shape == Diamond { dx + dy }
      else { max(dx, dy) };
    let reach =
      if shape == Circle { farthest }
      else if shape == Diamond { farthest * 1.41 }
      else { farthest };
    -- Vixen scales the pulse by its nominal step count over the rings it renders.
    let nominal =
      if shape == Circle { diagonal / 2.0 }
      else if shape == Diamond { diagonal / 1.5 }
      else { max(width, height) / 2.0 };
    let outward = clamp(distance / reach, 0.0, 1.0);
    let position = if reverse { 1.0 - outward } else { outward };
    let pulse_width = clamp(pulse_length * nominal / reach, 0.01, 1.0);
    let hit = position * (1.0 - pulse_width);
    -- Progress through the current pass; the last pass ends with the effect.
    let passed = progress * passes;
    let pass = min(floor(passed), passes - 1);
    let pulse_progress = (passed - pass - hit) / pulse_width;
    -- The first pass may hold from the start, the last until the end.
    let shown = extended_pulse(pulse_shape, pulse_progress, extend_to_start && pass == 0.0, extend_to_end && pass == passes - 1);
    let level = if shown >= 0.0 && shown <= 1.0 { pulse_shape[shown] } else { 0.0 };
    gradient[clamp(shown, 0.0, 1.0)] * clamp(level, 0.0, 1.0)
  }
}

-- A field of arrival times: each pixel lights when a mark's wipe reaches the time the
-- field assigns to its location, so the shape depends on where a pixel is and not on
-- which fixture holds it. Use WholeTarget scope for a wipe across several fixtures.
-- With the field's rotated coordinates p and q (measured from its center, in units of the
-- target's longer side), the arrival time is
--   linear * p + saddle * p * q + radial * (p * p + q * q)
-- Linear is a straight wipe along the direction, saddle makes hyperbolic fronts, and radial
-- makes rings around the center; a negative value reverses a term.
fn field_time(x: float, y: float, origin_x: float, origin_y: float, scale: float, angle_cos: float, angle_sin: float, linear: float, saddle: float, radial: float) -> float {
  let dx = (x - origin_x) / scale;
  let dy = (y - origin_y) / scale;
  let p = dx * angle_cos + dy * angle_sin;
  let q = dy * angle_cos - dx * angle_sin;
  linear * p + saddle * p * q + radial * (p * p + q * q)
}

-- The pixel's arrival time scaled to 0..1 by the field's extremes over the target. Only the
-- target's corners are sampled, so a quadratic's inner extremum can fall outside; the clamp holds it.
fn field_position(origin_x: float, origin_y: float, scale: float, angle_cos: float, angle_sin: float, linear: float, saddle: float, radial: float) -> float {
  let arrival = field_time(pixel.x, pixel.y, origin_x, origin_y, scale, angle_cos, angle_sin, linear, saddle, radial);
  let corner_a = field_time(target.min_x, target.min_y, origin_x, origin_y, scale, angle_cos, angle_sin, linear, saddle, radial);
  let corner_b = field_time(target.max_x, target.min_y, origin_x, origin_y, scale, angle_cos, angle_sin, linear, saddle, radial);
  let corner_c = field_time(target.min_x, target.max_y, origin_x, origin_y, scale, angle_cos, angle_sin, linear, saddle, radial);
  let corner_d = field_time(target.max_x, target.max_y, origin_x, origin_y, scale, angle_cos, angle_sin, linear, saddle, radial);
  let field_min = min(min(corner_a, corner_b), min(corner_c, corner_d));
  let field_max = max(max(corner_a, corner_b), max(corner_c, corner_d));
  clamp((arrival - field_min) / (field_max - field_min), 0.0, 1.0)
}

effect MarkFieldWipe {
  param beats: marks;
  param gradient_mode: enum { ThroughEffect, AcrossItems, PerPulse } = PerPulse;
  param gradients: array<gradient>;
  param offset_seconds: float in -1.0..1.0 = 0.0;
  param wipe_seconds: float in 0.01..10.0 = 0.5;
  param pulse_width: float in 0.01..1.0 = 0.15;
  param direction_angle: float in 0.0..360.0 = 0.0;
  -- Where the field is centered on the target: 0 is the left or top edge, 1 the right or bottom.
  param center_x: float in 0.0..1.0 = 0.5;
  param center_y: float in 0.0..1.0 = 0.5;
  param linear: float in -1.0..1.0 = 1.0;
  param saddle: float in -4.0..4.0 = 0.0;
  param radial: float in -4.0..4.0 = 0.0;
  param wipe_positions: array<curve> in 0.0..1.0;
  param pulse_shape: curve in 0.0..1.0;
  param overlap_marks: bool = false;

  -- Overlap and mark timing work as in MarkWipe: at most the 32 latest wipes overlap.
  sample {
    let now = time - offset_seconds;
    let latest = mark_last_index(beats, now);
    let live = latest - mark_last_index(beats, now - wipe_seconds);
    let travel_end = max(0.0, 1.0 - pulse_width);
    let width = target.max_x - target.min_x;
    let height = target.max_y - target.min_y;
    let scale = max(width, height);
    let radians = direction_angle * 0.017453292519943295;
    let angle_cos = cos(radians);
    let angle_sin = sin(radians);
    let origin_x = target.min_x + center_x * width;
    let origin_y = target.min_y + center_y * height;
    max for back in 0..min(live, if overlap_marks { 32 } else { 1 }) {
      let mark = latest - back;
      let hit_time = mark_at(beats, mark);
      guard hit_time + offset_seconds >= 0.0;
      let child_progress = (now - hit_time) / wipe_seconds;
      let selected_gradient = gradients[mark % len(gradients)];
      let wipe_position = wipe_positions[mark % len(wipe_positions)];
      let position = field_position(origin_x, origin_y, scale, angle_cos, angle_sin, linear, saddle, radial);
      let query_position = if travel_end > 0.0 { child_progress / travel_end } else { 1.0 };
      let hit = travel_end * curve_last_crossing(wipe_position, position, query_position);
      let pulse_progress = (child_progress - hit) / pulse_width;
      let level = if pulse_progress >= 0.0 && pulse_progress <= 1.0 { pulse_shape[pulse_progress] } else { 0.0 };
      let gradient_position =
        if gradient_mode == ThroughEffect { child_progress }
        else if gradient_mode == AcrossItems { position }
        else { pulse_progress };
      selected_gradient[gradient_position] * clamp(level, 0.0, 1.0)
    }
  }
}

-- The clip-driven counterpart of MarkFieldWipe, in the manner of Wipe: the field is fixed for the
-- clip and the pulse sweeps across it `passes` times over the clip's duration.
effect FieldWipe {
  param gradient: gradient;
  param gradient_mode: enum { ThroughEffect, AcrossItems, PerPulse } = PerPulse;
  param pulse_width: float in 0.01..1.0 = 0.15;
  param direction_angle: float in 0.0..360.0 = 0.0;
  -- Where the field is centered on the target: 0 is the left or top edge, 1 the right or bottom.
  param center_x: float in 0.0..1.0 = 0.5;
  param center_y: float in 0.0..1.0 = 0.5;
  param linear: float in -1.0..1.0 = 1.0;
  param saddle: float in -4.0..4.0 = 0.0;
  param radial: float in -4.0..4.0 = 0.0;
  -- How many times the pulse sweeps across, one pass after another.
  param passes: int in 1..100 = 1;
  param wipe_position: curve in 0.0..1.0;
  param reverse: bool = false;
  param extend_to_start: bool = false;
  param extend_to_end: bool = false;
  param pulse_shape: curve in 0.0..1.0;

  sample {
    let radians = direction_angle * 0.017453292519943295;
    let width = target.max_x - target.min_x;
    let height = target.max_y - target.min_y;
    let position = field_position(
      target.min_x + center_x * width,
      target.min_y + center_y * height,
      max(width, height),
      cos(radians),
      sin(radians),
      linear,
      saddle,
      radial
    );
    let chase_value = if reverse { 1.0 - position } else { position };
    -- Each pass sweeps an equal share of the travel; the latest pass to reach
    -- the pixel lights it.
    let sweep = max(0.0, 1.0 - pulse_width) / passes;
    let first_hit = sweep * value_or(curve_first_crossing(wipe_position, chase_value), chase_value);
    let pass = clamp(floor((progress - first_hit) / sweep), 0.0, passes - 1.0);
    let hit = first_hit + pass * sweep;
    let pulse_progress = (progress - hit) / pulse_width;
    -- The first pass may hold from the start, the last until the end.
    let shown = extended_pulse(pulse_shape, pulse_progress, extend_to_start && pass == 0.0, extend_to_end && pass == passes - 1);
    let level = if shown >= 0.0 && shown <= 1.0 { pulse_shape[shown] } else { 0.0 };
    let gradient_position =
      if gradient_mode == ThroughEffect { progress }
      else if gradient_mode == AcrossItems { position }
      else { clamp(shown, 0.0, 1.0) };
    gradient[gradient_position] * clamp(level, 0.0, 1.0)
  }
}

-- Effects ported from Vixen 3, close to the originals in look, not identical.
-- Source: https://github.com/VixenLights/Vixen/tree/3.13u2/src/Vixen.Modules/Effect
--
-- Levels and curves run 0..1; an empty curve reads as 1. Gradients and curves
-- must be supplied. `colors` and `levels` pair by index, and a shorter `levels`
-- array reuses its last curve. Vixen draws pixel effects on a grid of cells;
-- these run its formulas on each pixel's exact position instead. Their frame
-- spans the target's bounds in units of a hundredth of its larger extent, so a
-- feature Vixen sizes in cells is that many hundredths of the target, and
-- scale_x and scale_y stretch the pattern around the target's center. Sliders
-- Vixen sets in its own 0..100 units (speed, size, twist and the like) keep
-- those units, except motion Vixen counts in frames: Pinwheel turns per clip or
-- degrees a second, Spirograph turns degrees a second, and Fireworks' particles
-- live seconds and travel frame units.
--
-- Adapted from Vixen. Copyright 2023 Vixen Team.
-- Redistribution and use in source and binary forms, with or without
-- modification, are permitted provided that the following conditions are met:
-- * Redistributions of source code must retain the above copyright notice,
--   this list of conditions and the following disclaimer.
-- * Redistributions in binary form must reproduce the above copyright notice,
--   this list of conditions and the following disclaimer in the documentation
--   and/or other materials provided with the distribution.
-- THIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS "AS IS"
-- AND ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE
-- IMPLIED WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE
-- ARE DISCLAIMED. IN NO EVENT SHALL THE COPYRIGHT OWNER OR CONTRIBUTORS BE
-- LIABLE FOR ANY DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR
-- CONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF
-- SUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA, OR PROFITS; OR BUSINESS
-- INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY, WHETHER IN
-- CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE)
-- ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF THE
-- POSSIBILITY OF SUCH DAMAGE.

-- The frame's width and height, and the pixel's position in it: x in 0..w - 1
-- and y in 0..h - 1 with y = 0 at the bottom, like Vixen's cell indexes. A
-- one-point target is a single unit, as Vixen's one-cell grid.
fn frame_unit() -> float {
  let extent = max(target.max_x - target.min_x, target.max_y - target.min_y);
  if extent > 0.0 { extent / 100.0 } else { 1.0 }
}
fn frame_w() -> float { (target.max_x - target.min_x) / frame_unit() + 1.0 }
fn frame_h() -> float { (target.max_y - target.min_y) / frame_unit() + 1.0 }
fn frame_x(scale: float) -> float { (frame_w() - 1.0) / 2.0 + (pixel.x - (target.min_x + target.max_x) / 2.0) / (frame_unit() * scale) }
fn frame_y(scale: float) -> float { (frame_h() - 1.0) / 2.0 + (pixel.y - (target.min_y + target.max_y) / 2.0) / (frame_unit() * scale) }

-- A point turned by `turns` about (pivot_x, pivot_y) and scaled by 1 / zoom,
-- for an effect to sample in place of (x, y): its picture turns and zooms
-- about the pivot, as xLights' rotation and roto-zoom do.
fn turned_x(x: float, y: float, pivot_x: float, pivot_y: float, turns: float, zoom: float) -> float {
  ((x - pivot_x) * cos(turns * TAU) + (y - pivot_y) * sin(turns * TAU)) / zoom + pivot_x
}
fn turned_y(x: float, y: float, pivot_x: float, pivot_y: float, turns: float, zoom: float) -> float {
  ((y - pivot_y) * cos(turns * TAU) - (x - pivot_x) * sin(turns * TAU)) / zoom + pivot_y
}

-- `t` running forward over `period` and back over the next.
fn ping_pong(t: float, period: float) -> float {
  period - abs(t % (2.0 * period) - period)
}


-- BASIC: Set Level.
effect SetLevel {
  param light_color: color = #ffffff;
  param intensity: float in 0.0..1.0 = 1.0;

  sample { light_color * intensity }
}


-- BASIC: Alternating, interval or static, over groups of consecutive pixels.
effect Alternating {
  param colors: array<gradient>;
  param levels: array<curve> in 0.0..1.0;
  param interval_ms: float in 2.0..60000.0 = 500.0;
  param enable_static: bool = false;
  param group_level: int in 1..1000 = 1;
  param interval_skip_count: int in 0..1000 = 1;

  sample {
    let interval = if enable_static { duration * 1000.0 } else { interval_ms };
    let cycle = floor(time * 1000.0 / interval);
    let local = time * 1000.0 / interval - cycle;
    let i = int((pixel.index // group_level + cycle * interval_skip_count) % len(colors));
    colors[i][local] * value_or(levels[i][local], 1.0)
  }
}

-- BASIC: Strobe, time-interval mode with a 50% duty cycle.
effect Strobe {
  param colors: gradient;
  param intensity_curve: curve in 0.0..1.0;
  param cycle_time_ms: float in 3.0..60000.0 = 150.0;

  sample {
    let local = (time * 1000.0) % cycle_time_ms / (cycle_time_ms * 0.5);
    guard local < 1.0;
    colors[local] * value_or(intensity_curve[local], 1.0)
  }
}

-- BASIC: Candle Flicker. Each group of group_level pixels holds a random level
-- for each flicker, dipping from max_level by up to twice change_percentage and
-- never below min_level; groups flicker out of step.
effect Candle {
  param light_color: color = #ffa500;
  param flicker_frequency: float in 1.0..100.0 = 20.0;
  param change_percentage: float in 0.0..1.0 = 0.2;
  param min_level: float in 0.0..1.0 = 0.1;
  param max_level: float in 0.0..1.0 = 1.0;
  param group_level: int in 1..1000 = 1;
  param random_seed: float in 0.0..1000000.0 = 0.0;

  sample {
    let key = rand(random_seed * 31.0 + pixel.index // group_level);
    let flicker = floor(time * flicker_frequency + key);
    light_color * clamp(max_level * (1.0 - 2.0 * change_percentage * rand(key + flicker)), min_level, max_level)
  }
}




-- BASIC: Twinkle. Each element's time is cut into slots of the mean gap,
-- and each slot holds one triangular twinkle at a random offset.
effect Twinkle {
  param color_handling: enum {
    SingleColor { static_color: color = #ffffff },
    GradientThroughEffect,
    GradientPerPulse,
    GradientAcrossItems,
  } = GradientPerPulse;
  param gradient: gradient;
  param minimum_level: float in 0.0..1.0 = 0.0;
  param maximum_level: float in 0.0..1.0 = 1.0;
  param average_pulse_time_ms: int in 1..60000 = 400;
  param pulse_time_variation: float in 0.0..1.0 = 0.3;
  param average_coverage: float in 0.0..1.0 = 0.5;
  param individual_elements: bool = true;
  param random_seed: float in 0.0..1000000.0 = 0.0;

  sample {
    let element = if individual_elements { pixel.index } else { 0 };
    let key = rand(random_seed * 31.0 + element);
    -- Vixen's mean gap between twinkles is pulse / coverage / 2.
    let slot_ms = average_pulse_time_ms / max(0.01, average_coverage) / 2.0;
    let now = time * 1000.0 + key * slot_ms;
    let slot = floor(now / slot_ms);
    let length = min(slot_ms, average_pulse_time_ms * (1.0 + (rand(key + slot) * 2.0 - 1.0) * pulse_time_variation));
    let x = (now - slot * slot_ms - rand(key + slot + 0.5) * (slot_ms - length)) / length;
    let c = match color_handling {
      SingleColor { static_color } => static_color,
      GradientThroughEffect => gradient[progress],
      GradientPerPulse => gradient[clamp(x, 0.0, 1.0)],
      GradientAcrossItems => gradient[pixel.index / target.count],
    };
    let lit = x >= 0.0 && x <= 1.0;
    let triangle = if lit { 1.0 - abs(2.0 * x - 1.0) } else { 0.0 };
    c * (minimum_level + (maximum_level - minimum_level) * triangle)
  }
}

-- BASIC: Dissolve over groups of group_level consecutive pixels. A group is lit
-- while the density curve is above its rank, so groups go out in random (or
-- pixel) order as the default 100 -> 0 curve falls, each fading through the
-- level curve on its way out.
effect Dissolve {
  param colors: array<gradient>;
  param levels: array<curve> in 0.0..1.0;
  param dissolve_curve: curve in 0.0..1.0;
  param group_level: int in 1..50000 = 1;
  param random_dissolve: bool = true;
  param dissolve_flip: bool = true;
  param random_color: bool = true;
  param random_seed: float in 0.0..1000000.0 = 0.0;

  sample {
    let group = pixel.index // group_level;
    let groups: float = (target.count + group_level - 1) // group_level;
    let order = (group + 0.5) / groups;
    let rank = if random_dissolve { rand(random_seed * 31.0 + group) } else if dissolve_flip { order } else { 1.0 - order };
    let density = value_or(dissolve_curve[progress], 1.0);
    guard density > rank;
    -- Each group runs the level curve over its own life: 0 at full density, 1
    -- when the density falls to its rank and it goes out.
    let life = 1.0 - (density - rank) / (1.0 - rank);
    let i = if random_color { int(rand(random_seed * 31.0 + group + 0.5) * len(colors)) } else { group % len(colors) };
    colors[i][progress] * value_or(levels[i][life], 1.0)
  }
}

-- PIXEL: Pinwheel, both motion modes, all blade and color types.
effect Pinwheel {
  param colors: array<gradient>;
  param levels: array<curve> in 0.0..1.0;
  param color_type: enum { Standard, Gradient, Random, Rainbow } = Standard;
  param motion: enum { Iterations, Speed } = Iterations;
  param arms: int in 1..20 = 8;
  -- The arms turn `turns` times over the clip in Iterations motion, or `speed`
  -- degrees a second in Speed motion. These are top-level so they can be
  -- automated.
  param turns: float in 0.0..100.0 = 3.45;
  param speed: float in 0.0..1000.0 = 69.0;
  param thickness: float in 0.0..100.0 = 15.0;
  param size: float in 0.0..100.0 = 23.0;
  param twist: float in 0.0..100.0 = 56.0;
  param rotation: float in 0.0..100.0 = 100.0;
  param x_offset: float in 0.0..1.0 = 0.5;
  param y_offset: float in 0.0..1.0 = 0.5;
  param center_hub: float in 0.0..1.0 = 0.0;
  param offset_percentage: bool = true;
  param size_scale_basis: enum { LargestDimension, Height, Width } = LargestDimension;
  param blade_type: enum { Flat, ThreeD, InvertedThreeD, Fan } = Flat;
  param intensity: float in 0.0..1.0 = 1.0;
  param random_seed: float in 0.0..1000000.0 = 0.0;
  param scale_x: float in 0.01..100.0 = 1.0;
  param scale_y: float in 0.01..100.0 = 1.0;

  sample {
    let w = frame_w();
    let h = frame_h();
    let ox = x_offset * 200.0 - 100.0;
    let oy = y_offset * 200.0 - 100.0;
    let cx = w / 2.0 + (if offset_percentage { ox * w / 100.0 } else { ox });
    let cy = h / 2.0 + (if offset_percentage { -oy * h / 100.0 } else { oy });
    let dx = frame_x(scale_x) - cx;
    let dy = frame_y(scale_y) - cy;
    let radius = sqrt(dx * dx + dy * dy);
    let basis =
      if !offset_percentage { sqrt((w - cx) * (w - cx) + (h - cy) * (h - cy)) }
      else if size_scale_basis == Width { w }
      else if size_scale_basis == Height { h }
      else { max(w, h) };
    let max_radius = basis * (1.0 + size * 3.99) / 100.0;
    guard radius <= max_radius && radius > center_hub * max_radius;
    let angle = (270.0 - atan2(-dy, -dx) * 57.29577951308232) % 360.0;
    let separation = 360.0 / arms;
    let half_angle = max(1.0, round(thickness)) * separation / 200.0;
    let turned = if motion == Speed { time * speed } else { progress * turns * 360.0 };
    let turned = turned * (rotation / 50.0 - 1.0);
    let twist_angle = radius / max_radius * (twist * 10.0 - 500.0);
    -- The nearest arm owns the pixel.
    let offset = (angle - twist_angle + turned) / separation - 2.0;
    let arm = round(offset);
    let difference = abs(offset - arm) * separation;
    guard difference <= half_angle;
    let index = int(arm % arms) % len(colors);
    let color_position = if color_type == Gradient { radius / max_radius } else { progress };
    let level = value_or(levels[index][color_position], 1.0) * intensity;
    let leading = if rotation < 50.0 { offset > arm } else { offset < arm };
    let level =
      if blade_type == ThreeD { level * (1.0 - difference / half_angle) }
      else if blade_type == InvertedThreeD { level * difference / half_angle }
      else if blade_type == Fan { level * (if leading { half_angle + difference } else { half_angle - difference }) / (2.0 * half_angle) }
      else { level };
    -- Rainbow arms change hue 20 times a second, Vixen's default frame rate.
    if color_type == Random { hsv(rand(random_seed * 31.0 + index), 1.0, level) }
    else if color_type == Rainbow { hsv(rand(random_seed * 31.0 + arm * 7.0 + floor(time * 20.0)), 1.0, level) }
    else { colors[index][color_position] * level }
  }
}

-- PIXEL: Butterfly, five formulas, iteration or speed motion.
effect Butterfly {
  param gradient: gradient;
  param butterfly_type: enum { Type1, Type2, Type3, Type4, Type5 } = Type1;
  param color_scheme: enum { Gradient, Rainbow } = Gradient;
  param motion: enum {
    Iterations { iterations: int in 1..100 = 2, direction: enum { Forward, Backward } = Forward },
    Speed { speed: float in 0.0..100.0 = 60.0 },
  } = Iterations;
  param repeat: int in 1..100 = 1;
  param background_chunks: int in 1..100 = 1;
  param background_skips: int in 1..100 = 2;
  param use_base_color: bool = false;
  param base_color: color = #000000;
  param intensity: float in 0.0..1.0 = 1.0;
  param scale_x: float in 0.01..100.0 = 1.0;
  param scale_y: float in 0.01..100.0 = 1.0;

  sample {
    let w = frame_w();
    let h = frame_h();
    let x = frame_x(scale_x);
    let y = h - 1.0 - frame_y(scale_y);
    let repetitions: float =
      if butterfly_type == Type4 { repeat * 6.0 }
      else if butterfly_type == Type1 || butterfly_type == Type5 { repeat * 3.0 }
      else { repeat };
    -- How far the pattern has run, negative backward. Speed maps 0..100 to
    -- -80..80. Vixen wraps the position every iteration, which jumps the
    -- pattern back by `repetitions` radians; this one keeps running at the same
    -- rate.
    let travel = match motion {
      Iterations { iterations, direction } => if direction == Backward { -progress * iterations } else { progress * iterations },
      Speed { speed } => time * (speed * 1.6 - 80.0) / 10.0,
    };
    let state = abs(travel) * repetitions;
    let backward = travel < 0.0;
    let offset = if backward { state } else { -state };
    let value =
      if butterfly_type == Type2 || butterfly_type == Type3 {
        let fold = (h * state) % h;
        let f = 1.0 + min(fold, h - fold);
        let f = if butterfly_type == Type3 { f * 0.1 + h / 60.0 } else { f };
        let xx = (x - w / 2.0) / f;
        let yy = (y - h / 2.0) / f;
        if butterfly_type == Type3 { sin(xx) * cos(yy) } else { sqrt(xx * xx + yy * yy) }
      } else {
        let dimension = if butterfly_type == Type5 { w * h } else { w + h };
        let n = (x * x - y * y) * sin(offset + (x + y) * TAU / dimension);
        let d = x * x + y * y;
        let value = n / d;
        if butterfly_type == Type4 { value - floor(value) } else { abs(value) }
      };
    guard !(background_chunks > 1 && int(value * background_chunks) % background_skips == 0)
      else if use_base_color { base_color } else { rgb(0.0, 0.0, 0.0) };
    let level = intensity;
    if color_scheme == Rainbow { hsv(value, 1.0, level) } else { gradient[value] * level }
  }
}

-- PIXEL: Colorwash, iteration mode, center/outer/invert fades and shimmer.
effect Colorwash {
  param gradient: gradient;
  param wash_type: enum { Center, Outer, Invert } = Center;
  param iterations: int in 1..100 = 1;
  param horizontal_fade: bool = false;
  param vertical_fade: bool = false;
  param shimmer: bool = false;
  param intensity: float in 0.0..1.0 = 1.0;
  param scale_x: float in 0.01..100.0 = 1.0;
  param scale_y: float in 0.01..100.0 = 1.0;

  sample {
    -- Shimmer blanks every other 50 ms frame.
    guard !(shimmer && floor(time * 20.0) % 2.0 != 0.0);
    let c = gradient[(progress * iterations) % 1.0];
    let half_w = (frame_w() - 1.0) / 2.0;
    let half_h = (frame_h() - 1.0) / 2.0;
    let fade_x = if horizontal_fade && half_w > 0.0 { abs(half_w - frame_x(scale_x)) / half_w } else { -1.0 };
    let fade_y = if vertical_fade && half_h > 0.0 { abs(half_h - frame_y(scale_y)) / half_h } else { -1.0 };
    let v = intensity(c) * intensity;
    let v = if fade_x < 0.0 { v } else if wash_type == Center { v * (1.0 - fade_x) } else if wash_type == Outer { v * fade_x } else { v / (1.0 - fade_x) };
    let v = if fade_y < 0.0 { v } else if wash_type == Center { v * (1.0 - fade_y) } else if wash_type == Outer { v * fade_y } else { v / (1.0 - fade_y) };
    hsv(hue(c), saturation(c), v)
  }
}

-- PIXEL: Plasma, the seven-term formula with gradient or preset colors.
effect Plasma {
  param colors: array<gradient>;
  param color_type: enum { Normal, Preset1, Preset2, Preset3, Preset4 } = Normal;
  param plasma_style: int in 1..10 = 1;
  param speed: float in 0.0..100.0 = 10.0;
  param line_density: float in 0.0..100.0 = 10.0;
  param intensity: float in 0.0..1.0 = 1.0;
  param scale_x: float in 0.01..100.0 = 1.0;
  param scale_y: float in 0.01..100.0 = 1.0;

  sample {
    let w = frame_w();
    let h = frame_h();
    let x = frame_x(scale_x) / w;
    let y = (h - 1.0 - frame_y(scale_y)) / h;
    let t = (progress * 100.0 * speed + 1.0) / ((101.0 - speed) * 3.0);
    let cx = x + 0.5 * sin(t / 5.0);
    let cy = y + 0.5 * cos(t / 3.0);
    let v = sin(x * 10.0 + t)
      + sin(10.0 * (x * sin(t / 2.0) + y * cos(t / 3.0)) + t)
      + sin(sqrt(plasma_style * 50.0 * (cx * cx + cy * cy) + t))
      + sin(x + t) + sin((y + t) / 2.0) + sin((x + y + t) / 2.0);
    let v = (v + sin(sqrt(x * x + y * y) + t)) / 2.0;
    let phase = v * (1.0 + line_density * 0.09) * PI;
    let result =
      if color_type == Normal {
        let n = clamp((sin(phase + 2.0943951) + 0.5) / 2.0, 0.0, 0.99999) * len(colors);
        let i = int(n);
        mix(colors[i][progress], colors[(i + 1) % len(colors)][progress], n - i)
      } else {
        let r = (sin(phase) + 1.0) / 2.0;
        if color_type == Preset1 { rgb(r, (cos(phase) + 1.0) / 2.0, 0.0) }
        else if color_type == Preset2 { rgb(0.0, (cos(phase) + 1.0) / 2.0, r) }
        else if color_type == Preset3 { rgb(r, (sin(phase + 2.0943951) + 1.0) / 2.0, (sin(phase + 4.1887902) + 1.0) / 2.0) }
        else { rgb(r, r, r) }
      };
    result * intensity
  }
}

-- PIXEL: Bars, iteration motion in every direction, highlight and 3D.
effect Bars {
  param colors: array<gradient>;
  param direction: enum { Up, Down, Left, Right, Expand, Compress, HorizontalExpand, HorizontalCompress, AlternateUp, AlternateDown, AlternateLeft, AlternateRight } = Up;
  param iterations: int in 1..100 = 1;
  param repeat: int in 1..100 = 1;
  param highlight: bool = false;
  param show_3d: bool = false;
  param intensity: float in 0.0..1.0 = 1.0;
  param scale_x: float in 0.01..100.0 = 1.0;
  param scale_y: float in 0.01..100.0 = 1.0;

  sample {
    let w = frame_w();
    let h = frame_h();
    let x = frame_x(scale_x);
    let y = h - 1.0 - frame_y(scale_y);
    let horizontal =
      direction == Left || direction == Right || direction == AlternateLeft || direction == AlternateRight
      || direction == HorizontalExpand || direction == HorizontalCompress;
    let length = if horizontal { w } else { h };
    let coordinate =
      if direction == Right || direction == AlternateRight { x }
      else if direction == HorizontalExpand { min(x, w - x - 1.0) }
      else if direction == HorizontalCompress { max(x, w - x - 1.0) }
      else if horizontal { w - x - 1.0 }
      else if direction == Down || direction == AlternateDown { y }
      else if direction == Expand { min(y, h - y - 1.0) }
      else if direction == Compress { max(y, h - y - 1.0) }
      else { h - y - 1.0 };
    let count: float = len(colors) * repeat;
    let bar_size = length / count;
    let position = (progress * iterations) % 1.0;
    let alternate =
      direction == AlternateUp || direction == AlternateDown || direction == AlternateLeft || direction == AlternateRight;
    -- Alternate modes jump a whole bar at a time.
    let offset = if alternate { floor(position * count) * bar_size } else { position * count * bar_size };
    let n = coordinate + offset + 1.0;
    let within = n % bar_size;
    let result = colors[int((n % (len(colors) * bar_size)) / bar_size)][within / bar_size];
    let s = if highlight && within < 1.0 { 0.0 } else { saturation(result) };
    let v = if show_3d { intensity(result) * (bar_size - within) / bar_size } else { intensity(result) };
    hsv(hue(result), s, v * intensity)
  }
}

-- PIXEL: Border, simple or advanced with shared or independent edges.
effect Border {
  param gradient: gradient;
  param border_mode: enum {
    Simple { simple_border_width: int in 0..1000 = 1 },
    -- A Single border is `thickness` all round; an Independent one sets each side.
    Advanced {
      border_type: enum { Single, Independent } = Single,
      thickness: float in 0.0..100.0 = 20.0,
      top_thickness: float in 0.0..100.0 = 10.0,
      bottom_thickness: float in 0.0..100.0 = 10.0,
      left_thickness: float in 0.0..100.0 = 10.0,
      right_thickness: float in 0.0..100.0 = 10.0,
      border_size: float in 0.0..100.0 = 100.0,
      border_height: float in 0.0..100.0 = 100.0,
      x_offset: float in 0.0..100.0 = 50.0,
      y_offset: float in 0.0..100.0 = 50.0,
    },
  } = Simple;
  param gradient_mode: enum { OverTime, Across, Vertical, DiagonalTopBottom, DiagonalBottomTop } = OverTime;
  param intensity: float in 0.0..1.0 = 1.0;
  param scale_x: float in 0.01..100.0 = 1.0;
  param scale_y: float in 0.01..100.0 = 1.0;

  sample {
    let w = frame_w();
    let h = frame_h();
    let inset_x = match border_mode { Advanced { border_size } => (100.0 - border_size) * w / 200.0, Simple => 0.0 };
    let inset_y = match border_mode { Advanced { border_height } => (100.0 - border_height) * h / 200.0, Simple => 0.0 };
    let shift_x = match border_mode { Advanced { x_offset } => (x_offset * 2.0 - 100.0) * (w - inset_x) / 100.0, Simple => 0.0 };
    let shift_y = match border_mode { Advanced { y_offset } => (y_offset * 2.0 - 100.0) * (h - inset_y) / 100.0, Simple => 0.0 };
    let x = frame_x(scale_x) - shift_x;
    let y = h - 1.0 - frame_y(scale_y) - shift_y;
    guard x >= inset_x && x < w - inset_x && y >= inset_y && y < h - inset_y;
    let shared: float = match border_mode {
      Simple { simple_border_width } => simple_border_width,
      Advanced { thickness } => (2.0 + thickness * (min(w, h) - 2.0) / 100.0) / 2.0,
    };
    -- Each side, as wide as the others unless an Advanced border sets it alone.
    let top = match border_mode {
      Advanced { border_type, top_thickness } => if border_type == Independent { top_thickness * h / 100.0 } else { shared },
      Simple => shared,
    };
    let bottom = match border_mode {
      Advanced { border_type, bottom_thickness } => if border_type == Independent { bottom_thickness * h / 100.0 } else { shared },
      Simple => shared,
    };
    let left = match border_mode {
      Advanced { border_type, left_thickness } => if border_type == Independent { left_thickness * w / 100.0 } else { shared },
      Simple => shared,
    };
    let right = match border_mode {
      Advanced { border_type, right_thickness } => if border_type == Independent { right_thickness * w / 100.0 } else { shared },
      Simple => shared,
    };
    guard x < inset_x + left || x >= w - inset_x - right || y < inset_y + bottom || y >= h - inset_y - top;
    let position =
      if gradient_mode == Across { x / w }
      else if gradient_mode == Vertical { (h - y) / h }
      else if gradient_mode == DiagonalTopBottom { ((h - y) / h + x / w) / 2.0 }
      else if gradient_mode == DiagonalBottomTop { (y / h + x / w) / 2.0 }
      else { progress };
    gradient[position] * intensity
  }
}

-- PIXEL: Spiral, iteration motion, all directions, growth/shrink, blend and 3D.
effect Spiral {
  param colors: array<gradient>;
  param direction: enum { Forward, Backwards, None } = Forward;
  param iterations: float in 0.0..100.0 = 1.0;
  param repeat: int in 1..100 = 1;
  param rotation: float in 0.0..100.0 = 57.0;
  param thickness: float in 0.0..100.0 = 60.0;
  param grow: bool = false;
  param shrink: bool = false;
  param blend: bool = false;
  param show_3d: bool = false;
  param intensity: float in 0.0..1.0 = 1.0;
  param scale_x: float in 0.01..100.0 = 1.0;
  param scale_y: float in 0.01..100.0 = 1.0;

  sample {
    let w = frame_w();
    let h = frame_h();
    let x = frame_x(scale_x);
    let y = h - 1.0 - frame_y(scale_y);
    let count = len(colors) * repeat;
    let delta = w / count;
    let thick = delta * (1.0 + thickness * 0.99) / 100.0;
    let gap = delta - thick;
    let position = (progress * iterations) % 1.0;
    let growth =
      if grow && shrink { gap * 2.0 * min(position, 1.0 - position) }
      else if grow { gap * position }
      else if shrink { gap * (1.0 - position) }
      else { 0.0 };
    let thick = thick + growth;
    let shift = if direction == None { 0.0 } else if direction == Backwards { -position * w } else { position * w };
    let strand = (x - shift - y * (rotation * 3.0 - 150.0) / h) % w;
    -- The strand starting at or before this cell owns it.
    let index = floor(strand / delta);
    let within = strand - index * delta;
    guard within < thick && index < count;
    let color_position = if blend { (h - y - 1.0) / h } else { within / thick };
    let c = colors[int(index) % len(colors)][color_position];
    let v =
      if show_3d { if direction == Backwards { (thick - within) / thick } else { within / thick } }
      else { intensity(c) };
    hsv(hue(c), saturation(c), v * intensity)
  }
}

-- PIXEL: Circular Shockwave. Radius default 0 -> 1; width 0.02 -> 0.04.
effect Shockwave {
  param gradient: gradient;
  param radius_curve: curve in 0.0..1.0;
  param width_curve: curve in 0.0..1.0;
  param center_x: float in 0.0..1.0 = 0.5;
  param center_y: float in 0.0..1.0 = 0.5;
  param acceleration: enum { Linear, GentleIn, GentleOut, StrongOut } = GentleIn;
  param blend_edges: bool = true;
  param scaled_radius: bool = true;
  param scale_x: float in 0.01..100.0 = 1.0;
  param scale_y: float in 0.01..100.0 = 1.0;

  sample {
    let w = frame_w();
    let h = frame_h();
    let dx = frame_x(scale_x) - w * center_x;
    let dy = frame_y(scale_y) - h * (1.0 - center_y);
    let t = progress;
    let eased =
      if acceleration == GentleIn { t * sqrt(t) }
      else if acceleration == GentleOut { 1.0 - (1.0 - t) * sqrt(1.0 - t) }
      else if acceleration == StrongOut { 1.0 - pow(1.0 - t, 5) }
      else { t };
    let scale = if scaled_radius { max(w, h) } else { 750.0 };
    let radius = value_or(radius_curve[eased], 1.0) * scale;
    let half_width = value_or(width_curve[eased], 1.0) * 127.5;
    let distance = abs(sqrt(dx * dx + dy * dy) - radius);
    guard distance <= half_width;
    gradient[t] * (if blend_edges { 1.0 - distance / half_width } else { 1.0 })
  }
}

-- PIXEL: Garlands, five patterns and four directions, iteration mode. Rings
-- drop one at a time and stack from the far edge.
effect Garlands {
  param colors: array<gradient>;
  param direction: enum { Up, Down, Left, Right } = Up;
  param garland_type: enum { Type0, Type1, Type2, Type3, Type4 } = Type0;
  param iterations: int in 1..100 = 1;
  param spacing: float in 0.0..100.0 = 10.0;
  param intensity: float in 0.0..1.0 = 1.0;
  param scale_x: float in 0.01..100.0 = 1.0;
  param scale_y: float in 0.01..100.0 = 1.0;

  sample {
    let w = frame_w();
    let h = frame_h();
    let x = frame_x(scale_x);
    let y = h - 1.0 - frame_y(scale_y);
    let sideways = direction == Left || direction == Right;
    let height = if sideways { w } else { h };
    let across = if sideways { y } else { x };
    let row =
      if direction == Left { w - x - 1.0 }
      else if direction == Right { x }
      else if direction == Down { h - y - 1.0 }
      else { y };
    let separation = (1.0 + spacing * 0.19) * h / 100.0 + 3.0;
    let m = across % 5.0;
    let sag =
      if garland_type == Type1 { max(0.0, 2.0 - abs(m - 2.0)) }
      else if garland_type == Type2 { max(0.0, 4.0 - 2.0 * abs(m - 2.0)) }
      else if garland_type == Type3 { 2.0 * min(across % 6.0, 6.0 - across % 6.0) }
      else if garland_type == Type4 { max(0.0, 2.0 - 2.0 * abs(abs(m - 2.0) - 1.0)) }
      else { 0.0 };
    -- `state` sweeps the ring stack down through the rows each iteration.
    let state = (1.0 - (progress * iterations) % 1.0) * height * separation;
    -- Rings are lines one unit thick.
    let free_ring = (state - sag - row) / separation;
    let falling = round(free_ring);
    let ring = if abs(free_ring - falling) * separation <= 0.5 && falling >= 0.0 && row >= height - falling - 1.0 { falling } else { -1.0 };
    let settled = round(height - row - 1.0);
    let ring = if settled >= 0.0 && state - settled * separation - sag <= row { max(ring, settled) } else { ring };
    guard ring >= 0.0;
    let color_position = ring / height * (len(colors) - 1);
    let i = int(color_position);
    mix(colors[i][progress], colors[(i + 1) % len(colors)][progress], color_position - i) * intensity
  }
}

-- PIXEL: Curtain, open/close from six edges with swag. Default position curve
-- 1 -> 0 -> 1; intensity curve flat 1.
effect Curtain {
  param gradient: gradient;
  param position_curve: curve in 0.0..1.0;
  param intensity_curve: curve in 0.0..1.0;
  param direction: enum { Open, Close } = Open;
  param edge: enum { Left, Center, Right, Bottom, Middle, Top } = Center;
  param iterations: int in 1..100 = 1;
  param swag: int in 0..100 = 1;
  param intensity_per_iteration: bool = false;
  param scale_x: float in 0.01..100.0 = 1.0;
  param scale_y: float in 0.01..100.0 = 1.0;

  sample {
    let phase = (progress * iterations) % 1.0;
    let position = 1.0 - value_or(position_curve[phase], 1.0);
    let level = value_or(intensity_curve[if intensity_per_iteration { phase } else { progress }], 1.0);
    let w = frame_w();
    let h = frame_h();
    let vertical = edge == Bottom || edge == Middle || edge == Top;
    let paired = edge == Center || edge == Middle;
    let length = if vertical { h } else { w };
    let cross_length = if vertical { w } else { h };
    let coordinate = if vertical { frame_y(scale_y) } else { frame_x(scale_x) };
    let cross = if vertical { frame_x(scale_x) } else { frame_y(scale_y) };
    -- Fold a paired curtain onto one half; distance runs from the curtain's edge.
    let half = if paired { length / 2.0 } else { length };
    let distance =
      if paired { if coordinate < half { coordinate } else { length - 1.0 - coordinate } }
      else if edge == Left || edge == Top { length - 1.0 - coordinate }
      else { coordinate };
    let swag_length = if h > 1.0 { swag * w / 40.0 } else { 0.0 };
    let covered_length = (position * length + swag_length * position * 2.0) / (if paired { 2.0 } else { 1.0 });
    let covered_length = if direction == Open { half - covered_length } else { covered_length };
    -- The swag hangs past the curtain's edge, shorter farther out.
    let beyond = distance - covered_length;
    let sag = cross_length * (beyond / max(1.0, swag_length)) * (beyond / max(1.0, swag_length));
    guard beyond <= 0.0 || (beyond < swag_length && (if vertical { cross > sag } else { cross < cross_length - sag }));
    gradient[distance / half] * level
  }
}

-- PIXEL: Spirograph, a hypotrochoid of up to 5,400 points drawn on the grid, in
-- standard, random or rainbow colors. It searches every point for each pixel,
-- so it is expensive on large targets.
effect Spirograph {
  param colors: array<gradient>;
  param color_type: enum { Standard, Random, Rainbow } = Standard;
  param outer_circle_radius: float in 0.0..100.0 = 88.0;
  param inner_circle_radius: float in 0.0..100.0 = 21.0;
  -- Degrees a second the pattern turns; the pen distance animates at half that.
  param speed: float in 0.0..10000.0 = 40.0;
  param distance: float in 0.0..100.0 = 50.0;
  param color_range: float in 0.0..100.0 = 35.0;
  param spirograph_range: float in 0.0..100.0 = 33.0;
  param animate: bool = true;
  param intensity: float in 0.0..1.0 = 1.0;
  param random_seed: float in 0.0..1000000.0 = 0.0;
  param scale_x: float in 0.01..100.0 = 1.0;
  param scale_y: float in 0.01..100.0 = 1.0;

  sample {
    let w = frame_w();
    let h = frame_h();
    let cx = w / 2.0;
    let cy = h / 2.0;
    let x = frame_x(scale_x);
    let y = h - 1.0 - frame_y(scale_y);
    let outer = cx * outer_circle_radius / 100.0;
    let inner = min(outer, cx * inner_circle_radius / 100.0);
    guard inner > 0.0;
    let state = time * speed;
    let d = cx * (1.0 + distance * 0.99) / 100.0;
    let d = if animate { (d + state / 2.0) % 100.0 } else { d };
    guard sqrt((x - cx) * (x - cx) + (y - cy) * (y - cy)) <= outer - inner + d + 0.75;
    let samples = floor((1.0 + spirograph_range * 2.99) * 18.0);
    let bin = round((1.0 + color_range * 1.99) / len(colors));
    first for ordinal in 0..int(samples) {
      let point = samples - ordinal;
      let angle = (point + state % 1440.0) * 0.017453292519943295;
      let rx = (outer - inner) * cos(angle) + d * cos((outer - inner) / inner * angle) + cx;
      let ry = (outer - inner) * sin(angle) + d * sin((outer - inner) / inner * angle) + cy;
      guard abs(rx - x) <= 0.5 && abs(ry - y) <= 0.5;
      let level = intensity;
      -- Random and rainbow colors change 20 times a second, Vixen's default
      -- frame rate.
      let pick = rand((random_seed * 31.0 + floor(time * 20.0)) * 31.0 + point);
      if color_type == Rainbow { hsv(pick, 1.0, level) }
      else {
        let i = if color_type == Random { pick * len(colors) } else { sqrt((rx - cx) * (rx - cx) + (ry - cy) * (ry - cy)) / (1.0 + color_range * 1.99) * 100.0 / bin };
        colors[int(i)][progress] * level
      }
    }
  }
}

-- Smooth value noise in -1..1 on a lattice of unit cells.
fn value_noise(u: float, v: float, seed: float) -> float {
  let i = floor(u);
  let j = floor(v);
  let fx = smoothstep(0.0, 1.0, u - i);
  let fy = smoothstep(0.0, 1.0, v - j);
  let a = mix(rand(seed + i + j * 127.0), rand(seed + i + 1.0 + j * 127.0), fx);
  let b = mix(rand(seed + i + (j + 1.0) * 127.0), rand(seed + i + 1.0 + (j + 1.0) * 127.0), fx);
  mix(a, b, fy) * 2.0 - 1.0
}

-- PIXEL: Fire from any edge, with height and hue-shift curves. Heat falls off
-- away from the edge and rising noise breaks it into flames. Vixen defaults:
-- height flat 0.5, hue shift flat 0.
effect Fire {
  param location: enum { Bottom, Top, Left, Right } = Bottom;
  param height: curve in 0.0..1.0;
  param hue_shift: curve in 0.0..1.0;
  param intensity: float in 0.0..1.0 = 1.0;
  param random_seed: float in 0.0..1000000.0 = 0.0;
  param scale_x: float in 0.01..100.0 = 1.0;
  param scale_y: float in 0.01..100.0 = 1.0;

  sample {
    let w = frame_w();
    let h = frame_h();
    let x = frame_x(scale_x);
    let y = frame_y(scale_y);
    let vertical = location == Bottom || location == Top;
    let rows = if vertical { h } else { w };
    let sx = if vertical { x } else { y };
    let sy =
      if location == Bottom { y } else if location == Top { h - 1.0 - y }
      else if location == Left { x } else { w - 1.0 - x };
    let flame = rows * max(0.01, value_or(height[progress], 1.0));
    let rise = time * 20.0;
    let seed = rand(random_seed) * 4096.0;
    let noise = value_noise(sx / 2.0, (sy - rise) / 3.0, seed) * 0.6 + value_noise(sx / 5.0, (sy - rise) / 8.0, seed + 512.0) * 0.4;
    -- Heat runs 0..2: red up to 1, then toward yellow.
    let heat = (1.0 - sy / flame + noise * 0.5) * 2.0;
    guard heat > 0.01;
    let hue = max(0.0, heat - 1.0) * 0.166;
    let shift = value_or(hue_shift[progress], 1.0);
    let hue = if shift > 0.0 { min(1.0, hue + shift) } else { hue };
    hsv(hue, 1.0, min(1.0, heat) * intensity)
  }
}

-- PIXEL: Fireworks: random or mark-timed explosions. Each explosion throws its
-- particles out at random speeds within one ring per particle direction; they
-- fall slowly and fade out over `particle_life` seconds. The fastest particle
-- travels `reach` frame units in that time (a random reach between `min_reach`
-- and `max_reach` per explosion), and every particle falls `fall`.
effect Fireworks {
  param colors: array<gradient>;
  param color_type: enum { Standard, Rainbow, Range, Palette, Random } = Standard;
  param source: enum { RandomExplosions, MarkCollection } = RandomExplosions;
  param explosion_marks: marks;
  param explosions: int in 0..100 = 10;
  param random_reach: bool = false;
  param reach: float in 0.0..1000.0 = 125.0;
  param min_reach: float in 0.0..1000.0 = 25.0;
  param max_reach: float in 0.0..1000.0 = 250.0;
  param random_particles: bool = true;
  param particles: int in 0..100 = 40;
  param min_particles: int in 0..100 = 10;
  param max_particles: int in 0..100 = 50;
  param particle_life: float in 0.01..10.0 = 1.25;
  param fall: float in 0.0..100.0 = 2.083;
  param intensity: float in 0.0..1.0 = 1.0;
  param random_seed: float in 0.0..1000000.0 = 0.0;
  param scale_x: float in 0.01..100.0 = 1.0;
  param scale_y: float in 0.01..100.0 = 1.0;

  sample {
    let w = frame_w();
    let h = frame_h();
    let x = frame_x(scale_x);
    let y = frame_y(scale_y);
    let count = if source == MarkCollection { len(explosion_marks) } else { explosions };
    guard count > 0;
    let lo =
      if source == MarkCollection { max(0, mark_last_index(explosion_marks, time - particle_life)) }
      else { max(0, int((time - particle_life) * count / duration) - 1) };
    let hi =
      if source == MarkCollection { mark_last_index(explosion_marks, time) }
      else { min(count - 1, int(time * count / duration)) };
    -- Later explosions draw over earlier ones.
    last for slot in 0..min(hi - lo + 1, 100) {
      let explosion = lo + slot;
      let seed = random_seed * 31.0 + explosion * 8.0;
      let start =
        if source == MarkCollection { mark_at(explosion_marks, explosion) }
        else { (explosion + rand(seed + 1.0)) * duration / count };
      -- How far through its life the explosion is, 0..1.
      let age = (time - start) / particle_life;
      guard age >= 0.0 && age < 1.0;
      let n = if random_particles { min_particles + floor(rand(seed + 4.0) * max(0, max_particles - min_particles)) } else { particles };
      let top_reach = if random_reach { min_reach + rand(seed + 5.0) * (max_reach - min_reach) } else { reach };
      let dx = x - (w * 0.25 + rand(seed + 2.0) * w * 0.5);
      let dy = y - (h * 0.25 + rand(seed + 3.0) * h * 0.5) + fall * age * age * age;
      -- The particle whose direction points at this cell, and its distance.
      let particle = floor((atan2(dy, dx) / TAU + 0.5) * n);
      let distance = age * top_reach * rand(seed + 6.0 + particle * 0.01);
      guard n > 0 && abs(sqrt(dx * dx + dy * dy) - distance) < 0.75;
      let value = (1.0 - age) * intensity;
      let pick = rand(seed + 7.0 + particle * 0.01);
      let c = colors[int(pick * len(colors))][progress];
      if color_type == Rainbow || color_type == Random { hsv(if color_type == Random { rand(seed + 5.5) } else { pick }, 1.0, value) }
      else if color_type == Range { hsv(mix(hue(colors[0][progress]), hue(colors[len(colors) - 1][progress]), pick), saturation(c), value) }
      else if color_type == Palette { hsv(hue(c), saturation(c), value) }
      else { let c = colors[int(rand(seed + 5.0) * len(colors))][progress]; hsv(hue(c), saturation(c), value) }
    }
  }
}

-- How far slot `key`'s meteors have travelled in all, in cells: Vixen's speed is
-- two cells per second per unit, varied per slot, from a random start.
-- PIXEL: Meteors falling, or rising, in one direction on a Strings or Locations
-- grid. Paths run in lanes one cell apart across the direction, and each lane
-- launches meteors one trip after another at a random speed, so a pixel checks
-- only the lanes it touches. About `count` slots of meteors share the lanes, at
-- most 128 a lane; every lane runs the same slots from its own random offset,
-- and a trip shows with the slots' share of the lanes. A meteor's tail tapers by
-- tail_taper (default 1 -> 0). Default gradients red/lime/blue.
effect Meteors {
  param colors: array<gradient>;
  param tail_taper: curve in 0.0..1.0;
  param color_type: enum { Rainbow, Range, Palette, Gradient } = Palette;
  param meteor_effect: enum { Falling, Rising } = Falling;
  param direction: int in 1..360 = 180;
  param speed: float in 0.0..100.0 = 14.0;
  param speed_variation: float in 0.0..100.0 = 12.0;
  param count: float in 0.0..100.0 = 10.0;
  param tail_length: float in 0.0..100.0 = 5.0;
  param random_brightness: bool = false;
  param intensity: float in 0.0..1.0 = 1.0;
  param random_seed: float in 0.0..1000000.0 = 0.0;
  param positioning: enum {
    Locations,
    -- Vixen's Strings layout: string_count strings of string_length consecutive
    -- pixels, x the string and y the pixel along it (Horizontal swaps them).
    Strings {
      orientation: enum { Vertical, Horizontal } = Vertical,
      string_count: int in 1..10000 = 1,
      string_length: int in 1..10000 = 1,
    },
  } = Locations;
  param scale_x: float in 0.01..100.0 = 1.0;
  param scale_y: float in 0.01..100.0 = 1.0;

  sample {
    -- Locations uses the frame.
    let w = match positioning {
      Strings { orientation, string_count, string_length } => if orientation == Horizontal { string_length } else { string_count },
      Locations => frame_w(),
    };
    let h = match positioning {
      Strings { orientation, string_count, string_length } => if orientation == Horizontal { string_count } else { string_length },
      Locations => frame_h(),
    };
    let x = match positioning {
      Strings { orientation, string_length } => if orientation == Horizontal { pixel.index % string_length } else { pixel.index // string_length },
      Locations => frame_x(scale_x),
    } + 0.5;
    let y = match positioning {
      Strings { orientation, string_length } => if orientation == Horizontal { pixel.index // string_length } else { pixel.index % string_length },
      Locations => frame_y(scale_y),
    } + 0.5;
    let length = 1.0 + tail_length * 0.99;
    let tail = max(1.0, if h < 10.0 { length / 10.0 } else { h * length / 100.0 });
    let base = rand(random_seed);
    let span = w + h + tail;
    let degrees = if meteor_effect == Rising { direction + 180.0 } else { direction * 1.0 };
    let ux = sin(degrees * 0.017453292519943295);
    let uy = cos(degrees * 0.017453292519943295);
    -- Lanes across the direction, the slots of each, and the share of trips shown.
    let lanes = max(1.0, ceil(abs(uy) * w + abs(ux) * h));
    let slots = floor(1.0 + count * 1.99);
    let per_lane = int(clamp(ceil(slots / lanes), 1.0, 128.0));
    let shown = slots / (lanes * per_lane);
    let half = 0.5 * max(abs(ux), abs(uy)) + 0.5 * min(abs(ux), abs(uy));
    -- Each slot's key and how far it has travelled, once a frame.
    let keys = table for j in 0..per_lane { rand(base + j) };
    let travelled = table for j in 0..per_lane {
      time * (2.0 * speed + (rand(keys[j] + 0.1) - 0.5) * 2.0 * speed_variation) + rand(keys[j] + 0.2) * span
    };
    -- The pixel along the direction from the grid's center, and across it in lanes.
    let dx = x - w / 2.0;
    let dy = y - h / 2.0;
    let ahead = dx * ux + dy * uy;
    let side = dx * uy - dy * ux + lanes / 2.0;
    let first_lane = floor(side - half);
    let touched = floor(side + half) - first_lane;
    -- The highest covering slot as slot * 4 + its tail fraction.
    let code = max for step in 0..3 {
      let lane = first_lane + step;
      guard step <= touched && lane >= 0.0 && lane < lanes && abs(side - lane - 0.5) <= half;
      let offset = rand(base + lane + 0.5) * span;
      max for j in 0..per_lane {
        let along = travelled[j] + offset;
        let trip = floor(along / span);
        let behind = along - trip * span - span / 2.0 - ahead;
        guard behind > -0.5 && behind < tail - 0.5 && (shown >= 1.0 || rand(rand(keys[j] + trip + offset) + 0.35) < shown);
        (lane * per_lane + j) * 4.0 + clamp(behind / tail, 0.0, 0.999)
      }
    };
    guard code >= 0.0;
    let slot = floor(code / 4.0);
    let fraction = code - slot * 4.0;
    let lane = floor(slot / per_lane);
    let j = int(slot - lane * per_lane);
    let offset = rand(base + lane + 0.5) * span;
    let trip_key = rand(keys[j] + floor((travelled[j] + offset) / span) + offset);
    let brightness = if random_brightness { 0.2 + rand(trip_key + 0.4) * 0.8 } else { 1.0 };
    let factor = brightness * value_or(tail_taper[fraction], 1.0) * intensity;
    let first = colors[int(rand(trip_key + 0.5) * len(colors))];
    if color_type == Rainbow { hsv(rand(trip_key + 0.6), 1.0, factor) }
    else if color_type == Range {
      let a = first[progress];
      let b = colors[int(rand(trip_key + 0.7) * len(colors))][progress];
      hsv(mix(hue(a), hue(b), rand(trip_key + 0.8)), mix(saturation(a), saturation(b), rand(trip_key + 0.9)), factor)
    }
    else if color_type == Gradient { first[fraction] * factor }
    else { first[progress] * factor }
  }
}

-- Whether |offset| (ax, ay) from a flake's center lies on a cross with arms
-- `reach` long, one unit thick.
fn flake_cross(ax: float, ay: float, reach: float) -> bool {
  (ax <= 0.5 && ay <= reach + 0.5) || (ay <= 0.5 && ax <= reach + 0.5)
}

-- Whether offset (dx, dy) from a flake's center lies in its shape, for Vixen's
-- flake kinds 1 (a dot) to 9 (a 45-point star), drawn one unit thick.
fn flake_point(kind: float, dx: float, dy: float) -> bool {
  let ax = abs(dx);
  let ay = abs(dy);
  let diagonal = abs(ax - ay) <= 0.5;
  if kind <= 1.0 { ax <= 0.5 && ay <= 0.5 }
  else if kind == 2.0 { ax <= 0.5 && ay <= 1.5 }
  else if kind == 3.0 { flake_cross(ax, ay, 1.0) }
  else if kind == 4.0 { flake_cross(ax, ay, 2.0) }
  else if kind == 5.0 { flake_cross(ax, ay, 1.0) || (abs(ax - 1.0) <= 0.5 && abs(ay - 2.0) <= 0.5) || (abs(ax - 2.0) <= 0.5 && abs(ay - 1.0) <= 0.5) }
  else if kind == 6.0 { flake_cross(ax, ay, 3.0) }
  else if kind == 7.0 { flake_cross(ax, ay, 3.0) || (diagonal && max(ax, ay) <= 1.5) }
  else if kind == 8.0 { (ax <= 1.5 && ay <= 2.5) || (ax <= 2.5 && ay <= 1.5) || flake_cross(ax, ay, 4.0) }
  else { (diagonal && max(ax, ay) <= 4.5) || (abs(ax - 2.0) <= 0.5 && abs(ay - 3.0) <= 0.5) || (abs(ax - 3.0) <= 0.5 && abs(ay - 2.0) <= 0.5) || flake_cross(ax, ay, 5.0) }
}

-- PIXEL: Snowflakes falling, in random directions or exploding, on a Strings or
-- Locations grid, with every flake shape and optional build-up. Flakes move like
-- Meteors' slots; the outer color fills a flake and the inner one its
-- center. Build-up raises a pile in the first outer gradient. Default gradients:
-- white outer, blue inner.
effect Snowflakes {
  param outer_colors: array<gradient>;
  param inner_colors: array<gradient>;
  param flake_type: enum { Random, Single, Three, Five, Nine, Thirteen, ThirteenV2, Seventeen, TwentyNine, FortyFive } = Random;
  param color_type: enum { Range, Palette, Rainbow } = Palette;
  param snowflake_effect: enum {
    Falling,
    RandomDirection { min_direction: int in 0..360 = 145, max_direction: int in 0..360 = 215 },
    Explode,
  } = Falling;
  param speed: float in 0.0..100.0 = 11.0;
  param speed_variation: float in 0.0..100.0 = 8.0;
  param count: float in 0.0..100.0 = 10.0;
  param random_brightness: bool = true;
  param snow_build_up: bool = false;
  param initial_build_up: float in 0.0..1.0 = 0.0;
  param build_up_speed: float in 0.0..100.0 = 15.0;
  param intensity: float in 0.0..1.0 = 1.0;
  param random_seed: float in 0.0..1000000.0 = 0.0;
  param positioning: enum {
    Locations,
    -- Vixen's Strings layout: string_count strings of string_length consecutive
    -- pixels, x the string and y the pixel along it (Horizontal swaps them).
    Strings {
      orientation: enum { Vertical, Horizontal } = Vertical,
      string_count: int in 1..10000 = 1,
      string_length: int in 1..10000 = 1,
    },
  } = Locations;
  param scale_x: float in 0.01..100.0 = 1.0;
  param scale_y: float in 0.01..100.0 = 1.0;

  sample {
    -- Locations uses the frame.
    let w = match positioning {
      Strings { orientation, string_count, string_length } => if orientation == Horizontal { string_length } else { string_count },
      Locations => frame_w(),
    };
    let h = match positioning {
      Strings { orientation, string_count, string_length } => if orientation == Horizontal { string_count } else { string_length },
      Locations => frame_h(),
    };
    let x = match positioning {
      Strings { orientation, string_length } => if orientation == Horizontal { pixel.index % string_length } else { pixel.index // string_length },
      Locations => frame_x(scale_x),
    };
    let y = match positioning {
      Strings { orientation, string_length } => if orientation == Horizontal { pixel.index // string_length } else { pixel.index % string_length },
      Locations => frame_y(scale_y),
    };
    let level = intensity;
    let explode = snowflake_effect == Explode;
    let fixed_kind: float =
      if flake_type == Single { 1 } else if flake_type == Three { 2 } else if flake_type == Five { 3 }
      else if flake_type == Nine { 4 } else if flake_type == Thirteen { 5 } else if flake_type == ThirteenV2 { 6 }
      else if flake_type == Seventeen { 7 } else if flake_type == TwentyNine { 8 } else if flake_type == FortyFive { 9 } else { 0 };
    let ground = if snow_build_up { min(h, initial_build_up * h + (1.0 + build_up_speed * 0.79) * time / 5.0) } else { 0.0 };
    let base = rand(random_seed);
    -- The newest covering flake, times 2, plus 1 on its center.
    let code = last for slot in 0..int(1.0 + count * 0.99) {
      let key = rand(base + slot);
      let kind = if fixed_kind > 0.0 { fixed_kind } else { 1.0 + floor(rand(key + 0.05) * 9.0) };
      let reach = if kind <= 1.0 { 0.0 } else if kind <= 3.0 { 1.0 } else if kind <= 5.0 { 2.0 } else if kind <= 7.0 { 3.0 } else if kind == 8.0 { 4.0 } else { 5.0 };
      -- Cells per second.
      let cells = 4.0 * (1.0 + speed * 0.59) + (rand(key + 0.1) - 0.5) * 4.0 * (1.0 + speed_variation * 0.59);
      let span = if explode { max(w, h) / 2.0 + 2.0 * reach } else { w + h + 4.0 * reach };
      let along = time * cells + rand(key + 0.2) * span;
      let trip = floor(along / span);
      let along = along - trip * span;
      let trip_key = rand(key + trip);
      let degrees = match snowflake_effect {
        Falling => 145.0 + trip_key * 70.0,
        RandomDirection { min_direction, max_direction } =>
          if max_direction > min_direction { min_direction + trip_key * (max_direction - min_direction) }
          else { min_direction + trip_key * (max_direction + 360 - min_direction) },
        Explode => trip_key * 360.0,
      };
      let ux = sin(degrees * 0.017453292519943295);
      let uy = cos(degrees * 0.017453292519943295);
      let offset = (rand(trip_key + 0.3) - 0.5) * (abs(uy) * w + abs(ux) * h);
      let cx = (if explode { w / 2.0 + ux * along } else { w / 2.0 + ux * (along - span / 2.0) + uy * offset });
      let cy = (if explode { h / 2.0 + uy * along } else { h / 2.0 + uy * (along - span / 2.0) - ux * offset });
      guard cy >= ground && abs(x - cx) <= reach + 0.5 && abs(y - cy) <= reach + 0.5 && flake_point(kind, x - cx, y - cy);
      (slot * 8.0 + trip % 8.0) * 2.0 + (if abs(x - cx) <= 0.5 && abs(y - cy) <= 0.5 { 1.0 } else { 0.0 })
    } else { -1.0 };
    guard code >= 0.0 else if y < ground { outer_colors[0][progress] * level } else { rgb(0.0, 0.0, 0.0) };
    let flake = floor(code / 2.0);
    let center = code - flake * 2.0 == 1.0;
    let flake_key = rand(base + flake);
    let brightness = if random_brightness { rand(flake_key + 0.4) * 0.8 + 0.2 } else { 1.0 };
    let outer = outer_colors[int(rand(flake_key + 0.5) * len(outer_colors))][progress];
    let inner = inner_colors[int(rand(flake_key + 0.6) * len(inner_colors))][progress];
    let c = if center { inner } else { outer };
    if color_type == Rainbow && !center { hsv(rand(flake_key + 0.7), 1.0, brightness * level) }
    else if color_type == Range {
      let other = if center { inner_colors[int(rand(flake_key + 0.8) * len(inner_colors))][progress] } else { outer_colors[int(rand(flake_key + 0.8) * len(outer_colors))][progress] };
      hsv(mix(hue(c), hue(other), rand(flake_key + 0.9)), saturation(c), brightness * level)
    }
    else { c * (brightness * level) }
  }
}

effect Gradient {
  param gradient: gradient;
  param angle: float in 0.0..360.0 = 0.0;

  sample {
    let radians = angle * 0.017453292519943295;
    let dx = cos(radians);
    let dy = sin(radians);
    let projection = pixel.x * dx + pixel.y * dy;
    let projection_min = min(target.min_x * dx, target.max_x * dx) + min(target.min_y * dy, target.max_y * dy);
    let span = (target.max_x - target.min_x) * abs(dx) + (target.max_y - target.min_y) * abs(dy);
    gradient[clamp((projection - projection_min) / span, 0.0, 1.0)]
  }
}

-- Where character `k` of `message` starts, in the font's pixels: the first of
-- 256 pixel columns that `char_index` puts at or past it, found in eight
-- halving steps so it can fill a table.
fn char_start(font: font, message: text, k: int) -> float {
  let s = if char_index(font, message, 127.5) < k { 128.0 } else { 0.0 };
  let s = if char_index(font, message, s + 63.5) < k { s + 64.0 } else { s };
  let s = if char_index(font, message, s + 31.5) < k { s + 32.0 } else { s };
  let s = if char_index(font, message, s + 15.5) < k { s + 16.0 } else { s };
  let s = if char_index(font, message, s + 7.5) < k { s + 8.0 } else { s };
  let s = if char_index(font, message, s + 3.5) < k { s + 4.0 } else { s };
  let s = if char_index(font, message, s + 1.5) < k { s + 2.0 } else { s };
  if char_index(font, message, s + 0.5) < k { s + 1.0 } else { s }
}

-- PIXEL: Text, one line in a font, still or moving Left, Right, Up or Down
-- across the target `speed` times over the clip, entering at one side and
-- leaving by the other, or stopping at the center with center_stop; Bounce
-- slides it from side to side `speed` times. Rotated mode stacks the characters
-- one above another, each centered, like Vixen's Rotated text. `size` is the
-- line height as a share of the target's height and `stretch` widens the
-- glyphs; the offsets move still text by shares of the target's width and
-- height. A wave bobs the letters by `wave` line heights along a wave
-- `wave_length` line heights long that travels a wave length a second.
-- An animation brings the letters in one after another over the first
-- `animation_share` of the clip, `stagger` spreading their starts, and with
-- animate_out takes them out the same way over the last share: flying from the
-- right or left, dropping from above, rising from below, typed, or fading.
-- Text is crisp unless `crisp` is off: each pixel fully lit or dark.
effect Text {
  param message: text = "Merry Christmas";
  param font: font;
  param gradient: gradient;
  param text_mode: enum { Normal, Rotated } = Normal;
  param movement: enum { None, Left, Right, Up, Down, Bounce } = None;
  param speed: float in 0.0..100.0 = 1.0;
  param center_stop: bool = false;
  param size: float in 0.01..10.0 = 0.5;
  param x_offset: float in -1.0..1.0 = 0.0;
  param y_offset: float in -1.0..1.0 = 0.0;
  param intensity: float in 0.0..1.0 = 1.0;
  param stretch: float in 0.1..10.0 = 1.0;
  -- Where the gradient runs: across the target, through the clip, across the
  -- text, one point per character in order or at random; Rainbow gives each
  -- character its own hue, turning once every two seconds.
  param color_mode: enum { AcrossTarget, ThroughEffect, AcrossText, PerCharacter, Random, Rainbow } = AcrossTarget;
  param wave: float in 0.0..2.0 = 0.0;
  param wave_length: float in 0.5..50.0 = 4.0;
  param animation: enum { None, FlyLeft, FlyRight, Drop, Rise, Typewriter, Fade } = None;
  param animate_out: bool = false;
  param animation_share: float in 0.01..1.0 = 0.3;
  param stagger: float in 0.0..0.9 = 0.6;
  param random_seed: float in 0.0..1000000.0 = 0.0;
  -- Crisp text lights a pixel fully or not at all, by whether the glyph
  -- covers at least half of it; otherwise edges shade by coverage.
  param crisp: bool = true;

  sample {
    let line = font_height(font);
    let scale = line / (size * (target.max_y - target.min_y));
    let w = (target.max_x - target.min_x) * scale / stretch;
    let h = line / size;
    let rotated = text_mode == Rotated;
    let count = text_length(message);
    -- Characters' starts and widths; in Rotated mode the widest sets the block's width.
    let starts = table for k in 0..65 { char_start(font, message, k) };
    let widths = table for k in 0..64 { if k + 1 < count { starts[k + 1] - starts[k] } else { text_width(font, message) - starts[k] } };
    let block_w = if rotated { max for k in 0..min(count, 64) { widths[k] } } else { text_width(font, message) };
    let block_h = if rotated { line * count } else { line };
    let pass = (progress * speed) % 1.0;
    let center_x = (w - block_w) / 2.0;
    let center_y = (h - block_h) / 2.0;
    let room = w - block_w;
    let left =
      if movement == Left { let at = w - pass * (block_w + w); if center_stop { max(at, center_x) } else { at } }
      else if movement == Right { let at = pass * (block_w + w) - block_w; if center_stop { min(at, center_x) } else { at } }
      else if movement == Bounce { min(room, 0.0) + ping_pong(progress * speed * 2.0 * abs(room), abs(room)) }
      else { center_x + x_offset * w };
    let x = (pixel.x - target.min_x) * scale / stretch - left;
    let bob = wave * line * sin(TAU * (x / (wave_length * line) - time));
    let bottom =
      if movement == Up { let at = pass * (block_h + h) - block_h; if center_stop { min(at, center_y) } else { at } }
      else if movement == Down { let at = h - pass * (block_h + h); if center_stop { max(at, center_y) } else { at } }
      else { center_y + y_offset * h };
    let y = (pixel.y - target.min_y) * scale - bottom - bob;
    -- Each character's way in and out this frame, 0 before it starts and 1
    -- once it has finished, eased; then how far it sits from its place and how
    -- much of it shows.
    let arrived = table for k in 0..64 {
      let t = clamp((progress / animation_share - stagger * k / count) / (1.0 - stagger), 0.0, 1.0);
      1.0 - (1.0 - t) * (1.0 - t) * (1.0 - t)
    };
    let left_by = table for k in 0..64 {
      let t = if animate_out { clamp(((progress - 1.0 + animation_share) / animation_share - stagger * k / count) / (1.0 - stagger), 0.0, 1.0) } else { 0.0 };
      t * t * t
    };
    let dx = table for k in 0..64 {
      if animation == FlyLeft { (1.0 - arrived[k]) * w - left_by[k] * w }
      else if animation == FlyRight { left_by[k] * w - (1.0 - arrived[k]) * w }
      else { 0.0 }
    };
    let dy = table for k in 0..64 {
      if animation == Drop { (1.0 - arrived[k]) * h - left_by[k] * h }
      else if animation == Rise { left_by[k] * h - (1.0 - arrived[k]) * h }
      else { 0.0 }
    };
    let shown = table for k in 0..64 {
      if animation == Typewriter { if arrived[k] > 0.0 && left_by[k] < 1.0 { 1.0 } else { 0.0 } }
      else if animation == Fade { arrived[k] * (1.0 - left_by[k]) }
      else { 1.0 }
    };
    -- The character the pixel is in, and its ink, as k * 2 + ink.
    let code =
      if animation == None {
        let row = count - 1 - int(floor(y / line));
        let k = if rotated { row } else { char_index(font, message, x) };
        let ink =
          if rotated {
            -- Character k is line k from the top.
            guard k >= 0 && k < count else 0.0;
            let gx = starts[k] + x - (block_w - widths[k]) / 2.0;
            guard char_index(font, message, gx) == k else 0.0;
            glyph_coverage(font, message, gx, y - (count - 1 - k) * line)
          } else { glyph_coverage(font, message, x, y) };
        k * 2.0 + (if crisp { if ink >= 0.5 { 1.0 } else { 0.0 } } else { ink })
      } else {
        max(0.0, max for k in 0..min(count, 64) {
          let gx = (if rotated { starts[k] + x - (block_w - widths[k]) / 2.0 } else { x }) - dx[k];
          let gy = y - dy[k] - (if rotated { (count - 1 - k) * line } else { 0.0 });
          guard shown[k] > 0.0 && char_index(font, message, gx) == k;
          let coverage = glyph_coverage(font, message, gx, gy);
          let ink = (if crisp { if coverage >= 0.5 { 1.0 } else { 0.0 } } else { coverage }) * shown[k];
          guard ink > 0.0;
          k * 2.0 + ink
        })
      };
    let k = floor(code / 2.0);
    let level = (code - k * 2.0) * intensity;
    match color_mode {
      AcrossTarget => gradient[(pixel.x - target.min_x) / (target.max_x - target.min_x)] * level,
      ThroughEffect => gradient[progress] * level,
      AcrossText => gradient[if rotated { 1.0 - y / block_h } else { x / block_w }] * level,
      PerCharacter => gradient[(k + 0.5) / count] * level,
      Random => gradient[rand(random_seed * 31.0 + k)] * level,
      Rainbow => hsv((k + 0.5) / count + time * 0.5, 1.0, level),
    }
  }
}

-- PIXEL: Balls bouncing off the frame's edges or wrapping around them, each
-- from a random place at a random velocity; ball_count (a curve) sets how many
-- are out, and a ball that joins mid-clip appears where its path has taken it.
-- Speeds keep Vixen's 0..100 sliders: a speed of 50 crosses the frame's larger
-- side once a second, and each ball's speed varies by up to half of
-- speed_variation. `size` is the radius in hundredths of half the frame's
-- smaller side. Solid balls are filled, Empty ones are rings edge_width frame
-- units thick, Fade ones dim from the center out and Gradient ones run their
-- gradient from the center out. Where balls overlap, the first one wins.
effect Ball {
  param colors: array<gradient>;
  param ball_count: curve in 1.0..100.0;
  param ball_type: enum { Bounce, Wrap } = Bounce;
  param ball_fill: enum { Solid, Empty, Fade, Gradient } = Solid;
  param size: float in 0.0..100.0 = 10.0;
  param center_speed: float in 0.0..100.0 = 20.0;
  param speed_variation: float in 0.0..100.0 = 5.0;
  param edge_width: float in 1.0..40.0 = 1.0;
  param intensity: float in 0.0..1.0 = 1.0;
  param random_seed: float in 0.0..1000000.0 = 0.0;
  param scale_x: float in 0.01..100.0 = 1.0;
  param scale_y: float in 0.01..100.0 = 1.0;

  sample {
    let w = frame_w();
    let h = frame_h();
    let radius = min(w, h) * size / 200.0;
    let per_second = max(w, h) / 50.0;
    -- Each ball's place: where its start and velocity have taken it, bounced
    -- or wrapped at the edges.
    let ball_x = table for i in 0..100 {
      let key = rand(random_seed * 31.0 + i);
      let speed = (center_speed + (rand(key + 0.1) - 0.5) * speed_variation) * per_second;
      let travel = rand(key + 0.2) * w + (rand(key + 0.3) - 0.5) * 2.0 * rand(key + 0.4) * speed * time;
      if ball_type == Wrap { (travel + radius) % (w + 2.0 * radius) - radius }
      else { radius + ping_pong(travel - radius, w - 2.0 * radius) }
    };
    let ball_y = table for i in 0..100 {
      let key = rand(random_seed * 31.0 + i);
      let speed = (center_speed + (rand(key + 0.1) - 0.5) * speed_variation) * per_second;
      let travel = rand(key + 0.5) * h + (rand(key + 0.6) - 0.5) * 2.0 * rand(key + 0.7) * speed * time;
      if ball_type == Wrap { (travel + radius) % (h + 2.0 * radius) - radius }
      else { radius + ping_pong(travel - radius, h - 2.0 * radius) }
    };
    let x = frame_x(scale_x);
    let y = frame_y(scale_y);
    first for i in 0..min(int(ball_count[progress]), 100) {
      let dx = x - ball_x[i];
      let dy = y - ball_y[i];
      let d = sqrt(dx * dx + dy * dy);
      guard
        if ball_fill == Empty { d >= radius - edge_width && d < radius }
        else if ball_fill == Fade { d <= radius * 0.9 }
        else { d <= radius };
      let c = colors[int(rand(random_seed * 31.0 + i + 0.8) * len(colors))];
      if ball_fill == Gradient { c[d / radius] * intensity }
      else if ball_fill == Fade { c[progress] * ((1.0 - d / radius) * intensity) }
      else { c[progress] * intensity }
    }
  }
}

-- Whether the point (u, v) lies in a shape spanning -1..1.
fn in_shape(shape: int, u: float, v: float) -> bool {
  let hx = u * 1.15;
  let hy = v * 1.15 + 0.1;
  let a = hx * hx + hy * hy - 1.0;
  if shape == 0 { u * u + v * v <= 1.0 }
  else if shape == 1 { max(abs(u), abs(v)) <= 1.0 }
  else if shape == 2 { abs(u) + abs(v) <= 1.0 }
  else if shape == 3 { max(abs(u) * 1.7320508 + v, -v * 2.0) <= 1.0 }
  -- The heart curve (x² + y² - 1)³ = x² y³, fitted to -1..1.
  else { a * a * a <= hx * hx * hy * hy * hy }
}

-- PIXEL: Shapes, one geometric shape (Vixen's single still shape) at the
-- frame's center moved by x_offset and y_offset (shares of the frame's width
-- and height), as wide as `size` times the frame's smaller side and turned
-- clockwise by `angle` degrees. The fill and outline colors run over the clip;
-- the outline is outline_width frame units thick inside the shape's edge.
effect Shapes {
  param shape: enum { Circle, Square, Diamond, Triangle, Heart } = Circle;
  param fill_colors: gradient;
  param outline_colors: gradient;
  param fill: bool = true;
  param outline_width: float in 0.0..100.0 = 0.0;
  param size: curve in 0.0..2.0;
  param angle: curve in 0.0..360.0;
  param x_offset: curve in -1.0..1.0;
  param y_offset: curve in -1.0..1.0;
  param intensity: float in 0.0..1.0 = 1.0;
  param scale_x: float in 0.01..100.0 = 1.0;
  param scale_y: float in 0.01..100.0 = 1.0;

  sample {
    let w = frame_w();
    let h = frame_h();
    let half = min(w, h) * size[progress] / 2.0;
    let turn = angle[progress] * 0.017453292519943295;
    let dx = frame_x(scale_x) - (w - 1.0) / 2.0 - x_offset[progress] * w;
    let dy = frame_y(scale_y) - (h - 1.0) / 2.0 - y_offset[progress] * h;
    -- The point in the shape's own turned frame, -1..1 across it.
    let u = (dx * cos(turn) - dy * sin(turn)) / half;
    let v = (dx * sin(turn) + dy * cos(turn)) / half;
    let kind: int = if shape == Circle { 0 } else if shape == Square { 1 } else if shape == Diamond { 2 } else if shape == Triangle { 3 } else { 4 };
    guard in_shape(kind, u, v);
    -- On the outline when the shape shrunk by its width leaves the point out.
    let inner = half / (half - outline_width);
    let edge = !in_shape(kind, u * inner, v * inner);
    guard edge || fill;
    (if edge { outline_colors[progress] } else { fill_colors[progress] }) * intensity
  }
}
