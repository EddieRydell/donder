import layouts from <layouts/main.data.donder>;
import patches from <patches/main.data.donder>;

Setup main {
  description: none,
  layout: layouts.main,
  patch: patches.main,
  controllers: [
    nativity,
    pauls_balls,
    tiny_tree_loft,
    front_door_1,
    neighbor_trees,
    fran_roof_roofs,
    fran_roof_windows,
    megatree,
    peacock,
    arch_tunnel,
    right_pilaster_stairs,
    garage,
    left_meteors,
    right_meteors,
    right_pilaster_bush_arch,
    right_magnolia,
    front_door_2,
    left_wall,
    left_pilaster,
    garage_door_matrix,
    left_magnolia,
  ],
}

Controller nativity {
  description: "Vixen controller: Nativity",
  protocol: E131 {
    source_name: "Donder",
    bind_address: "0.0.0.0",
    priority: 100,
    mode: Unicast { destination: "192.168.168.37" },
  },
  ports: [
    Port { name: universe_64, address: Universe { universe: 64 }, slots: 510 },
    Port { name: universe_65, address: Universe { universe: 65 }, slots: 510 },
    Port { name: universe_66, address: Universe { universe: 66 }, slots: 510 },
