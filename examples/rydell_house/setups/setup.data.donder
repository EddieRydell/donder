import layouts from <layouts/layout.data.donder>;
import patches from <patches/patch.data.donder>;
import devices from <input_devices/mpk_mini.data.donder>;

Setup setup {
  description: none,
  layout: layouts.layout,
  patch: patches.patch,
  controllers: [
    nativity,
    pauls_balls,
    tiny_tree_loft,
    front_door_1,
    neighbor_trees,
    neighbor_trees_2,
    fran_roof_roofs,
    fran_roof_windows,
    megatree,
    megatree_2,
    peacock,
    peacock_2,
    arch_tunnel,
    right_pilaster_stairs,
    garage,
    left_meteors,
    left_meteors_2,
    right_meteors,
    right_pilaster_bush_arch,
    right_magnolia,
    front_door_2,
    front_door_2_2,
    left_wall,
    left_pilaster,
    garage_door_matrix,
    left_magnolia,
    left_magnolia_2,
  ],
  input_devices: [
    devices.mpk_mini,
    InputDevice input_device_2 {
      description: none,
      driver: Keyboard,
      controls: [
        Button { name: control_1, description: none, input: Key { code: KeyA } },
        Button { name: control_2, description: none, input: Key { code: KeyS } },
        Button { name: control_3, description: none, input: Key { code: KeyD } },
        Button { name: control_4, description: none, input: Key { code: KeyF } },
        Button { name: control_5, description: none, input: Key { code: KeyG } },
        Button { name: control_6, description: none, input: Key { code: KeyH } },
        Button { name: control_7, description: none, input: Key { code: KeyJ } },
        Button { name: control_8, description: none, input: Key { code: KeyK } },
        Button { name: control_9, description: none, input: Key { code: KeyL } },
      ],
    },
  ],
}

Controller nativity {
  description: "Vixen controller: Nativity",
  protocol: E131 {
    sender_name: "Donder",
    bind_address: "0.0.0.0",
    priority: 100,
    mode: Unicast { destination: "192.168.168.37" },
    start_universe: 64,
    universes: 8,
    channels: 510,
    ports: [Port { name: "1", description: none }],
  },
}

